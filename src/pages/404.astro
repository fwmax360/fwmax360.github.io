---
import Base from '../layouts/Base.astro'
import '../styles/utility-open.css'
---
<Base title="404" description="页面不存在，返回文章索引或搜索内容。" width="content" bodyClass="atlas-mode utility-open" noindex>
  <section class="missing-page" aria-labelledby="missing-title">
    <p class="missing-code" aria-hidden="true">404</p>
    <h1 id="missing-title">这个页面不在这里。</h1>
    <p class="utility-intro">链接可能已过期，或者文章换了地址。<br />从文章索引继续找找。</p>
    <nav class="utility-actions" aria-label="继续浏览">
      <a href="/archive/">浏览文章 <span aria-hidden="true">↗</span></a>
      <a href="/">回到首页 <span aria-hidden="true">↗</span></a>
      <button type="button" data-search-open hidden>搜索文章 <span aria-hidden="true">↗</span></button>
    </nav>
  </section>
</Base>
