---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Toc from '../../components/Toc.astro'
import CodeActions from '../../components/CodeActions.astro'
import Comments from '../../components/Comments.astro'
import CopyLink from '../../components/CopyLink.astro'
import FieldBrief from '../../components/FieldBrief.astro'
import MissionDebrief from '../../components/MissionDebrief.astro'
import '../../styles/editorial-font.css'
import ReadingProgress from '../../components/ReadingProgress.astro'
import { coverPngUrl, coverSvgUrl } from '../../lib/covers'
import { seriesUrl } from '../../lib/series'
import { getSeriesVisual } from '../../lib/seriesVisual'
import '../../styles/figures.css'
import '../../styles/editorial.css'
import {
  getPosts,
  getPostsByDate,
  getRelated,
  getSeries,
  formatDate,
  readingStats,
  postUrl,
  categoryUrl,
  type Post,
} from '../../lib/posts'

interface ExternalSource {
  href: string
  label: string
  host: string
}

/** 从正文中已经存在的显式链接生成来源索引；代码示例和本站绝对链接不计入。 */
const extractExternalSources = (markdown: string, siteHost?: string): ExternalSource[] => {
  const source = markdown
    .replace(/```[\s\S]*?```/g, '')
    .replace(/~~~[\s\S]*?~~~/g, '')
  const found = new Map<string, ExternalSource>()

  const add = (rawLabel: string, rawHref: string) => {
    const href = rawHref.trim().replace(/[.,;:!?，。；！？]+$/u, '')
    try {
      const url = new URL(href)
      if (!['http:', 'https:'].includes(url.protocol) || url.host === siteHost || found.has(url.href)) return
      const label = rawLabel
        .replace(/<[^>]+>/g, '')
        .replace(/[\*_`]/g, '')
        .replace(/\s+/g, ' ')
        .trim()
      found.set(url.href, {
        href: url.href,
        label: label || url.hostname,
        host: url.hostname.replace(/^www\./, ''),
      })
    } catch {
      // 非 URL 候选不进入来源列表。
    }
  }

  for (const match of source.matchAll(/(?<!!)\[([^\]]+)\]\(\s*(https?:\/\/[^\s)]+)(?:\s+["'][^"']*["'])?\s*\)/gi)) {
    add(match[1], match[2])
  }
  for (const match of source.matchAll(/^\s*\[([^\]]+)\]:\s*(https?:\/\/\S+)/gim)) {
    add(match[1], match[2])
  }
  for (const match of source.matchAll(/<\s*(https?:\/\/[^>\s]+)\s*>/gi)) {
    add(match[1], match[1])
  }
  for (const match of source.matchAll(/<a\b[^>]*\bhref=["'](https?:\/\/[^"']+)["'][^>]*>([\s\S]*?)<\/a>/gi)) {
    add(match[2], match[1])
  }

  return [...found.values()]
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content, headings } = await render(post)

const { title, description, pubDate, updatedDate, tags, category, series, order } = post.data
const body = post.body ?? ''
const stats = readingStats(body)
// 行内 $...$、块级 $$...$$，或 latex 环境。先剥掉代码块，避免 shell 里的 $ 误判
const proseOnly = body.replace(/```[\s\S]*?```/g, '').replace(/`[^`\n]*`/g, '')
const hasMath = /\$\$[\s\S]+?\$\$|\$[^$\n]+\$|\\begin\{/.test(proseOnly)

const chronological = await getPostsByDate() // 升序：越早越靠前
const idx = chronological.findIndex((p) => p.id === post.id)
const older = idx > 0 ? chronological[idx - 1] : null
const newer = idx >= 0 && idx < chronological.length - 1 ? chronological[idx + 1] : null

const related = await getRelated(post)
const seriesPosts = series ? await getSeries(series) : []
const seriesIndex = seriesPosts.findIndex((p) => p.id === post.id)
const seriesPosition = seriesIndex >= 0 ? seriesIndex + 1 : 1
const seriesProgress = seriesPosts.length ? (seriesPosition / seriesPosts.length) * 100 : 0
const chapterNumber = order ?? seriesPosition
const seriesVisual = series ? getSeriesVisual(series) : null
const seriesPrevious = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : null
const seriesNext = seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : null
const previousPost = series ? seriesPrevious : older
const previousTarget = previousPost
  ? {
      href: postUrl(previousPost),
      label: series ? 'previous chapter' : 'older in timeline',
      title: previousPost.data.title,
      meta: series
        ? `CH ${String(previousPost.data.order ?? seriesIndex).padStart(2, '0')}`
        : formatDate(previousPost.data.pubDate),
      cover: coverSvgUrl(previousPost),
    }
  : null
const nextTarget = series
  ? seriesNext
    ? {
        href: postUrl(seriesNext),
        label: 'next chapter',
        title: seriesNext.data.title,
        meta: `CH ${String(seriesNext.data.order ?? seriesIndex + 2).padStart(2, '0')}`,
        cover: coverSvgUrl(seriesNext),
      }
    : {
        href: seriesUrl(series),
        label: 'series overview',
        title: `查看「${series}」全部章节`,
        meta: `${seriesPosts.length} chapters`,
      }
  : newer
    ? {
        href: postUrl(newer),
        label: 'newer in timeline',
        title: newer.data.title,
        meta: formatDate(newer.data.pubDate),
        cover: coverSvgUrl(newer),
      }
    : null
const externalSources = extractExternalSources(body, Astro.site?.host)
const headStyle = seriesVisual
  ? `--head-accent:${seriesVisual.palette.accent};--head-glow:${seriesVisual.palette.glow}`
  : undefined
const coverAlt = series
  ? `《${title}》文章封面，${category} 分类，${series}第 ${chapterNumber} 章`
  : `《${title}》文章封面，${category} 分类`
---

<Base
  title={title}
  description={description}
  type="article"
  publishedAt={pubDate}
  updatedAt={updatedDate}
  hasMath={hasMath}
  image={coverPngUrl(post)}
  imageAlt={coverAlt}
>
  <ReadingProgress />
  <div class="layout">
    <article class="article" data-article data-pagefind-body>
      <header class="head" style={headStyle} data-reveal data-tilt="1.25">
        <div
          class="head-cover"
          aria-hidden="true"
          data-pagefind-ignore
          data-no-viewer
          data-parallax="0.045"
          transition:name={`post-cover-${post.id}`}
        >
          <img
            src={coverSvgUrl(post)}
            width="1200"
            height="630"
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="low"
            data-no-viewer
          />
        </div>

        <div class="head-top" data-pagefind-ignore>
          <nav class="crumbs mono" aria-label="面包屑">
            <ol>
              <li><a href="/archive">posts</a></li>
              <li><a href={categoryUrl(category)} aria-current="location">{category}</a></li>
            </ol>
          </nav>

          <span class="article-state mono">
            <span class="state-dot" aria-hidden="true"></span>
            {updatedDate ? 'maintained' : 'published'}
          </span>
        </div>

        <div class="head-copy">
          <p class="eyebrow mono" aria-hidden="true">technical note / {category}</p>
          <h1 class="title font-display" data-pagefind-meta="title">{title}</h1>
          <p class="lede">{description}</p>
        </div>

        <div class="status-bar" data-pagefind-ignore>
          <dl class="meta mono" aria-label="文章信息">
            <div class="meta-item">
              <dt>published</dt>
              <dd><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></dd>
            </div>
            {
              updatedDate && (
                <div class="meta-item meta-revision">
                  <dt>revision</dt>
                  <dd><time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></dd>
                </div>
              )
            }
            <div class="meta-item">
              <dt>length</dt>
              <dd>{stats.words} 字</dd>
            </div>
            <div class="meta-item">
              <dt>read</dt>
              <dd>约 {stats.minutes} 分钟</dd>
            </div>
          </dl>
          <div class="meta-action">
            <CopyLink />
          </div>
        </div>
      </header>

      <Toc headings={headings} variant="mobile" />

      {
        seriesPosts.length > 1 && (
          <nav
            class="series"
            aria-label={`系列文章：${series}`}
            data-pagefind-ignore
            data-reveal
            data-spotlight
            data-tilt="1.5"
            style={`--series-progress:${seriesProgress}%`}
          >
            <div class="series-head">
              <div class="series-identity">
                <span class="series-label mono">series</span>
                <p class="series-name">{series}</p>
              </div>
              <span
                class="series-position mono"
                aria-label={`章节 ${chapterNumber}，阅读路径第 ${seriesPosition} 篇，共 ${seriesPosts.length} 篇`}
              >
                CH {String(chapterNumber).padStart(2, '0')} · {String(seriesPosition).padStart(2, '0')}/{String(seriesPosts.length).padStart(2, '0')}
              </span>
            </div>
            <div
              class="series-track"
              role="progressbar"
              aria-label="系列阅读进度"
              aria-valuemin="1"
              aria-valuemax={seriesPosts.length}
              aria-valuenow={seriesPosition}
            >
              <span aria-hidden="true"></span>
            </div>
            <ol class="series-list">
              {seriesPosts.map((p, i) => (
                <li class:list={['series-item', { current: p.id === post.id }]}>
                  <span class="mono series-n">{String(p.data.order ?? i + 1).padStart(2, '0')}</span>
                  {p.id === post.id ? (
                    <span class="series-current" aria-current="page">{p.data.title}</span>
                  ) : (
                    <a
                      href={postUrl(p)}
                      data-jmp
                      data-jmp-source="series / chapter path"
                      data-jmp-title={p.data.title}
                    >{p.data.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <FieldBrief
        description={description}
        category={category}
        tags={tags}
        publishedAt={pubDate}
        updatedAt={updatedDate}
        series={series}
        order={series ? chapterNumber : undefined}
        words={stats.words}
        minutes={stats.minutes}
        headings={headings}
        accent={seriesVisual?.palette.accent}
      />

      <div class="prose">
        <Content />
      </div>

      <footer class="foot" data-pagefind-ignore>
        <MissionDebrief
          mode={series ? 'series' : 'timeline'}
          previous={previousTarget}
          next={nextTarget}
          related={related}
          sources={externalSources}
          tags={tags}
          category={category}
          words={stats.words}
          minutes={stats.minutes}
          headingsCount={headings.length}
          publishedAt={pubDate}
          updatedAt={updatedDate}
          series={series}
          chapter={series ? chapterNumber : undefined}
          seriesPosition={series ? seriesPosition : undefined}
          seriesTotal={series ? seriesPosts.length : undefined}
          accent={seriesVisual?.palette.accent}
        />

        <Comments />
      </footer>
    </article>

    <aside class="rail">
      <Toc headings={headings} variant="rail" />
      <a href="#main" class="to-top mono">↑ back to top</a>
    </aside>
  </div>

  <CodeActions />
</Base>

<script>
  const calloutLabels = {
    NOTE: 'NOTE',
    TIP: 'TIP',
    WARNING: 'WARNING',
    EVIDENCE: 'EVIDENCE',
  } as const

  let calloutObserver: IntersectionObserver | null = null

  const enhanceEditorialCallouts = () => {
    calloutObserver?.disconnect()
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const motionOff = document.documentElement.dataset.motion === 'off'
    const animatedQuotes: HTMLQuoteElement[] = []

    document.querySelectorAll<HTMLQuoteElement>('.prose blockquote:not([data-callout-ready])').forEach((quote) => {
      quote.dataset.calloutReady = 'true'
      const firstParagraph = quote.querySelector<HTMLElement>(':scope > p:first-child')
      if (!firstParagraph) return

      const walker = document.createTreeWalker(firstParagraph, NodeFilter.SHOW_TEXT)
      let textNode = walker.nextNode()
      while (textNode) {
        if (textNode instanceof Text) {
          const marker = textNode.data.match(/^\s*\[!(NOTE|TIP|WARNING|EVIDENCE)\]\s*/i)
          if (marker) {
            const kind = marker[1].toUpperCase() as keyof typeof calloutLabels
            textNode.data = textNode.data.slice(marker[0].length)
            if (!firstParagraph.textContent?.trim()) firstParagraph.remove()

            quote.dataset.callout = kind.toLowerCase()
            quote.setAttribute('role', 'note')
            quote.setAttribute('aria-label', `${calloutLabels[kind]} callout`)

            const label = document.createElement('div')
            label.className = 'callout-label mono'
            label.setAttribute('aria-hidden', 'true')
            label.textContent = calloutLabels[kind]
            quote.prepend(label)
            return
          }
        }
        textNode = walker.nextNode()
      }
    })

    document.querySelectorAll<HTMLQuoteElement>('.prose blockquote').forEach((quote) => {
      if (reduceMotion || motionOff) {
        quote.dataset.calloutMotion = 'visible'
        return
      }
      quote.dataset.calloutMotion = 'prepared'
      animatedQuotes.push(quote)
    })

    if (!animatedQuotes.length || reduceMotion || motionOff) return
    calloutObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const quote = entry.target as HTMLQuoteElement
          quote.dataset.calloutMotion = 'visible'
          observer.unobserve(quote)
        })
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
    )
    animatedQuotes.forEach((quote) => calloutObserver!.observe(quote))
  }

  enhanceEditorialCallouts()
  document.addEventListener('astro:page-load', enhanceEditorialCallouts)
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--container-content)) 15.5rem;
    gap: clamp(3rem, 5vw, 4.5rem);
    justify-content: center;
  }

  .head {
    --head-accent: var(--color-accent);
    --head-glow: color-mix(in srgb, var(--head-accent) 14%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: 2.75rem;
    padding: 1.15rem 1.35rem 0;
    border: 1px solid var(--color-line);
    border-top-color: var(--color-line-bright);
    background:
      linear-gradient(110deg, color-mix(in srgb, var(--head-accent) 5%, transparent), transparent 45%),
      var(--color-bg-soft);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 2px 0 0 color-mix(in srgb, var(--head-accent) 58%, transparent),
      0 20px 50px -42px rgb(0 0 0 / 0.9);
  }

  .head > :not(.head-cover) {
    position: relative;
    z-index: 2;
  }

  .head-cover {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    bottom: 3.3rem;
    width: min(66%, 35rem);
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.18) 27%, #000 70%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.18) 27%, #000 70%);
  }

  .head-cover::before,
  .head-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .head-cover::before {
    background: radial-gradient(circle at 78% 42%, var(--head-glow), transparent 58%);
  }

  .head-cover::after {
    background:
      linear-gradient(90deg, var(--color-bg-soft), transparent 62%),
      linear-gradient(0deg, var(--color-bg-soft), transparent 28%);
    opacity: 0.58;
  }

  .head-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    opacity: 0.24;
    filter: saturate(0.82) contrast(1.05) brightness(0.88);
  }

  .head::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.35rem;
    width: 5.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--head-accent), transparent);
  }

  .head-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .crumbs {
    font-size: 0.75rem;
    color: var(--color-faint);
  }

  .crumbs ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .crumbs li + li::before {
    content: '/';
    color: var(--color-line-bright);
  }

  .crumbs a {
    color: var(--color-faint);
    text-decoration: none;
    transition: color 0.16s;
  }

  .crumbs a:hover {
    color: var(--color-accent);
  }

  .article-state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    color: var(--color-faint);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .state-dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--head-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--head-accent) 12%, transparent);
  }

  .head-copy {
    padding: clamp(1.7rem, 4vw, 2.5rem) 0 clamp(1.5rem, 3vw, 2rem);
  }

  .eyebrow {
    margin-bottom: 0.7rem;
    color: color-mix(in srgb, var(--head-accent) 72%, var(--color-dim));
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    max-width: 42rem;
    font-size: clamp(1.9rem, 4vw, 2.65rem);
    line-height: 1.18;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--color-text-strong);
    text-wrap: balance;
  }

  .lede {
    max-width: 39rem;
    margin-top: 1rem;
    font-size: 0.98rem;
    line-height: 1.78;
    color: var(--color-dim);
    text-wrap: pretty;
  }

  .status-bar {
    min-height: 3.25rem;
    margin-inline: -1.35rem;
    padding: 0.65rem 1.35rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  .meta {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
  }

  .meta-item {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
    padding-right: 0.8rem;
    font-size: 0.69rem;
    white-space: nowrap;
  }

  .meta-item + .meta-item {
    padding-left: 0.8rem;
    border-left: 1px solid var(--color-line);
  }

  .meta dt {
    color: var(--color-faint);
    font-size: 0.59rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .meta dd {
    margin: 0;
    color: var(--color-dim);
  }

  .meta-revision dd {
    color: color-mix(in srgb, var(--color-warn) 75%, var(--color-text));
  }

  .meta-action {
    margin-left: auto;
  }

  .series {
    position: relative;
    margin-bottom: 2.75rem;
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg-soft);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .series-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .series-identity {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .series-label {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--color-warn);
    text-transform: uppercase;
  }

  .series-name {
    overflow: hidden;
    color: var(--color-text-strong);
    font-size: 0.88rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-position {
    flex: 0 0 auto;
    color: var(--color-faint);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .series-track {
    height: 2px;
    margin: 0.85rem 0 0.75rem;
    overflow: hidden;
    background: var(--color-line);
  }

  .series-track span {
    display: block;
    width: var(--series-progress);
    height: 100%;
    background: linear-gradient(90deg, var(--color-warn), var(--color-accent));
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .series-list {
    display: grid;
    gap: 0.1rem;
  }

  .series-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.25rem 0.45rem;
    border-left: 1px solid var(--color-line);
    font-size: 0.82rem;
    color: var(--color-dim);
  }

  .series-item::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -3px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-line-bright);
    transform: translateY(-50%);
  }

  .series-n {
    flex: 0 0 auto;
    font-size: 0.72rem;
    color: var(--color-faint);
  }

  .series-item a,
  .series-current {
    min-width: 0;
    color: var(--color-dim);
    text-decoration: none;
  }

  .series-item a:hover {
    color: var(--color-accent);
  }

  .series-item.current {
    border-left-color: var(--color-accent);
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 72%);
  }

  .series-item.current::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .series-item.current .series-n,
  .series-item.current .series-current {
    color: var(--color-accent);
  }

  .foot {
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .rail {
    position: sticky;
    top: calc(var(--nav-offset, var(--nav-h)) + 2rem);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.9rem 0.9rem 0.8rem;
