---
import Base from '../../layouts/Base.astro'
import { formatDate } from '../../lib/posts'
import { getSeriesSummaries, seriesUrl } from '../../lib/series'
import { getSeriesVisual, seriesVisualStyle } from '../../lib/seriesVisual'

const series = await getSeriesSummaries()
const articleCount = series.reduce((total, item) => total + item.count, 0)
const seriesCards = series.map((item) => ({ ...item, visual: getSeriesVisual(item.name) }))

const blurb = (item: (typeof seriesCards)[number]) => {
  const first = item.posts[0]?.data.title
  const last = item.posts.at(-1)?.data.title
  if (!first) return '按顺序整理的专题文章。'
  if (first === last) return `从「${first}」开始的专题记录。`
  return `从「${first}」到「${last}」，按顺序串起完整脉络。`
}
---

<Base
  title="技术文章系列"
  description={`按学习路径浏览 ${series.length} 个技术系列，共 ${articleCount} 篇文章。`}
>
  <header class="page-head">
    <p class="eyebrow mono"><span aria-hidden="true">~/</span> knowledge paths</p>
    <div class="title-row">
      <div>
        <h1 class="page-title"><span class="prompt mono" aria-hidden="true">$</span> 技术文章系列</h1>
        <p class="page-sub">不按发布日期堆叠，而是沿着问题、原理和实战顺序阅读。</p>
      </div>
      <dl class="summary mono" aria-label="系列统计">
        <div>
          <dt>series</dt>
          <dd>{String(series.length).padStart(2, '0')}</dd>
        </div>
        <div>
          <dt>chapters</dt>
          <dd>{String(articleCount).padStart(2, '0')}</dd>
        </div>
      </dl>
    </div>
  </header>

  {
    series.length > 0 ? (
      <section aria-labelledby="series-list-title">
        <div class="section-head">
          <h2 id="series-list-title" class="kicker">// choose a path</h2>
          <span class="legend mono"><i aria-hidden="true" /> published chapter</span>
        </div>

        <div class="series-grid col-side">
          {seriesCards.map((item, index) => (
            <article
              class="series-card"
              data-tone={item.visual.tone}
              data-signature={item.visual.signature}
              style={seriesVisualStyle(item.visual)}
            >
              <a
                class="card-link"
                href={seriesUrl(item.name)}
                aria-label={`打开「${item.name}」系列`}
                data-code={item.visual.code}
              >
                <header class="card-head">
                  <div>
                    <p class="card-index mono">
                      SERIES / {String(index + 1).padStart(2, '0')}
                      <span>{item.visual.code}</span>
                    </p>
                    <h3 class="card-title">{item.name}</h3>
                  </div>
                  <div class="card-aside">
                    <span class="signature mono" aria-hidden="true">{item.visual.mark}</span>
                    <span class="card-count mono">
                      {String(item.count).padStart(2, '0')}
                      <small>篇</small>
                    </span>
                  </div>
                </header>

                <p class="card-desc">{blurb(item)}</p>

                <div class="sequence" aria-hidden="true">
                  <span class="sequence-line" />
                  {item.posts.map((post, postIndex) => (
                    <span class="sequence-step">
                      <i />
                      <b class="mono">{String(post.data.order ?? postIndex + 1).padStart(2, '0')}</b>
                    </span>
                  ))}
                </div>

                <ol class="chapter-preview">
                  {item.posts.map((post, postIndex) => (
                    <li>
                      <span class="chapter-no mono">
                        {String(post.data.order ?? postIndex + 1).padStart(2, '0')}
                      </span>
                      <span class="chapter-title">{post.data.title}</span>
                    </li>
                  ))}
                </ol>

                <footer class="card-foot">
                  <span class="card-tags mono">{item.topTags.map((tag) => `#${tag}`).join('  ')}</span>
                  <span class="card-updated mono">updated {formatDate(item.lastUpdatedAt)}</span>
                  <span class="card-open mono" aria-hidden="true">open →</span>
                </footer>
              </a>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <div class="empty">
        <p class="mono">NO_SERIES_FOUND</p>
        <span>文章加入 series 与 order 后，会在这里组成阅读路径。</span>
      </div>
    )
  }
</Base>

<style>
  .page-head {
    position: relative;
    padding: 1.5rem 0 2.5rem;
    margin-bottom: 2.75rem;
    border-bottom: 1px solid var(--color-line-bright);
  }

  .page-head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: min(11rem, 34vw);
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .eyebrow {
    margin-bottom: 0.8rem;
    color: var(--color-accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow span {
    color: var(--color-faint);
  }

  .title-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 680;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--color-text-strong);
  }

  .prompt {
    color: var(--color-accent);
    font-weight: 500;
  }

  .page-sub {
    max-width: 36rem;
    margin-top: 0.9rem;
    color: var(--color-dim);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .summary {
    display: flex;
    gap: 1.75rem;
    flex: none;
  }

  .summary div {
    display: grid;
    gap: 0.2rem;
    min-width: 4.5rem;
  }

  .summary dt {
    color: var(--color-faint);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .summary dd {
    color: var(--color-text-strong);
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-faint);
    font-size: 0.64rem;
  }

  .legend i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .series-card {
    min-width: 0;
    --series-accent: var(--color-accent);
    --series-soft: var(--color-accent-soft);
    --series-glow: rgb(61 220 132 / 0.14);
    --series-ink: var(--color-text-strong);
    --series-angle: 135deg;
  }

  .card-link {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1.4rem;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background:
      radial-gradient(circle at 92% 5%, var(--series-glow), transparent 28%),
      repeating-linear-gradient(
        var(--series-angle),
        transparent 0 18px,
        color-mix(in srgb, var(--series-accent) 3.5%, transparent) 18px 19px
      ),
      linear-gradient(145deg, color-mix(in srgb, var(--color-surface) 72%, transparent), transparent 60%),
      var(--color-bg-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      background 0.2s,
      transform 0.25s var(--ease-out-expo),
      box-shadow 0.25s;
  }

  .card-link::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: linear-gradient(180deg, var(--series-accent), transparent 72%);
    opacity: 0.55;
    transition: opacity 0.2s;
  }

  .card-link:hover,
  .card-link:focus-visible {
    border-color: color-mix(in srgb, var(--series-accent) 38%, var(--color-line-bright));
    background:
      radial-gradient(circle at 92% 5%, var(--series-glow), transparent 32%),
      repeating-linear-gradient(
        var(--series-angle),
        transparent 0 18px,
        color-mix(in srgb, var(--series-accent) 5%, transparent) 18px 19px
      ),
      linear-gradient(145deg, color-mix(in srgb, var(--color-surface-2) 80%, transparent), transparent 62%),
      var(--color-bg-soft);
    transform: translateY(-3px);
    box-shadow: 0 18px 50px -32px var(--series-glow);
    outline: none;
  }

  .card-link:hover::before,
  .card-link:focus-visible::before {
    opacity: 1;
  }

  .card-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-index {
    margin-bottom: 0.55rem;
    color: var(--color-faint);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .card-index span {
    display: inline-block;
    padding-left: 0.45rem;
    margin-left: 0.35rem;
    color: var(--series-accent);
    border-left: 1px solid var(--series-soft);
  }

  .card-title {
    color: var(--color-text-strong);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.35;
    transition: color 0.18s;
  }

  .card-link:hover .card-title,
  .card-link:focus-visible .card-title {
    color: var(--series-ink);
  }

  .card-aside {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
  }

  .signature {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--series-accent);
    font-size: 0.9rem;
    line-height: 1;
    background: var(--series-glow);
    border: 1px solid var(--series-soft);
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out-expo);
  }

  .series-card[data-signature='layers'] .signature {
    box-shadow:
      3px 3px 0 -2px var(--color-bg),
      3px 3px 0 -1px var(--series-soft);
  }

  .series-card[data-signature='signal'] .signature {
    width: 2.3rem;
    border-radius: 999px;
    font-size: 1.2rem;
  }

  .series-card[data-signature='cipher'] .signature {
    border-style: dashed;
    font-size: 1.05rem;
  }

  .series-card[data-signature='split'] .signature {
    border-radius: 50% 0 50% 0;
    font-size: 1rem;
  }

  .card-link:hover .signature,
  .card-link:focus-visible .signature {
    color: var(--series-ink);
    border-color: var(--series-accent);
    transform: translateY(-2px);
  }

  .card-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    color: var(--series-accent);
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }

  .card-count small {
    color: var(--color-faint);
    font-family: var(--font-sans);
    font-size: 0.65rem;
  }

  .card-desc {
    min-height: 3.1rem;
    margin-top: 0.75rem;
    color: var(--color-dim);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .sequence {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin: 1.3rem 0 1.1rem;
  }

  .sequence-line {
    position: absolute;
    top: 0.25rem;
    left: 0.3rem;
    right: 0.3rem;
    height: 1px;
    background: linear-gradient(90deg, var(--series-accent), var(--series-soft));
    opacity: 0.6;
  }

  .sequence-step {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .sequence-step i {
    width: 0.52rem;
    height: 0.52rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--series-accent);
    box-shadow:
      0 0 0 1px var(--series-soft),
      0 0 10px var(--series-glow);
  }

  .sequence-step b {
    color: var(--color-faint);
    font-size: 0.58rem;
    font-weight: 500;
  }

  .chapter-preview {
    flex: 1;
    border-top: 1px solid var(--color-line);
  }

  .chapter-preview li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.45rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .chapter-no {
    color: color-mix(in srgb, var(--series-accent) 48%, var(--color-faint));
    font-size: 0.65rem;
  }

  .chapter-title {
    overflow: hidden;
    color: var(--color-text);
    font-size: 0.78rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.4rem 1rem;
    margin-top: 1rem;
  }

  .card-tags {
    overflow: hidden;
    color: var(--color-faint);
    font-size: 0.62rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-updated {
    color: var(--color-faint);
    font-size: 0.6rem;
  }

  .card-open {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--series-accent);
    font-size: 0.68rem;
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 0.18s,
      translate 0.22s var(--ease-out-expo);
  }

  .card-link:hover .card-open,
  .card-link:focus-visible .card-open {
    opacity: 1;
    translate: 0 0;
  }

  .empty {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    padding: 4rem 1rem;
    color: var(--color-dim);
    text-align: center;
    border: 1px dashed var(--color-line-bright);
  }

  .empty p {
    color: var(--color-warn);
    font-size: 0.82rem;
  }

  .empty span {
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .title-row {
      align-items: start;
      flex-direction: column;
    }

    .summary {
      width: 100%;
      padding-top: 1rem;
      border-top: 1px solid var(--color-line);
    }

    .series-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .page-head {
      padding-top: 0.5rem;
    }

    .section-head {
      align-items: start;
      flex-direction: column;
    }

    .card-link {
      padding: 1.1rem;
    }

    .card-desc {
      min-height: 0;
    }

    .card-updated {
      display: none;
    }
  }
</style>
