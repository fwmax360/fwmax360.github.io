---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import { categoryUrl, formatDate, postUrl, readingStats, tagUrl } from '../../lib/posts'
import { getSeriesSummaries, type SeriesSummary } from '../../lib/series'
import '../../styles/series-open.css'
export const getStaticPaths: GetStaticPaths = async () => (await getSeriesSummaries()).map(summary => ({params:{series:summary.name},props:{summary}}))
const { summary } = Astro.props as { summary: SeriesSummary }
const description = `${summary.name}系列，共 ${summary.count} 篇，按文章顺序阅读。`
---
<Base title={`${summary.name} 系列`} description={description} bodyClass="atlas-mode series-open">
  <header class="route-intro">
    <a class="route-back" href="/series/">← 所有阅读路径</a>
    <p class="paths-caption">A THREAD TO FOLLOW</p>
    <h1>{summary.name}</h1>
    <div class="route-summary"><p>{summary.count} 篇笔记，按顺序展开。<br />从第一篇开始，或选一个感兴趣的问题。</p><p>最近更新 {formatDate(summary.lastUpdatedAt)}<span>{summary.categories.join(' / ')}</span></p></div>
  </header>
  <section class="route-reading" aria-labelledby="chapters-title">
    <div class="route-side"><h2 id="chapters-title">沿着这条线。</h2><p lang="en">One idea<br /><em>leads to another.</em></p><nav aria-label="系列主题标签">{summary.topTags.map(tag=><a href={tagUrl(tag)}>#{tag}</a>)}</nav></div>
    <ol class="route-chapters">{summary.posts.map((post,index)=><li class="route-chapter" data-series-post={post.id} data-series-order={post.data.order ?? index+1}>
      <span class="chapter-number" aria-hidden="true">{String(post.data.order ?? index+1).padStart(2,'0')}</span>
      <article data-reading-preview><p class="chapter-context"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{readingStats(post.body ?? '').minutes} 分钟阅读</span></p><h3><a href={postUrl(post)} data-jmp data-jmp-source={`series / CH ${post.data.order ?? index+1}`} data-jmp-title={post.data.title}>{post.data.title}<span aria-hidden="true">↗</span></a></h3><p class="chapter-description">{post.data.description}</p><a class="chapter-category" href={categoryUrl(post.data.category)}>{post.data.category}</a></article>
    </li>)}</ol>
  </section>
  <p class="paths-outro">这条线之外，还有更多问题。<a href="/series/">看看其他路径 <span aria-hidden="true">↗</span></a></p>
</Base>
