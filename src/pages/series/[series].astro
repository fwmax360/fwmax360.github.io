---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import { categoryUrl, formatDate, postUrl, tagUrl } from '../../lib/posts'
import { getSeriesSummaries, type SeriesSummary } from '../../lib/series'
import { getSeriesVisual, seriesVisualStyle } from '../../lib/seriesVisual'

export const getStaticPaths: GetStaticPaths = async () => {
  const summaries = await getSeriesSummaries()
  return summaries.map((summary) => ({
    // Astro 接收原始参数并负责静态路径编码；页面链接由 seriesUrl 统一 encodeURIComponent。
    params: { series: summary.name },
    props: { summary },
  }))
}

const { summary } = Astro.props as { summary: SeriesSummary }
const visual = getSeriesVisual(summary.name)
const firstPost = summary.posts[0]
const lastPost = summary.posts.at(-1)
const description =
  firstPost && lastPost
    ? `${summary.name}系列，共 ${summary.count} 篇：从「${firstPost.data.title}」到「${lastPost.data.title}」，按顺序阅读。`
    : `${summary.name}系列文章。`
---

<Base title={`${summary.name} 系列`} description={description}>
  <div
    class="series-theme"
    data-tone={visual.tone}
    data-signature={visual.signature}
    style={seriesVisualStyle(visual)}
  >
  <nav class="crumbs mono" aria-label="面包屑导航">
    <a href="/">home</a>
    <span aria-hidden="true">/</span>
    <a href="/series/">series</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{summary.name}</span>
  </nav>

  <header class="series-hero">
    <div class="hero-identity mono" aria-hidden="true">
      <span class="hero-code">{visual.code}</span>
      <span class="hero-mark">{visual.mark}</span>
    </div>
    <div class="hero-copy">
      <p class="eyebrow mono"><span class="status-dot" aria-hidden="true" /> reading path</p>
      <h1 class="series-title">{summary.name}</h1>
      <p class="series-desc">{description}</p>
    </div>

    <dl class="hero-stats mono" aria-label="系列信息">
      <div>
        <dt>chapters</dt>
        <dd>{String(summary.count).padStart(2, '0')}</dd>
      </div>
      <div>
        <dt>category</dt>
        <dd class="stat-text">{summary.categories.join(' / ')}</dd>
      </div>
      <div>
        <dt>updated</dt>
        <dd class="stat-date">{formatDate(summary.lastUpdatedAt)}</dd>
      </div>
    </dl>
  </header>

  <section class="route-map col-side" aria-labelledby="route-title">
    <div class="route-head">
      <div>
        <p class="route-kicker mono">PUBLISHED SEQUENCE</p>
        <h2 id="route-title">阅读进度</h2>
      </div>
      <p class="route-count mono">{summary.count} / {summary.count} chapters online</p>
    </div>

    <div class="progress-track" aria-hidden="true">
      {summary.posts.map((post, index) => (
        <div class="progress-step">
          <span class="progress-line" />
          <span class="progress-dot" />
          <span class="progress-no mono">{String(post.data.order ?? index + 1).padStart(2, '0')}</span>
        </div>
      ))}
    </div>

    <p class="route-note">
      建议从第 01 篇开始；每一章都会复用前文建立的术语、工具或分析路径。
    </p>
  </section>

  <section class="chapters-section col-side" aria-labelledby="chapters-title">
    <header class="section-head">
      <div>
        <p class="section-kicker mono">// ordered chapters</p>
        <h2 id="chapters-title">按顺序阅读</h2>
      </div>
      <div class="topic-tags mono" aria-label="系列主题标签">
        {summary.topTags.map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
      </div>
    </header>

    <ol class="chapter-list">
      {
        summary.posts.map((post, index) => {
          const chapter = post.data.order ?? index + 1
          return (
            <li class="chapter-item">
              <div class="chapter-rail" aria-hidden="true">
                <span class="chapter-marker mono">{String(chapter).padStart(2, '0')}</span>
                {index < summary.posts.length - 1 && <span class="rail-line" />}
              </div>

              <article class="chapter-card">
                <header class="chapter-head mono">
                  <span class="chapter-label">CHAPTER {String(chapter).padStart(2, '0')}</span>
                  <span class="chapter-date">{formatDate(post.data.pubDate)}</span>
                </header>

                <h3 class="chapter-title">
                  <a
                    href={postUrl(post)}
                    data-jmp
                    data-jmp-source={`series / CH ${String(chapter).padStart(2, '0')}`}
                    data-jmp-title={post.data.title}
                  >{post.data.title}</a>
                </h3>
                <p class="chapter-desc">{post.data.description}</p>

                <footer class="chapter-foot">
                  <a class="category mono" href={categoryUrl(post.data.category)}>{post.data.category}</a>
                  <div class="tags mono">
                    {post.data.tags.slice(0, 4).map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
                  </div>
                  <a
                    class="read mono"
                    href={postUrl(post)}
                    aria-label={`阅读「${post.data.title}」`}
                    data-jmp
                    data-jmp-source={`series / CH ${String(chapter).padStart(2, '0')}`}
                    data-jmp-title={post.data.title}
                  >
                    read <span aria-hidden="true">→</span>
                  </a>
                </footer>
              </article>
            </li>
          )
        })
      }
    </ol>
  </section>

  <footer class="series-foot">
    <a class="back mono" href="/series/"><span aria-hidden="true">←</span> all series</a>
    <p>完成这条路径后，可以从其他系列继续扩展相邻知识。</p>
  </footer>
  </div>
</Base>

<style>
  .series-theme {
    --series-accent: var(--color-accent);
    --series-soft: var(--color-accent-soft);
    --series-glow: rgb(61 220 132 / 0.14);
    --series-ink: var(--color-text-strong);
    --series-angle: 135deg;
    position: relative;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    color: var(--color-faint);
    font-size: 0.68rem;
  }

  .crumbs a {
    color: var(--color-faint);
    text-decoration: none;
    transition: color 0.16s;
  }

  .crumbs a:hover {
    color: var(--series-accent);
  }

  .crumbs span[aria-current='page'] {
    overflow: hidden;
    max-width: 20rem;
    color: var(--color-dim);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: end;
    padding: 1.25rem 0 2.5rem;
    background:
      radial-gradient(circle at 82% 8%, var(--series-glow), transparent 28%),
      repeating-linear-gradient(
        var(--series-angle),
        transparent 0 24px,
        color-mix(in srgb, var(--series-accent) 2.8%, transparent) 24px 25px
      );
    border-bottom: 1px solid var(--color-line-bright);
  }

  .series-hero::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: min(14rem, 42vw);
    height: 1px;
    background: linear-gradient(90deg, var(--series-accent), transparent);
  }

  .hero-identity {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    pointer-events: none;
  }

  .hero-code {
    padding: 0.28rem 0.48rem;
    color: var(--series-ink);
    font-size: 0.61rem;
    letter-spacing: 0.18em;
    background: color-mix(in srgb, var(--color-bg) 74%, transparent);
    border: 1px solid var(--series-soft);
  }

  .hero-mark {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    place-items: center;
    color: var(--series-accent);
    font-size: 1.15rem;
    line-height: 1;
    background: var(--series-glow);
    border: 1px solid var(--series-soft);
  }

  .series-theme[data-signature='layers'] .hero-mark {
    box-shadow:
      4px 4px 0 -2px var(--color-bg),
      4px 4px 0 -1px var(--series-soft);
  }

  .series-theme[data-signature='signal'] .hero-mark {
    width: 3rem;
    border-radius: 999px;
    font-size: 1.45rem;
  }

  .series-theme[data-signature='cipher'] .hero-mark {
    border-style: dashed;
    font-size: 1.3rem;
  }

  .series-theme[data-signature='split'] .hero-mark {
    border-radius: 50% 0 50% 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    color: var(--series-accent);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--series-accent);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--series-accent) 10%, transparent),
      0 0 16px var(--series-glow);
  }

  .series-title {
    max-width: 42rem;
    color: var(--color-text-strong);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .series-desc {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--color-dim);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 1.6rem;
    min-width: 21rem;
    padding-right: 1.5rem;
  }

  .hero-stats div {
    display: grid;
    align-content: end;
    gap: 0.3rem;
  }

  .hero-stats dt {
    color: var(--color-faint);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-stats dd {
    color: var(--color-text-strong);
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }

  .hero-stats div:first-child dd {
    color: var(--series-accent);
  }

  .hero-stats .stat-text,
  .hero-stats .stat-date {
    color: var(--color-dim);
    font-size: 0.72rem;
  }

  .route-map {
    margin-top: 2rem;
    padding: 1.25rem 1.35rem 1.15rem;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--series-accent) 5%, transparent), transparent 55%),
      var(--color-bg-soft);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--series-accent);
    border-radius: var(--radius);
  }

  .route-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .route-kicker,
  .section-kicker {
    margin-bottom: 0.3rem;
    color: var(--color-faint);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  .route-head h2,
  .section-head h2 {
    color: var(--color-text-strong);
    font-size: 1.05rem;
    font-weight: 620;
  }

  .route-count {
    color: var(--series-accent);
    font-size: 0.65rem;
  }

  .progress-track {
    display: flex;
    margin-top: 1.4rem;
  }

  .progress-step {
    position: relative;
    display: grid;
    flex: 1;
    gap: 0.45rem;
    justify-items: start;
  }

  .progress-step:last-child {
    flex: 0;
  }

  .progress-line {
    position: absolute;
    top: 0.3rem;
    left: 0.55rem;
    width: calc(100% - 0.25rem);
    height: 1px;
    background: linear-gradient(90deg, var(--series-accent), var(--series-soft));
    opacity: 0.65;
  }

  .progress-step:last-child .progress-line {
    display: none;
  }

  .progress-dot {
    position: relative;
    z-index: 1;
    width: 0.62rem;
    height: 0.62rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--series-accent);
    box-shadow:
      0 0 0 1px var(--series-soft),
      0 0 14px var(--series-glow);
  }

  .progress-no {
    color: var(--color-faint);
    font-size: 0.6rem;
  }

  .route-note {
    margin-top: 0.8rem;
    color: var(--color-faint);
    font-size: 0.74rem;
    line-height: 1.6;
  }

  .chapters-section {
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-line-bright);
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.65rem;
    font-size: 0.64rem;
  }

  .topic-tags a {
    color: var(--color-faint);
    text-decoration: none;
    transition: color 0.16s;
  }

  .topic-tags a:hover {
    color: var(--series-accent);
  }

  .chapter-list {
    margin-top: 1.3rem;
  }

  .chapter-item {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
  }

  .chapter-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .chapter-marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--series-accent);
    font-size: 0.68rem;
    background: var(--color-bg);
    border: 1px solid var(--series-soft);
    border-radius: 50%;
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--series-accent) 5%, transparent),
      0 0 16px var(--series-glow);
  }

  .rail-line {
    position: absolute;
    top: 2rem;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, var(--series-soft), var(--color-line));
  }

  .chapter-card {
    position: relative;
    padding: 0 0 2rem 1.25rem;
  }

  .chapter-card::before {
    content: '';
    position: absolute;
    inset: 0 0 2rem 0;
    z-index: -1;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .chapter-card:hover::before {
    background:
      linear-gradient(100deg, color-mix(in srgb, var(--series-accent) 4%, transparent), transparent 48%),
      color-mix(in srgb, var(--color-surface) 62%, transparent);
    border-color: color-mix(in srgb, var(--series-accent) 30%, var(--color-line-bright));
  }

  .chapter-head,
  .chapter-title,
  .chapter-desc,
  .chapter-foot {
    margin-right: 1.25rem;
  }

  .chapter-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.05rem;
    color: var(--color-faint);
    font-size: 0.61rem;
    letter-spacing: 0.08em;
  }

  .chapter-label {
    color: var(--series-accent);
  }

  .chapter-title {
    margin-top: 0.55rem;
    font-size: 1.18rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .chapter-title a {
    color: var(--color-text-strong);
    text-decoration: none;
    transition: color 0.16s;
  }

  .chapter-title a:hover,
  .chapter-title a:focus-visible {
    color: var(--series-ink);
    outline: none;
  }

  .chapter-desc {
    margin-top: 0.55rem;
    color: var(--color-dim);
    font-size: 0.84rem;
    line-height: 1.72;
  }

  .chapter-foot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 1.65rem;
    margin-top: 0.9rem;
  }

  .category {
    padding: 0.12rem 0.4rem;
    color: var(--color-text);
    font-size: 0.61rem;
    text-decoration: none;
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius-sm);
    transition:
      color 0.16s,
      border-color 0.16s;
  }

  .category:hover {
    color: var(--series-accent);
    border-color: var(--series-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    min-width: 0;
    font-size: 0.61rem;
  }

  .tags a {
    color: var(--color-faint);
    text-decoration: none;
    transition: color 0.16s;
  }

  .tags a:hover {
    color: var(--series-accent);
  }

  .read {
    margin-left: auto;
    color: var(--series-accent);
    font-size: 0.65rem;
    text-decoration: none;
  }

  .read span {
    display: inline-block;
    transition: translate 0.2s var(--ease-out-expo);
  }

  .read:hover span {
    translate: 0.25rem 0;
  }

  .series-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .back {
    color: var(--color-dim);
    font-size: 0.72rem;
    text-decoration: none;
    transition: color 0.16s;
  }

  .back:hover {
    color: var(--series-accent);
  }

  .series-foot p {
    color: var(--color-faint);
    font-size: 0.74rem;
  }

  @media (max-width: 820px) {
    .series-hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-stats {
      min-width: 0;
      padding-top: 1rem;
      padding-right: 1.5rem;
      border-top: 1px solid var(--color-line);
    }
  }

  @media (max-width: 580px) {
    .series-hero {
      padding-top: 0.5rem;
    }

    .hero-identity {
      display: none;
    }

    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-stats div:last-child {
      grid-column: 1 / -1;
    }

    .route-head,
    .section-head,
    .series-foot {
      align-items: start;
      flex-direction: column;
    }

    .topic-tags {
      justify-content: start;
    }

    .chapter-item {
      grid-template-columns: 2.45rem minmax(0, 1fr);
    }

    .chapter-marker {
      width: 1.7rem;
      height: 1.7rem;
      font-size: 0.61rem;
    }

    .rail-line {
      top: 1.7rem;
    }

    .chapter-card {
      padding-left: 1rem;
    }

    .chapter-head,
    .chapter-title,
    .chapter-desc,
    .chapter-foot {
      margin-right: 1rem;
    }

    .chapter-foot {
      align-items: start;
      flex-wrap: wrap;
    }

    .tags {
      order: 3;
      width: 100%;
    }

    .read {
      margin-left: auto;
    }

    .series-foot p {
      line-height: 1.6;
    }
  }
</style>
