---
import Base from '../../layouts/Base.astro'
import { SITE } from '../../consts'
import { getPostsByDateDesc, formatDate, postUrl } from '../../lib/posts'
import '../../styles/utility-open.css'
const posts = await getPostsByDateDesc()
const feedUrl = new URL('/rss.xml', SITE.url).href
---
<Base title="订阅更新" description={`通过 RSS 订阅 ${SITE.title} 的文章更新`} width="content" bodyClass="atlas-mode utility-open">
  <header class="utility-head">
    <h1 lang="en">Updates</h1>
    <p class="utility-intro">用 RSS 接收新文章，无需账号。</p>
  </header>
  <section class="subscription" aria-labelledby="feed-title">
    <h2 id="feed-title">订阅地址</h2>
    <p>将这个地址添加到你的 RSS 阅读器。</p>
    <div class="feed-address-row">
      <a class="feed-address" href="/rss.xml" data-astro-reload><code>{feedUrl}</code></a>
      <button class="feed-copy" type="button" data-copy-feed data-feed-url={feedUrl} hidden>复制地址 <span aria-hidden="true">↗</span></button>
    </div>
    <p class="feed-status" data-feed-status role="status" aria-live="polite"></p>
  </section>
  <section class="subscription-notes" aria-labelledby="updates-title">
    <header><h2 id="updates-title">文章更新</h2><span>{posts.length} 篇</span></header>
    <ol class="updates-list" data-rss-posts>{posts.map(post => <li>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a href={postUrl(post)}>{post.data.title}<span aria-hidden="true">↗</span></a>
    </li>)}</ol>
    <a class="utility-back" href="/archive/">前往文章索引 <span aria-hidden="true">↗</span></a>
  </section>
</Base>
<script>
  import '../../scripts/subscription'
</script>
