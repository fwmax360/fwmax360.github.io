---
import Base from '../../layouts/Base.astro'
import { SITE } from '../../consts'
import { getPostsByDateDesc, formatDate, postUrl } from '../../lib/posts'

const posts = await getPostsByDateDesc()
const feedUrl = new URL('/rss.xml', SITE.url).href
const absolutePostUrl = (post: (typeof posts)[number]) => new URL(postUrl(post), SITE.url).href
---

<Base title="RSS" description={`订阅 ${SITE.title} 的文章更新`} width="content">
  <header class="page-head">
    <h1 class="page-title mono">订阅更新</h1>
    <p class="page-sub">给人看的订阅页。机器请用下面的 feed 地址。</p>
  </header>

  <section class="feed-box mono">
    <div class="feed-row">
      <span class="feed-k">feed</span>
      <a class="feed-v" href={feedUrl} data-astro-reload>{feedUrl}</a>
    </div>
    <div class="feed-row">
      <span class="feed-k">copy</span>
      <button type="button" class="feed-copy" data-copy-feed aria-label="复制 RSS 地址">
        {feedUrl}
      </button>
    </div>
    <p class="feed-note">
      直接打开 <code>rss.xml</code> 时，有的浏览器会用白底浅字的 XML 树，几乎看不清。
      本页和 <code>rss.xsl</code> 都按明暗主题写了对比度；订阅器只读 XML，不受影响。
    </p>
  </section>

  <section class="block">
    <h2 class="kicker">最近文章</h2>
    <ul class="list">
      {
        posts.map((post) => (
          <li class="item">
            <time class="mono" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <a href={absolutePostUrl(post)}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  function setup() {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy-feed]')
    if (!btn || btn.dataset.bound) return
    btn.dataset.bound = '1'
    const text = btn.textContent ?? ''
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text)
        btn.textContent = 'copied'
        setTimeout(() => {
          btn.textContent = text
        }, 1400)
      } catch {
        btn.textContent = 'copy failed'
        setTimeout(() => {
          btn.textContent = text
        }, 1400)
      }
    })
  }
  setup()
  document.addEventListener('astro:after-swap', setup)
</script>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-text-strong);
    letter-spacing: -0.02em;
  }

  .page-title::before {
    content: '$ ';
    color: var(--color-accent);
  }

  .page-sub {
    margin-top: 0.5rem;
    color: var(--color-dim);
    font-size: 0.92rem;
  }

  .feed-box {
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-bg-soft);
    margin-bottom: 2.75rem;
  }

  .feed-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.35rem 0;
  }

  .feed-k {
    width: 3.5rem;
    color: var(--color-faint);
    font-size: 0.75rem;
  }

  .feed-v {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .feed-v:hover {
    text-decoration: underline;
  }

  .feed-copy {
    border: 0;
    background: transparent;
    color: var(--color-dim);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0;
    text-align: left;
  }

  .feed-copy:hover {
    color: var(--color-accent);
  }

  .feed-note {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--color-faint);
    font-family: var(--font-sans);
  }

  .feed-note code {
    font-family: var(--font-mono);
    color: var(--color-dim);
  }

  .block .kicker {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-line-bright);
    margin-bottom: 0.75rem;
  }

  .item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.92rem;
  }

  .item time {
    font-size: 0.75rem;
    color: var(--color-faint);
    padding-top: 0.2rem;
  }

  .item a {
    color: var(--color-text);
    text-decoration: none;
  }

  .item a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
