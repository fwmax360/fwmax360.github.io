---
import Base from '../layouts/Base.astro'
import AboutShell from '../components/AboutShell.astro'
import '../styles/about-open.css'
import { SITE, SOCIAL } from '../consts'
import { getCategories, getPosts } from '../lib/posts'
import { getSeriesSummaries } from '../lib/series'

const [posts, categories, series] = await Promise.all([getPosts(), getCategories(), getSeriesSummaries()])

const principles = [
  { title: 'Observe', text: '先保留现场与行为证据，再给机制下结论。' },
  { title: 'Isolate', text: '把复杂链路拆成最小可验证假设，逐项排除噪声。' },
  { title: 'Verify', text: '同一结论尽量用静态、动态与运行结果交叉确认。' },
  { title: 'Document', text: '记录版本、失败路径和限制，让过程真正可复用。' },
]

const currentFocus = ['Native runtime', 'Anti-debug', 'Protocol tracing', 'Custom VM']

const skills = [
  {
    group: 'Android',
    items: [
      { name: 'Smali / DEX', tip: '看得懂，写得出，改完必崩一次。' },
      { name: 'ART & Native Hook', tip: 'Hook 成功那一刻，应用已经自杀了。' },
      { name: 'Frida', tip: 'spawn 模式：能抓启动逻辑，也能被秒杀。' },
      { name: 'Xposed / LSPosed', tip: '模块能装上 ≠ 模块能用。' },
      { name: '加固与脱壳', tip: '脱完壳发现只是换了个壳。' },
      { name: 'SO 保护对抗', tip: '段加密？好。虚拟机？……我去倒杯咖啡。' },
    ],
  },
  {
    group: 'Binary',
    items: [
      { name: 'ELF / PE', tip: '格式书永远比样本厚。' },
      { name: 'ARM & ARM64', tip: 'x0 是参数，也是玄学。' },
      { name: 'IDA Pro', tip: 'F5 出糊状物时，请保持冷静。' },
      { name: 'Ghidra', tip: '免费的反编译器，付费的是你的时间。' },
      { name: 'Unidbg', tip: '模拟执行到一半：UnsatisfiedLinkError。' },
      { name: 'OLLVM / VMP', tip: '控制流平坦化：平坦的是你的心态。' },
    ],
  },
  {
    group: 'Crypto',
    items: [
      { name: 'AES / DES / RC4', tip: '标准算法好认，魔改才是真爱。' },
      { name: '魔改算法识别', tip: 'S-box 一改，论文白看。' },
      { name: '白盒', tip: '白盒：密钥藏在算法里。你：密钥藏在二进制里。' },
      { name: '协议还原', tip: '抓包三小时，加密五分钟。' },
    ],
  },
]

const faqs = [
  {
    q: '你是全职逆向吗？',
    a: '白天可能是，晚上一定是。凌晨三点的我属于 IDA。',
  },
  {
    q: '能接分析单吗？',
    a: '先看样本会不会主动反调试。会的话，报价 ×2；会且会崩 Frida，报价 ×3。骗你的，根本接不到。',
  },
  {
    q: '博客多久更新一次？',
    a: '有新坑就写。没坑的时候……说明我还在坑里。',
  },
  {
    q: '为什么叫 sleep4r / Sleep3r？',
    a: '因为有些平台一个用户名已经被人占了，只好换数字。Sleep3r、sleep4r，本质都是睡不够的同一个我。点左边的名字试试。',
  },
]
---
<Base title="关于" description={`关于 ${SITE.author}：${SITE.subtitle}`} bodyClass="atlas-mode about-open">
  <div data-about>
    <header class="about-intro">
      <div>
        <p class="about-handle">{SITE.handle} / <span data-name-static>{SITE.author}</span><button type="button" data-name-poke hidden><span data-name-text>{SITE.author}</span><span class="name-hint" aria-hidden="true">↻</span></button></p>
        <h1>先拆开看看，<br />再慢慢写明白。</h1>
      </div>
      <div class="about-intro-note">
        <p>这里记录安卓逆向、二进制安全与系统底层研究。保留判断依据，也保留失败路线。</p>
        <p>{posts.length} 篇文章 · {series.length} 个系列 · {categories.length} 个分类</p>
        <nav aria-label="关于页快捷入口"><a href="/archive/">笔记 ↗</a><a href="/series/">系列 ↗</a><a href="/map/">图谱 ↗</a></nav>
      </div>
    </header>
    <section class="about-section about-story" aria-labelledby="manifesto-title">
      <h2 id="manifesto-title">结论当然要有，<br />翻车过程也一起记。</h2>
      <div><p>我是 <strong>{SITE.author}</strong>，主要方向是安卓逆向与二进制安全。文章会尽量交代观察、假设、验证和限制，而不是只留下一个最终答案。</p>
      <ul class="about-topics" aria-label="内容类型"><li>目标分析与失败路线</li><li>加载器、链接器与运行时</li><li>工具链、脚本与实验记录</li></ul></div>
    </section>
    <section class="about-section" aria-labelledby="protocol-title">
      <h2 id="protocol-title">研究方法</h2>
      <div><ul class="about-methods">{principles.map(item => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ul>
      <p class="about-focus">正在看 <span>{currentFocus.join(' · ')}</span></p></div>
    </section>
    <section class="about-section" aria-labelledby="tools-title">
      <div><h2 id="tools-title">常用工具</h2><p class="about-hint">点开一项，看一点吐槽。</p></div>
      <div class="about-tools">{skills.map(s => <section><h3>{s.group}</h3><div>{s.items.map(i => <details class="tool-note"><summary>{i.name}</summary><p>{i.tip}</p></details>)}</div></section>)}</div>
    </section>
    <section class="about-section" aria-labelledby="faq-title">
      <h2 id="faq-title">常见问题</h2>
      <div class="about-faqs">{faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </section>
    <section class="about-section" aria-labelledby="play-title">
      <div><h2 id="play-title">研究之外</h2><p class="about-hint">一点逆向日常的玩笑。</p></div>
      <div class="about-play">
        <details class="about-console"><summary>随便敲敲 <span>打开终端</span></summary><AboutShell /></details>
        <details class="about-debug" data-adbg hidden><summary>调试小实验 <span>仅为页面模拟</span></summary>
          <div class="debug-readout" aria-live="polite"><span>TracerPid <b data-adbg-pid>0</b></span><span>Status <b data-adbg-status>clean</b></span></div>
          <button type="button" data-adbg-btn>attach debugger</button><p data-adbg-msg hidden></p>
        </details>
      </div>
    </section>
    <section class="about-section" aria-labelledby="contact-title">
      <h2 id="contact-title">联系与订阅</h2>
      <ul class="about-contacts">{SOCIAL.map(s => <li><a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}><span>{s.label}</span><span>{s.href.replace(/^https?:\/\//,'')} ↗</span></a></li>)}</ul>
    </section>
  </div>
</Base>
<script>import '../scripts/about-page'</script>
