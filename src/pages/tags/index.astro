---
import Base from '../../layouts/Base.astro'
import { groupEditorialTags } from '../../lib/editorialIndex'
import { categoryUrl, getCategories, getTags, tagUrl } from '../../lib/posts'

const tags = await getTags()
const categories = await getCategories()
const groups = groupEditorialTags(tags)
const highSignals = tags.filter((tag) => tag.count >= 2).slice(0, 6)
const max = Math.max(1, ...tags.map((tag) => tag.count))
---

<Base title="标签" description="按受控术语与分类浏览全部文章。">
  <header class="page-head">
    <div class="page-title-row">
      <div>
        <h1 class="page-title">标签</h1>
        <p class="page-sub">按标签和分类找到相关笔记。</p>
      </div>
      <dl class="page-metrics mono">
        <div><dt>标签</dt><dd>{String(tags.length).padStart(2, '0')}</dd></div>
        <div><dt>分组</dt><dd>{String(groups.length).padStart(2, '0')}</dd></div>
        <div><dt>分类</dt><dd>{String(categories.length).padStart(2, '0')}</dd></div>
      </dl>
    </div>
  </header>

  <section class="signal-board" aria-labelledby="signals-title" data-reveal>
    <header class="section-head">
      <div>
        <h2 id="signals-title">常用标签</h2>
      </div>
    </header>
    <div class="signal-grid col-side">
      {highSignals.map((tag, index) => (
        <a
          href={tagUrl(tag.name)}
          class="signal-card"
          style={`--signal:${(tag.count / max) * 100}%;--signal-delay:${index * -0.7}s`}



        >
          <span class="signal-code mono">SIG / {String(index + 1).padStart(2, '0')}</span>
          <strong>#{tag.name}</strong>
          <span class="signal-count mono"><b>{String(tag.count).padStart(2, '0')}</b> 篇</span>
          <i aria-hidden="true"><span></span></i>
        </a>
      ))}
    </div>
  </section>

  <section class="domain-strip" id="categories" aria-labelledby="domains-title" data-reveal>
    <header class="section-head compact-head">
      <div>
        <p class="mono">PRIMARY 分类</p>
        <h2 id="domains-title">顶层分类</h2>
      </div>
    </header>
    <div class="domain-grid col-side">
      {categories.map((category, index) => (
        <a href={categoryUrl(category.name)} class="domain-card">
          <span class="mono">0x{String(index).padStart(2, '0')}</span>
          <strong>{category.name}</strong>
          <b class="mono">{String(category.count).padStart(2, '0')}</b>
        </a>
      ))}
    </div>
  </section>

  <section class="vocabulary" data-vocabulary aria-labelledby="vocabulary-title">
    <header class="vocabulary-toolbar" data-reveal>
      <div>
        <p class="mono">TERM LIBRARY / 0x{tags.length.toString(16).toUpperCase()}</p>
        <h2 id="vocabulary-title">全部标签</h2>
      </div>
      <div class="tag-search">
        <label class="mono" for="tag-query">筛选标签</label>
        <div>
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="8" r="5"></circle><path d="m12 12 4 4"></path></svg>
          <input id="tag-query" type="search" placeholder="标签或分组…" autocomplete="off" spellcheck="false" data-tag-query />
          <button type="button" class="mono" data-tag-clear disabled>清除</button>
        </div>
      </div>
      <p class="tag-status mono" aria-live="polite"><i aria-hidden="true"></i><b data-tag-count>{tags.length}</b> / {tags.length} terms visible</p>
    </header>

    <nav class="group-index mono" aria-label="术语分组">
      {groups.map((group, index) => (
        <a href={`#group-${group.id}`} data-tag-group-link={group.id}>
          <span>0{index + 1}</span>{group.label}<b>{String(group.tags.length).padStart(2, '0')}</b>
        </a>
      ))}
    </nav>

    <div class="group-stack col-side">
      {groups.map((group, groupIndex) => (
        <section
          class="tag-group"
          id={`group-${group.id}`}
          data-tag-group
          data-group-search={`${group.label} ${group.code} ${group.description}`}
          data-reveal
        >
          <header class="group-head">
            <div class="group-identity mono">
              <span>{String(groupIndex + 1).padStart(2, '0')}</span>
              <b>{group.code}</b>
            </div>
            <div>
              <h3>{group.label}</h3>
              <p>{group.description}</p>
            </div>
            <span class="group-count mono"><b data-group-count>{String(group.tags.length).padStart(2, '0')}</b> terms</span>
          </header>

          <div class="term-grid">
            {group.tags.map((tag, index) => (
              <a
                href={tagUrl(tag.name)}
                class="term-card"
                data-tag-item
                data-tag-search={`${tag.name} ${group.label} ${group.code}`}
                style={`--weight:${tag.count / max}`}



              >
                <span class="term-index mono">{group.code}.{String(index + 1).padStart(2, '0')}</span>
                <strong>#{tag.name}</strong>
                <span class="term-meta mono"><b>{String(tag.count).padStart(2, '0')}</b> linked</span>
                <i aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="vocabulary-empty mono" data-tag-empty hidden>NO_标签_MATCH_QUERY</p>
  </section>
</Base>

<script>
  let vocabularyObserver: IntersectionObserver | null = null
  let vocabularyObserverRoot: HTMLElement | null = null

  const setupVocabulary = () => {
    const nextRoot = document.querySelector<HTMLElement>('[data-vocabulary]')
    if (nextRoot && nextRoot === vocabularyObserverRoot && nextRoot.dataset.bound === 'true') return
    vocabularyObserver?.disconnect()
    vocabularyObserver = null
    vocabularyObserverRoot = nextRoot

    if (!nextRoot) return

    document.querySelectorAll<HTMLElement>('[data-vocabulary]').forEach((root) => {
      if (root.dataset.bound === 'true') return
      root.dataset.bound = 'true'
      const query = root.querySelector<HTMLInputElement>('[data-tag-query]')
      const clear = root.querySelector<HTMLButtonElement>('[data-tag-clear]')
      const count = root.querySelector<HTMLElement>('[data-tag-count]')
      const empty = root.querySelector<HTMLElement>('[data-tag-empty]')
      const items = [...root.querySelectorAll<HTMLElement>('[data-tag-item]')]
      const groups = [...root.querySelectorAll<HTMLElement>('[data-tag-group]')]
      const motionEnabled = () =>
        document.documentElement.dataset.motion === 'ready' &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches

      const setActiveGroup = (id?: string) => {
        root.querySelectorAll<HTMLElement>('[data-tag-group-link]').forEach((link) => {
          const active = Boolean(id && link.dataset.tagGroupLink === id)
          link.classList.toggle('is-current', active)
          if (active) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
        groups.forEach((group) => group.classList.toggle('is-current', Boolean(id && group.id === `group-${id}`)))
      }

      const filter = () => {
        const term = query?.value.trim().toLocaleLowerCase('zh-CN') ?? ''
        let visible = 0
        items.forEach((item) => {
          const show = !term || (item.dataset.tagSearch ?? '').toLocaleLowerCase('zh-CN').includes(term)
          const wasHidden = item.hidden
          item.hidden = !show
          if (show) visible++
          if (show && (wasHidden || term) && motionEnabled()) {
            item.animate(
              [
                { opacity: 0, transform: 'translate3d(0, 7px, 0) scale(.985)' },
                { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
              ],
              { duration: 280, easing: 'cubic-bezier(.16,1,.3,1)' },
            )
          }
        })
        groups.forEach((group) => {
          const visibleItems = [...group.querySelectorAll<HTMLElement>('[data-tag-item]')].filter((item) => !item.hidden)
          group.hidden = visibleItems.length === 0
          const groupCount = group.querySelector<HTMLElement>('[data-group-count]')
          if (groupCount) groupCount.textContent = String(visibleItems.length).padStart(2, '0')
        })
        if (count) count.textContent = String(visible)
        if (empty) empty.hidden = visible > 0
        if (clear) clear.disabled = !term
        const firstGroup = groups.find((group) => !group.hidden)
        setActiveGroup(firstGroup?.id.replace(/^group-/, ''))
        if (count && motionEnabled()) {
          count.animate(
            [{ color: 'var(--color-accent)', transform: 'translateY(-2px)' }, { color: 'var(--color-text)', transform: 'translateY(0)' }],
            { duration: 260, easing: 'ease-out' },
          )
        }
      }

      query?.addEventListener('input', filter)
      clear?.addEventListener('click', () => {
        if (query) query.value = ''
        filter()
        query?.focus()
      })

      if ('IntersectionObserver' in window) {
        vocabularyObserver = new IntersectionObserver(
          (entries) => {
            const active = entries
              .filter((entry) => entry.isIntersecting && !(entry.target as HTMLElement).hidden)
              .sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top))[0]
            if (!active) return
            setActiveGroup((active.target as HTMLElement).id.replace(/^group-/, ''))
          },
          { rootMargin: '-22% 0px -68% 0px', threshold: 0 },
        )
        groups.forEach((group) => vocabularyObserver?.observe(group))
      }
    })
  }

  setupVocabulary()
  document.addEventListener('astro:page-load', setupVocabulary)
</script>

<style>
  .page-head { position:relative;isolation:isolate;overflow:hidden;margin-bottom:3.5rem;padding:clamp(1.35rem,3vw,2rem);border:1px solid var(--color-line);background:linear-gradient(110deg,rgb(61 220 132 / .06),transparent 38%),var(--color-panel);box-shadow:var(--shadow-panel),inset 0 1px rgb(255 255 255 / .02); }
  .page-head::after { content:none; }
  .page-eyebrow { display:flex;align-items:center;gap:.5rem;margin-bottom:1.1rem;color:var(--color-faint);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase; }
  .page-eyebrow span { width:.4rem;height:.4rem;background:var(--color-accent);box-shadow:0 0 12px rgb(61 220 132 / .42); }
  .page-title-row { display:flex;align-items:end;justify-content:space-between;gap:2rem; }
  .page-title { color:var(--color-text-strong);font:620 clamp(2.4rem,5vw,3.7rem)/1 var(--font-display);letter-spacing:-.025em; }
  .page-title::before { content:'$ ';color:var(--color-accent);font-family:var(--font-mono);font-weight:500; }
  .page-sub { max-width:42rem;margin-top:.9rem;color:var(--color-dim);font-size:.92rem; }
  .page-metrics { display:flex;gap:1.5rem; }
  .page-metrics div { min-width:4.25rem; }
  .page-metrics dt { color:var(--color-faint);font-size:.54rem;letter-spacing:.12em; }
  .page-metrics dd { margin-top:.22rem;color:var(--color-text-strong);font-size:.82rem; }

  .section-head { display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--color-line-bright); }
  .section-head p { color:var(--color-accent);font-size:.55rem;letter-spacing:.11em; }
  .section-head h2 { margin-top:.15rem;color:var(--color-text-strong);font-size:1.2rem; }
  .section-head > span { color:var(--color-faint);font-size:.55rem; }
  .signal-board,.domain-strip { margin-bottom:3.5rem; }
  .signal-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem; }
  .signal-card { position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.25rem .8rem;overflow:hidden;padding:1rem;border:1px solid var(--color-line);background:linear-gradient(125deg,rgb(61 220 132 / .055),rgb(8 11 16 / .9));text-decoration:none; }
  .signal-card::before { content:'';position:absolute;z-index:-1;top:-80%;left:-35%;width:42%;height:260%;background:linear-gradient(90deg,transparent,rgb(82 225 152 / .065),transparent);transform:rotate(18deg) translateX(-140%);animation:signal-sweep 7.5s ease-in-out infinite;animation-delay:var(--signal-delay,0s);pointer-events:none; }
  .signal-code { grid-column:1/-1;color:var(--color-faint);font-size:.52rem;letter-spacing:.08em; }
  .signal-card strong { overflow:hidden;color:var(--color-text);font-size:1rem;text-overflow:ellipsis;white-space:nowrap; }
  .signal-count { color:var(--color-faint);font-size:.54rem; }
  .signal-count b { color:var(--color-accent);font-size:.75rem;font-weight:500; }
  .signal-card > i { position:absolute;right:0;bottom:0;left:0;height:1px;background:var(--color-line); }
  .signal-card > i span { display:block;width:var(--signal);height:100%;background:linear-gradient(90deg,var(--color-accent-soft),var(--color-accent),var(--color-text-strong),var(--color-accent));background-size:220% 100%;box-shadow:0 0 8px var(--color-accent);animation:signal-flow 2.6s linear infinite; }
  .signal-card:hover,.signal-card:focus-visible { border-color:var(--color-accent-soft);background:linear-gradient(125deg,rgb(61 220 132 / .1),rgb(8 11 16 / .94)); }

  .compact-head { margin-bottom:.65rem; }
  .domain-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:.65rem; }
  .domain-card { display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.8rem;align-items:center;padding:.9rem 1rem;border:1px solid var(--color-line);background:rgb(9 12 17 / .72);text-decoration:none; }
  .domain-card span { color:var(--color-accent-soft);font-size:.58rem; }
  .domain-card strong { color:var(--color-text);font-size:.9rem; }
  .domain-card b { color:var(--color-faint);font-size:.65rem;font-weight:400; }
  .domain-card:hover,.domain-card:focus-visible { border-color:var(--color-accent-soft);background:rgb(61 220 132 / .045); }

  .vocabulary-toolbar { display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.7fr) auto;gap:1rem;align-items:end;padding:1rem;border:1px solid var(--color-line-bright);background:rgb(7 10 14 / .88); }
  .vocabulary-toolbar > div:first-child p { color:var(--color-accent);font-size:.55rem;letter-spacing:.11em; }
  .vocabulary-toolbar h2 { margin-top:.15rem;color:var(--color-text-strong);font-size:1.2rem; }
  .tag-search > label { display:block;margin-bottom:.35rem;color:var(--color-faint);font-size:.54rem;letter-spacing:.1em;text-transform:uppercase; }
  .tag-search > div { display:grid;grid-template-columns:1rem minmax(0,1fr) auto;gap:.5rem;align-items:center;min-height:2.55rem;padding-left:.7rem;border:1px solid var(--color-line-bright);background:#080c11; }
  .tag-search svg { width:1rem;fill:none;stroke:var(--color-faint);stroke-width:1.3; }
  .tag-search input { min-width:0;border:0;outline:0;background:transparent;color:var(--color-text);font:.7rem var(--font-mono); }
  .tag-search button { align-self:stretch;padding:0 .65rem;border:0;border-left:1px solid var(--color-line);background:transparent;color:var(--color-accent);font-size:.55rem;cursor:pointer; }
  .tag-search button:disabled { color:var(--color-faint);opacity:.45; }
  .tag-status { display:flex;align-items:center;gap:.4rem;white-space:nowrap;color:var(--color-faint);font-size:.55rem; }
  .tag-status i { width:.36rem;height:.36rem;background:var(--color-accent);box-shadow:0 0 8px var(--color-accent);animation:tag-status-pulse 1.7s ease-in-out infinite; }
  .tag-status b { color:var(--color-text);font-weight:500; }
  .group-index { display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--color-line-bright);border-top:0; }
  .group-index a { display:grid;grid-template-columns:auto 1fr auto;gap:.45rem;align-items:center;min-width:0;padding:.65rem;border-right:1px solid var(--color-line);color:var(--color-faint);font-size:.55rem;text-decoration:none;text-transform:uppercase; }
  .group-index a:last-child { border-right:0; }
  .group-index span { color:var(--color-accent-soft); }
  .group-index b { color:var(--color-faint);font-weight:400; }
  .group-index a:hover,.group-index a:focus-visible { background:rgb(61 220 132 / .04);color:var(--color-accent); }
  .group-index a.is-current { background:linear-gradient(90deg,rgb(61 220 132 / .09),transparent);color:var(--color-accent);box-shadow:inset 0 -1px var(--color-accent); }
  [hidden] { display:none !important; }

  .group-stack { margin-top:2rem; }
  .tag-group { scroll-margin-top:calc(var(--nav-offset) + 1rem); }
  .tag-group + .tag-group { margin-top:2.7rem; }
  .group-head { display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;margin-bottom:.7rem;padding-bottom:.65rem;border-bottom:1px solid var(--color-line-bright);transition:border-color .24s,background .24s; }
  .tag-group.is-current .group-head { border-bottom-color:var(--color-accent-soft);background:linear-gradient(90deg,rgb(61 220 132 / .035),transparent 42%); }
  .group-identity { display:grid;grid-template-columns:auto auto;overflow:hidden;border:1px solid var(--color-line-bright); }
  .group-identity span,.group-identity b { padding:.25rem .42rem;font-size:.54rem;font-weight:500; }
  .group-identity span { color:var(--color-faint); }
  .group-identity b { background:rgb(61 220 132 / .08);color:var(--color-accent); }
  .group-head h3 { color:var(--color-text-strong);font-size:1.05rem; }
  .group-head p { margin-top:.12rem;color:var(--color-dim);font-size:.72rem; }
  .group-count { color:var(--color-faint);font-size:.55rem; }
  .group-count b { color:var(--color-text);font-weight:500; }
  .term-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem; }
  .term-card { position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.35rem .6rem;overflow:hidden;min-height:5.2rem;padding:.75rem;border:1px solid var(--color-line);background:rgb(9 12 17 / .72);text-decoration:none; }
  .term-card::before { content:'';position:absolute;z-index:-1;right:-3rem;bottom:-3rem;width:6rem;height:6rem;border:1px solid color-mix(in srgb,var(--color-accent) 18%,transparent);border-radius:50%;opacity:0;transform:scale(.55);transition:opacity .22s,transform .5s var(--ease-out-expo); }
  .term-card:is(:hover,:focus-visible)::before { opacity:1;transform:scale(1); }
  .term-index { grid-column:1/-1;color:var(--color-faint);font-size:.48rem;letter-spacing:.06em; }
  .term-card strong { overflow:hidden;color:color-mix(in srgb,var(--color-accent) calc(38% + var(--weight) * 45%),var(--color-text));font-size:.8rem;text-overflow:ellipsis;white-space:nowrap; }
  .term-meta { color:var(--color-faint);font-size:.49rem; }
  .term-meta b { color:var(--color-text);font-weight:500; }
  .term-card > i { position:absolute;right:0;bottom:0;left:0;height:1px;background:linear-gradient(90deg,color-mix(in srgb,var(--color-accent) calc(var(--weight) * 75%),var(--color-line)),transparent); }
  .term-card:hover,.term-card:focus-visible { border-color:var(--color-accent-soft);background:rgb(61 220 132 / .045);transform:translateY(-1px); }
  .vocabulary-empty { padding:4rem;border:1px solid var(--color-line);color:var(--color-faint);font-size:.65rem;text-align:center; }

  @media (max-width:900px) {
    .signal-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .vocabulary-toolbar { grid-template-columns:1fr minmax(16rem,1fr); }
    .tag-status { grid-column:1/-1; }
    .term-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
  }
  @media (max-width:700px) {
    .page-head { margin-bottom:2.5rem; }
    .page-title-row { display:block; }
    .page-metrics { margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--color-line); }
    .signal-grid { grid-template-columns:1fr 1fr;gap:.45rem; }
    .signal-card { padding:.75rem; }
    .signal-card strong { font-size:.82rem; }
    .domain-grid { grid-template-columns:1fr; }
    .vocabulary-toolbar { grid-template-columns:1fr;padding:.8rem; }
    .tag-search { min-width:0; }
    .group-index { display:flex;overflow-x:auto; }
    .group-index a { flex:0 0 auto;min-width:8rem; }
    .group-head { grid-template-columns:auto minmax(0,1fr); }
    .group-count { grid-column:2; }
    .term-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .term-card { min-height:4.8rem;padding:.65rem; }
  }

  @keyframes tags-head-scan { 0%,20% { transform:translateX(0) skewX(-18deg);opacity:0; } 38%,64% { opacity:1; } 84%,100% { transform:translateX(760%) skewX(-18deg);opacity:0; } }
  @keyframes signal-sweep { 0%,56% { transform:rotate(18deg) translateX(-160%);opacity:0; } 68%,82% { opacity:1; } 94%,100% { transform:rotate(18deg) translateX(500%);opacity:0; } }
  @keyframes signal-flow { to { background-position:-220% 0; } }
  @keyframes tag-status-pulse { 50% { opacity:.35;box-shadow:0 0 16px var(--color-accent); } }

  :global(html[data-motion='off']) .page-head::after,
  :global(html[data-motion='off']) .signal-card::before,
  :global(html[data-motion='off']) .signal-card > i span,
  :global(html[data-motion='off']) .tag-status i { animation:none; }

  @media (prefers-reduced-motion: reduce) {
    .page-head::after,.signal-card::before,.signal-card > i span,.tag-status i { animation:none; }
    .term-card::before { display:none; }
  }
</style>
