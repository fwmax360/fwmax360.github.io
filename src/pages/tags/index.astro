---
import Base from '../../layouts/Base.astro'
import { groupEditorialTags } from '../../lib/editorialIndex'
import { categoryUrl, getCategories, getTags, tagUrl } from '../../lib/posts'
import '../../styles/taxonomy-open.css'
const [tags, categories] = await Promise.all([getTags(), getCategories()])
const groups = groupEditorialTags(tags)
const highSignals = tags.filter(tag => tag.count >= 2).slice(0, 6)
---
<Base title="标签" description="按标签和分类找到相关笔记。" bodyClass="atlas-mode taxonomy-open">
  <header class="terms-intro">
    <h1>Topics</h1>
    <p>从一个术语开始，找到相关笔记。<span>{tags.length} 个标签 · {categories.length} 个分类</span></p>
  </header>
  <section class="terms-context" aria-label="常用标签与分类">
    <div><h2>常用标签</h2><nav aria-label="常用标签">{highSignals.map(tag => <a href={tagUrl(tag.name)}>{tag.name}<small>{tag.count}</small></a>)}</nav></div>
    <div id="categories"><h2>分类</h2><nav aria-label="分类">{categories.map(category => <a href={categoryUrl(category.name)}>{category.name}<small>{category.count}</small></a>)}</nav></div>
  </section>
  <section data-vocabulary class="vocabulary" aria-labelledby="vocabulary-title">
    <div class="terms-toolbar">
      <h2 id="vocabulary-title">全部标签</h2>
      <div class="tag-search" data-tag-controls hidden>
        <label for="tag-query">筛选标签</label>
        <input id="tag-query" type="search" placeholder="标签或分组…" autocomplete="off" spellcheck="false" data-tag-query />
        <button type="button" data-tag-clear disabled>清除</button>
      </div>
      <p class="tag-status" aria-live="polite"><b data-tag-count>{tags.length}</b> / {tags.length} 个标签</p>
    </div>
    <nav class="group-index" aria-label="术语分组">{groups.map(group => <a href={`#group-${group.id}`} data-tag-group-link={group.id}>{group.label}</a>)}</nav>
    <div class="group-stack">
      {groups.map(group => <section class="tag-group" id={`group-${group.id}`} data-tag-group>
        <header><h3>{group.label}</h3><p>{group.description}</p><span><b data-group-count>{group.tags.length}</b> 个标签</span></header>
        <div class="term-flow">{group.tags.map(tag => <a href={tagUrl(tag.name)} data-tag-item data-tag-search={`${tag.name} ${group.label} ${group.code}`}><span>{tag.name}</span><small>{tag.count}</small></a>)}</div>
      </section>)}
    </div>
    <p class="vocabulary-empty" data-tag-empty hidden>没有找到相关标签。试试其他关键词。</p>
  </section>
</Base>
<script>import '../../scripts/tag-index'</script>
