---
import { noteAccent } from '../lib/note-accent'
import Base from '../layouts/Base.astro'
import { coverSvgUrl } from '../lib/covers'
import { categoryUrl, formatDate, getPostsByDateDesc, postUrl, readingStats } from '../lib/posts'
import { seriesUrl } from '../lib/series'
import '../styles/archive.css'

const posts = await getPostsByDateDesc()
const categories = [...new Set(posts.map(post => post.data.category))].sort((a,b) => a.localeCompare(b,'zh-CN'))
const series = [...new Set(posts.flatMap(post => post.data.series ? [post.data.series] : []))].sort((a,b) => a.localeCompare(b,'zh-CN'))
const years = [...new Set(posts.map(post => post.data.pubDate.getFullYear()))].sort((a,b) => b-a)
const dossiers = years.map(year => {
  const yearPosts = posts.filter(post => post.data.pubDate.getFullYear() === year)
  return {year,posts:yearPosts,months:[...new Set(yearPosts.map(post => post.data.pubDate.getMonth()+1))].sort((a,b) => b-a).map(month => ({month,posts:yearPosts.filter(post => post.data.pubDate.getMonth()+1 === month)}))}
})
const latest = posts[0]
---
<Base title="研究索引" description="沿着时间、分类与系列探索全部技术笔记。" bodyClass="atlas-mode">
  <header class="notebook-head">
    <div class="notebook-intro"><h1 lang="en">Notes</h1><p>按时间浏览全部笔记。<span>{posts.length} 篇笔记 · {years.at(-1)}—{years[0]}</span></p></div>
  </header>
  <section class="archive-system" data-archive data-archive-density="editorial" aria-label="文章研究索引">
    <noscript><style is:inline>.archive-tools{display:none!important}</style><p class="archive-noscript">当前展示全部笔记。时间目录和文章链接可直接使用；分类与系列也可从下方文章进入。</p></noscript>
    <details class="archive-tools"><summary>筛选与视图 <span aria-hidden="true">＋</span></summary><div class="archive-controls" data-archive-controls>
      <div class="filter-field"><label for="archive-category">研究方向</label><select id="archive-category" data-archive-category disabled><option value="">全部方向</option>{categories.map(category => <option value={category}>{category}</option>)}</select></div>
      <div class="filter-field"><label for="archive-series">系列路径</label><select id="archive-series" data-archive-series disabled><option value="">全部系列</option>{series.map(name => <option value={name}>{name}</option>)}</select></div>
      <fieldset class="density-switch"><legend>阅读密度</legend><button id="archive-editorial" type="button" data-density="editorial" disabled aria-pressed="true">摘要</button><button id="archive-compact" type="button" data-density="compact" disabled aria-pressed="false">索引</button></fieldset>
      <button type="button" class="archive-reset" data-archive-reset disabled>重置筛选 <span aria-hidden="true">↺</span></button>
    </div></details>
    <div class="archive-ledger-head"><nav class="archive-years" aria-label="年度目录">{dossiers.map(dossier => <a href={`#year-${dossier.year}`} data-year-link={dossier.year}>{dossier.year}<span>{dossier.posts.length}</span></a>)}</nav><p class="archive-status" role="status" aria-live="polite"><b data-archive-count>{posts.length}</b> / {posts.length} 篇笔记</p></div>
    <div class="archive-layout">
      <div class="dossier-stack">
        {dossiers.map(dossier => <section class="year-dossier" id={`year-${dossier.year}`} data-archive-year={dossier.year}>
          <header class="year-head"><h2>{dossier.year}</h2><span><span data-year-count>{dossier.posts.length}</span> 篇笔记</span></header>
          {dossier.months.map(month => <section class="month-group" id={`month-${dossier.year}-${String(month.month).padStart(2,'0')}`} data-archive-month={`${dossier.year}-${month.month}`}>
            <header class="month-head"><h3>{String(month.month).padStart(2,'0')} <span>月</span></h3><span data-month-count>{month.posts.length} 篇</span></header>
            <ol class="entry-list">{month.posts.map(post => <li data-archive-item data-post-id={post.id} data-category={post.data.category} data-series={post.data.series ?? ''} data-cover={coverSvgUrl(post)} data-title={post.data.title} data-description={post.data.description} data-href={postUrl(post)} data-meta={`${post.data.category} / ${formatDate(post.data.pubDate)} / ${readingStats(post.body ?? '').minutes} 分钟阅读`}>
              <article class="archive-entry" data-reading-preview style={`--note-color:${noteAccent(post.data)}`}>
                <time class="entry-date" datetime={post.data.pubDate.toISOString()}>{String(post.data.pubDate.getDate()).padStart(2,'0')}<span>{String(month.month).padStart(2,'0')}/{dossier.year}</span></time>
                <div class="entry-copy"><h4><a class="entry-title-link" href={postUrl(post)}>{post.data.title}<span aria-hidden="true">↗</span></a></h4><p>{post.data.description}</p><div class="entry-meta"><a href={categoryUrl(post.data.category)}>{post.data.category}</a>{post.data.series && <a href={seriesUrl(post.data.series)}>{post.data.series}</a>}<span>{readingStats(post.body ?? '').minutes} 分钟阅读</span></div></div>
              </article>
            </li>)}</ol>
          </section>)}
        </section>)}
        <div class="archive-empty" data-archive-empty hidden><h2>这条路径还没有笔记。</h2><p>试试其他方向或系列，也可以重置筛选。</p><button type="button" data-archive-reset>重置筛选</button></div>
        {posts.length === 0 && <p class="archive-noscript">第一篇笔记，正在路上。</p>}
      </div>
      {latest && <aside class="archive-inspector" data-archive-preview aria-label="当前笔记预览">
        <p class="inspector-kicker">A CLOSER LOOK</p>
        <a class="inspector-cover" href={postUrl(latest)} data-preview-link tabindex="-1" aria-hidden="true"><img src={coverSvgUrl(latest)} width="1200" height="630" alt="" data-preview-image decoding="async" /></a>
        <p class="inspector-fallback" data-preview-fallback hidden>封面暂未载入，文章仍可阅读。</p>
        <p class="inspector-meta" data-preview-meta>{latest.data.category} / {formatDate(latest.data.pubDate)} / {readingStats(latest.body ?? '').minutes} 分钟阅读</p>
        <h2 data-preview-title>{latest.data.title}</h2><p class="inspector-desc" data-preview-description>{latest.data.description}</p>
        <a class="inspector-read" href={postUrl(latest)} data-preview-link>阅读这篇笔记 <span aria-hidden="true">↗</span></a>
        <p class="inspector-hint">沿着标题，看看里面。</p>
      </aside>}
    </div>
  </section>
</Base>
<script>
  import '../scripts/archive-index'
</script>
