---
import KnowledgeMap from '../components/KnowledgeMap.astro'
import Base from '../layouts/Base.astro'
import { getKnowledgeMap } from '../lib/knowledgeMap'
import '../styles/map-open.css'
const map = await getKnowledgeMap()
const description = `浏览 ${map.stats.posts} 篇技术笔记与分类、系列、标签之间的知识关系。`
---
<Base title="交互知识图谱" description={description} width="wide" bodyClass="atlas-mode map-open">
  <header class="connections-head">
    <div class="connections-intro"><h1 id="knowledge-map-title" lang="en">Knowledge map</h1><p>从分类、系列和标签进入笔记。<span>{map.stats.posts} 篇笔记 · {map.stats.relations} 条关联</span></p></div>
  </header>
  <KnowledgeMap data={map} />
</Base>
