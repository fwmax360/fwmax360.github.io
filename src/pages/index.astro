---
import Base from '../layouts/Base.astro'
import HomeEditorial from '../components/HomeEditorial.astro'
import HomeFeatured from '../components/HomeFeatured.astro'
import PostRow from '../components/PostRow.astro'
import BinaryXray from '../components/BinaryXray.astro'
import { SITE } from '../consts'
import {
  categoryUrl,
  formatDate,
  getCategories,
  getPosts,
  getPostsByDateDesc,
  getTags,
  readingStats,
  tagUrl,
} from '../lib/posts'
import { getSeriesSummaries, seriesUrl } from '../lib/series'

const posts = await getPosts()
const timeline = await getPostsByDateDesc()
const featured = timeline[0]
/** Featured 之后继续展示最近内容，总量受站点配置控制。 */
const recent = timeline.slice(1, SITE.postsPerPage)
const tags = await getTags()
const categories = await getCategories()
const series = await getSeriesSummaries()
const startSeries = series.find((item) => item.name === '逆向基础') ?? series[0]
const deepPost = posts
  .filter((post) => post.id !== featured?.id)
  .sort((a, b) => readingStats(b.body ?? '').words - readingStats(a.body ?? '').words)[0]

---

<Base title={SITE.title} description={SITE.description}>
  <h1 class="sr-only">{SITE.title} — {SITE.subtitle}</h1>

  {featured && (
    <BinaryXray
      counts={{
        entries: posts.length,
        tracks: categories.length,
        series: series.length,
        signals: tags.length,
      }}
      latest={{
        title: featured.data.title,
        href: `/posts/${featured.id}/`,
        label: featured.data.series ?? featured.data.category,
        date: featured.data.pubDate,
      }}
      series={series.map((item) => ({
        name: item.name,
        count: item.count,
        href: seriesUrl(item.name),
      }))}
      class="home-specimen col-side"
    />
  )}

  {featured ? (
    <HomeFeatured post={featured} />
  ) : (
    <p class="empty mono">还没有文章。在 <code>src/content/posts/</code> 里新建 .md 文件即可。</p>
  )}

  <HomeEditorial
    start={startSeries}
    deep={deepPost}
    postsCount={posts.length}
    pathsCount={series.length}
    tagsCount={tags.length}
  />

  <div class="dashboard">
    <section class="feed" aria-labelledby="latest-heading" data-reveal="section" data-parallax="0.03">
      <header class="section-head">
        <div class="section-copy">
          <span class="section-code mono">QUEUE / 0x01</span>
          <h2 id="latest-heading">Latest field notes</h2>
          <p>按发布时间排列的分析记录、工具链与底层机制。</p>
        </div>
        <div class="section-status mono">
          <span>{String(recent.length).padStart(2, '0')} loaded</span>
          <a href="/archive">full archive ↗</a>
        </div>
      </header>

      <div class="feed-list">
        {recent.map((post, index) => <PostRow post={post} index={index + 1} variant="compact" />)}
      </div>

      {recent.length > 0 && (
        <a href="/archive" class="feed-more mono">
          <span>browse all {posts.length} entries</span>
          <span aria-hidden="true">[ enter ]</span>
        </a>
      )}
    </section>

    <aside class="discovery col-side" aria-label="内容发现" data-reveal="section" data-spotlight data-parallax="0.05">
      <header class="discovery-head mono">
        <span>INDEX / DISCOVER</span>
        <i aria-hidden="true"></i>
      </header>

      <section class="rail-panel categories" aria-labelledby="categories-heading">
        <header class="panel-head mono">
          <h2 id="categories-heading">// channels</h2>
          <span>{String(categories.length).padStart(2, '0')}</span>
        </header>
        {categories.length > 0 ? (
          <ul class="category-list">
            {categories.map((category, index) => (
              <li>
                <a
                  href={categoryUrl(category.name)}
                  class="category-item"
                  style={`--share:${posts.length ? (category.count / posts.length) * 100 : 0}%`}
                >
                  <span class="category-id mono">{String(index + 1).padStart(2, '0')}</span>
                  <span class="category-name">{category.name}</span>
                  <span class="category-count mono">{category.count}</span>
                  <i aria-hidden="true"></i>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="side-empty mono">暂无分类</p>
        )}
      </section>

      <section class="rail-panel" aria-labelledby="series-heading">
        <header class="panel-head mono">
          <h2 id="series-heading">// series routes</h2>
          <span>{String(series.length).padStart(2, '0')}</span>
        </header>
        {series.length > 0 ? (
          <ol class="series-list">
            {series.slice(0, 5).map((item, index) => (
              <li>
                <a href={seriesUrl(item.name)} class="series-item" aria-label={`进入系列 ${item.name}`}>
                  <span class="series-id mono">0{index + 1}</span>
                  <span class="series-copy">
                    <strong>{item.name}</strong>
                    <small>{item.posts.at(-1)?.data.title}</small>
                  </span>
                  <span class="series-count mono">×{item.count}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="side-empty mono">系列文章正在整理</p>
        )}
      </section>

      <section class="rail-panel" aria-labelledby="tags-heading">
        <header class="panel-head mono">
          <h2 id="tags-heading">// signal tags</h2>
          <a href="/tags">all ↗</a>
        </header>
        {tags.length > 0 ? (
          <div class="tag-cloud mono">
            {tags.slice(0, 14).map((tag) => (
              <a href={tagUrl(tag.name)}>
                #{tag.name}<span>{tag.count}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="side-empty mono">暂无标签</p>
        )}
      </section>

      {featured && (
        <p class="rail-sync mono">
          last indexed <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
        </p>
      )}
    </aside>
  </div>
</Base>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 2.5rem;
    align-items: start;
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line-bright);
  }

  .section-copy {
    min-width: 0;
  }

  .section-code {
    color: var(--color-accent);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .section-copy h2 {
    margin-top: 0.2rem;
    color: var(--color-text-strong);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .section-copy p {
    margin-top: 0.2rem;
    color: var(--color-faint);
    font-size: 0.78rem;
  }

  .section-status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: 0 0 auto;
    gap: 0.2rem;
    font-size: 0.67rem;
  }

  .section-status span {
    color: var(--color-faint);
  }

  .section-status a,
  .panel-head a {
    color: var(--color-dim);
    text-decoration: none;
    transition: color 0.16s;
  }

  .section-status a:hover,
  .panel-head a:hover {
    color: var(--color-accent);
  }

  .feed-list {
    border-bottom: 1px solid var(--color-line);
  }

  .feed-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    margin-top: 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-line);
    color: var(--color-dim);
    font-size: 0.72rem;
    text-decoration: none;
    transition:
      color 0.18s,
      border-color 0.18s,
      background 0.18s;
  }

  .feed-more:hover {
    border-color: var(--color-accent-soft);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    color: var(--color-accent);
  }

  .discovery {
    position: sticky;
    top: calc(var(--nav-offset, var(--nav-h)) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .discovery-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-faint);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .discovery-head i {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-line-bright), transparent);
  }

  :global(html[data-motion='ready']) .discovery-head i {
    background-size: 200% 100%;
    background-image: linear-gradient(90deg, var(--color-line-bright), var(--color-accent-soft), transparent);
    animation: discovery-signal 4.5s linear infinite;
  }

  @keyframes discovery-signal { to { background-position: -200% 0; } }

  .rail-panel {
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-soft) 84%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.45rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-faint);
    font-size: 0.65rem;
  }

  .panel-head h2 {
    color: var(--color-dim);
    font: inherit;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-list,
  .series-list {
    list-style: none;
  }

  .category-item {
    --share: 0%;
    position: relative;
    display: grid;
    grid-template-columns: 1.7rem 1fr auto;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.85rem;
    padding: 0.55rem 0.75rem;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition:
      color 0.16s,
      background 0.16s;
  }

  .category-list li:last-child .category-item {
    border-bottom: 0;
  }

  .category-item:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    color: var(--color-text-strong);
  }

  .category-id,
  .category-count {
    color: var(--color-faint);
    font-size: 0.65rem;
  }

  .category-name {
    font-size: 0.84rem;
  }

  .category-item i {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: var(--share);
    height: 1px;
    background: color-mix(in srgb, var(--color-accent) 70%, transparent);
    transition: width 0.25s var(--ease-out-expo);
  }

  .series-item {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.75rem;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition:
      color 0.16s,
      background 0.16s;
  }

  .series-list li:last-child .series-item {
    border-bottom: 0;
  }

  .series-item:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .series-id,
  .series-count {
    color: var(--color-faint);
    font-size: 0.62rem;
  }

  .series-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .series-copy strong {
    overflow: hidden;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 520;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-copy small {
    overflow: hidden;
    color: var(--color-faint);
    font-size: 0.64rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-item:hover strong {
    color: var(--color-accent);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    padding: 0.75rem;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    min-height: 1.8rem;
    padding: 0.23rem 0.42rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    color: var(--color-dim);
    font-size: 0.68rem;
    text-decoration: none;
    transition:
      color 0.16s,
      border-color 0.16s,
      background 0.16s;
  }

  .tag-cloud a:hover {
    border-color: var(--color-accent-soft);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    color: var(--color-accent);
  }

  .tag-cloud span {
    color: var(--color-faint);
    font-size: 0.56rem;
  }

  .rail-sync {
    padding-inline: 0.2rem;
    color: var(--color-faint);
    font-size: 0.6rem;
    text-align: right;
  }

  .rail-sync time {
    color: var(--color-dim);
  }

  .empty,
  .side-empty {
    color: var(--color-faint);
    font-size: 0.75rem;
  }

  .empty {
    margin-top: 1.5rem;
    padding: 3rem 1rem;
    border: 1px solid var(--color-line);
    text-align: center;
  }

  .empty code {
    color: var(--color-accent);
  }

  .side-empty {
    padding: 1rem 0.75rem;
  }

  @media (max-width: 960px) {
    .dashboard {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .discovery {
      position: static;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    .discovery-head,
    .rail-sync {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 961px) and (max-height: 900px) {
    .discovery {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .dashboard {
      margin-top: 2.5rem;
    }

    .section-head {
      align-items: flex-start;
    }

    .section-copy p {
      max-width: 16rem;
    }

    .section-status span {
      display: none;
    }

    .feed-more {
      min-height: 3.5rem;
    }

    .discovery {
      grid-template-columns: 1fr;
    }

    .discovery-head,
    .rail-sync {
      grid-column: auto;
    }

    .category-item,
    .series-item {
      min-height: 3rem;
    }

    .tag-cloud a {
      min-height: 2.35rem;
      align-items: center;
    }
  }

  @media (max-width: 420px) {
    .section-head {
      gap: 0.75rem;
    }

    .section-status {
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discovery-head i {
      animation: none !important;
      transform: none !important;
    }
  }

  :global(html[data-motion='off']) .discovery-head i {
    animation: none !important;
    transform: none !important;
  }
</style>
