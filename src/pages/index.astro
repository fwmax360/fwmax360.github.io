---
import Base from '../layouts/Base.astro'
import { noteAccent } from '../lib/note-accent'
import NoteHoverPreview from '../components/NoteHoverPreview.astro'
import { coverSvgUrl } from '../lib/covers'
import ResearchHero from '../components/ResearchHero.astro'
import HomeDetails from '../components/HomeDetails.astro'
import { SITE } from '../consts'
import { categoryUrl, formatDate, getCategories, getPostsByDateDesc, postUrl, readingStats } from '../lib/posts'
import { getSeriesSummaries, seriesUrl } from '../lib/series'
import '../styles/home.css'

const timeline = await getPostsByDateDesc()
const featured = timeline[0]
const featuredTitleParts = featured?.data.title.match(/^(.{4,40}?[：:])\s*(.+)$/)
const recent = timeline.slice(1)
const initialRecentCount = SITE.postsPerPage - 1
const categories = await getCategories()
const series = await getSeriesSummaries()
---

<Base title={SITE.title} description={SITE.description} width="wide" bodyClass="home-editorial">
  <div class="home" data-home-motion>
    <HomeDetails />
    <NoteHoverPreview />
    <ResearchHero count={timeline.length} />

    {featured ? (
      <>
      <section class="feature-section" aria-labelledby="featured-heading" data-hero-enter data-reading-preview>
        <div class="section-head"><h2 id="featured-heading">最新笔记</h2></div>
        <article class="featured">
          <div class="feature-copy">
            <div class="meta"><a href={categoryUrl(featured.data.category)}>{featured.data.category}</a><span aria-hidden="true">·</span><time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time></div>
            <h3><a href={postUrl(featured)}>{featuredTitleParts ? <><span class="feature-title-context">{featuredTitleParts[1]}</span><span class="feature-title-main">{featuredTitleParts[2]}</span></> : featured.data.title}</a></h3>
            <p class="feature-desc">{featured.data.description}</p>
            <a class="read-link" href={postUrl(featured)}>阅读全文 <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </section>

      </>
    ) : <p class="empty">第一篇笔记，正在路上。</p>}


    <section class="research-paths" aria-labelledby="paths-heading">
      <header class="section-head"><div><h2 id="paths-heading">研究方向</h2></div><a href="/map/">打开图谱 <span aria-hidden="true">↗</span></a></header>
      <div class="path-grid" style={`--path-columns: ${Math.min(4, categories.length)}`}>{categories.map((category) => <a class="research-path" href={categoryUrl(category.name)}><h3>{category.name}</h3><span class="path-count">{category.count} 篇笔记</span><span class="path-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>

    <div class="reading-grid" id="notes">
      {recent.length > 0 && <section class="list" aria-labelledby="recent-heading">
        <header class="section-head"><div><h2 id="recent-heading">笔记</h2></div><a href="/archive">全部文章 <span aria-hidden="true">↗</span></a></header>
        <ol id="recent-posts">{recent.map((post, index) => <li data-extra-post={index >= initialRecentCount ? true : undefined} hidden={index >= initialRecentCount}><article data-reading-preview data-note-hover data-note-cover={coverSvgUrl(post)} data-note-color={noteAccent(post.data)} style={`--note-color:${noteAccent(post.data)}`}>
          <div class="meta"><a href={categoryUrl(post.data.category)}>{post.data.category}</a><span aria-hidden="true">·</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
          <h3><a href={postUrl(post)}>{post.data.title}<span class="note-arrow" aria-hidden="true">↗</span></a></h3>
          <p class="row-desc">{post.data.description}</p>
          <a class="row-read" href={postUrl(post)} aria-label={`${readingStats(post.body ?? '').minutes} 分钟阅读：${post.data.title}`}>{readingStats(post.body ?? '').minutes} 分钟阅读 <span aria-hidden="true">↗</span></a>
        </article></li>)}</ol>
        {recent.length > initialRecentCount && <div class="more-notes"><button type="button" class="more-posts" data-more-posts hidden aria-controls="recent-posts" aria-describedby="more-notes-hint"><span data-more-label>展开更多笔记</span><span class="more-arrow" data-more-icon aria-hidden="true">↓</span></button><a class="more-fallback" data-more-fallback href="/archive/">浏览全部 {timeline.length} 篇笔记 <span aria-hidden="true">↗</span></a><p id="more-notes-hint" hidden>点击或向下轻拉，继续阅读。</p><p class="details-status" data-notes-status role="status" aria-live="polite"></p></div>}
      </section>}

    </div>
    {series.length > 0 && <section class="series-shelf" aria-labelledby="series-heading"><header class="section-head"><div><h2 id="series-heading">系列</h2></div><a href="/series/">全部系列 <span aria-hidden="true">↗</span></a></header><div class="series-grid">{series.map(item => <a href={seriesUrl(item.name)}><span class="series-count">{String(item.count).padStart(2, '0')} 篇</span><h3>{item.name}</h3><p>{item.categories.join(' / ')}</p><span class="series-arrow" aria-hidden="true">↗</span></a>)}</div></section>}
  </div>
</Base>
