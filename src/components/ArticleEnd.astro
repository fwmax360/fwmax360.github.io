---
import { categoryUrl, postUrl, tagUrl, type Post } from '../lib/posts'

interface EndLink {
  label?: string
  href: string
  title: string
  meta?: string
}

interface Source {
  href: string
  label: string
  host: string
}

interface Props {
  previous: EndLink | null
  next: EndLink | null
  related: Post[]
  tags: string[]
  category: string
  sources: Source[]
}

const { previous, next, related, tags, category, sources } = Astro.props
---

<div class="end">
  {
    (previous || next) && (
      <nav class="jump" aria-label="相邻文章">
        {previous && (
          <a href={previous.href}>
            <span>{previous.label ?? '上一篇'}</span>
            <strong>{previous.title}</strong>
          </a>
        )}
        {next && (
          <a href={next.href}>
            <span>{next.label ?? '下一篇'}</span>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    )
  }

  {
    related.length > 0 && (
      <section aria-labelledby="related-heading">
        <h2 id="related-heading">相关文章</h2>
        <ul>
          {related.map((post) => (
            <li>
              <a href={postUrl(post)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="tags">
    <a href={categoryUrl(category)}>{category}</a>
    {tags.map((tag) => (
      <a href={tagUrl(tag)}>#{tag}</a>
    ))}
  </p>

  {
    sources.length > 0 && (
      <section aria-labelledby="sources-heading">
        <h2 id="sources-heading">文中链接</h2>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .end {
    display: grid;
    gap: 3rem;
    margin-top: 5rem;
  }

  .jump {
    display: grid;
    gap: 1.5rem;
  }

  .jump a {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  .jump span,
  h2 {
    color: var(--color-faint);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .jump strong,
  .end li a {
    color: var(--color-text-strong);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.35;
    text-decoration: none;
  }

  .jump a:hover strong,
  .end li a:hover,
  .tags a:hover {
    color: var(--color-accent);
  }

  ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.7rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .tags a {
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 734px) {
    .jump {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
