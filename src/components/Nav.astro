---
import { NAV, SITE } from '../consts'

const path = Astro.url.pathname
const isActive = (href: string) => {
  if (href === '/') return path === '/'
  // 单篇文章归属 posts 那一栏
  if (href === '/archive') return path.startsWith('/archive') || path.startsWith('/posts')
  return path.startsWith(href)
}
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="回到首页">
      <span class="brand-sigil" aria-hidden="true">$</span>
      <span class="brand-name">{SITE.title}</span>
      <span class="brand-caret" aria-hidden="true"></span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button type="button" class="search-trigger" data-search-open aria-label="搜索文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd>/</kbd>
      </button>

      <button type="button" class="menu-toggle" data-menu-toggle aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" data-mobile-menu hidden>
    {
      NAV.map((item) => (
        <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
          <span class="mono text-faint">./</span>
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--color-line);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: var(--color-bg);
    }
  }

  .nav-inner {
    height: var(--nav-h);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: 1.25rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-strong);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand-sigil {
    color: var(--color-accent);
  }

  .brand-caret {
    width: 0.5rem;
    height: 1rem;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .brand:hover .brand-caret {
    opacity: 1;
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    margin-right: auto;
  }

  .nav-link {
    position: relative;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--color-dim);
    text-decoration: none;
    transition:
      color 0.18s,
      background 0.18s;
  }

  .nav-link:hover {
    color: var(--color-text-strong);
    background: var(--color-surface);
  }

  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: -0.35rem;
    height: 1px;
    background: var(--color-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem 0.3rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-faint);
    cursor: pointer;
    transition:
      border-color 0.18s,
      color 0.18s;
  }

  .search-trigger:hover {
    border-color: var(--color-line-bright);
    color: var(--color-text);
  }

  .search-trigger svg {
    width: 15px;
    height: 15px;
    stroke-linecap: round;
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius-sm);
    color: var(--color-faint);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0 6px;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.25s var(--ease-out-expo);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1rem;
    border-top: 1px solid var(--color-line);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    padding: 0.6rem 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-link.active {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
    .nav-inner {
      gap: 1rem;
    }
    .brand {
      margin-right: auto;
    }
    .menu-toggle {
      display: flex;
    }
    .mobile-menu:not([hidden]) {
      display: flex;
    }
    .search-trigger kbd {
      display: none;
    }
  }
</style>

<script>
  let ac: AbortController | null = null

  function setupMenu() {
    ac?.abort()
    ac = new AbortController()

    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
    if (!toggle || !menu) return

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
      menu.hidden = !open
    }

    // 客户端跳转不会重置这段状态，新页面会残留上一页的展开态
    setOpen(false)

    toggle.addEventListener(
      'click',
      () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
      { signal: ac.signal },
    )
  }

  setupMenu()
  document.addEventListener('astro:after-swap', setupMenu)
</script>
