---
import { NAV, SITE } from '../consts'

const path = Astro.url.pathname
const isActive = (href: string) => {
  if (href === '/') return path === '/'
  // 单篇文章归属 posts 那一栏
  if (href === '/archive') return path.startsWith('/archive') || path.startsWith('/posts')
  return path.startsWith(href)
}
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${SITE.title}，回到首页`}>{SITE.title}</a>

    <nav class="nav-links" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button type="button" class="search-trigger" data-search-open hidden aria-label="搜索文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd>/</kbd>
      </button>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        hidden
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span>
      </button>
      <details class="nav-fallback" data-nav-fallback>
        <summary>菜单</summary>
        <nav aria-label="无需脚本的移动导航">{NAV.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
      </details>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" data-mobile-menu aria-label="移动导航" hidden>
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={['mobile-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .menu-toggle[hidden],.nav-fallback[hidden] { display:none!important; }
  .nav-fallback { display:none; }
  .nav-fallback summary { cursor:pointer; min-height:44px; display:flex; align-items:center; padding-inline:8px; color:var(--color-text); font-size:14px; list-style:none; }
  .nav-fallback summary::-webkit-details-marker { display:none; }
  .nav-fallback nav { position:absolute; top:100%; left:0; right:0; padding:16px; background:var(--color-bg); border-bottom:1px solid var(--color-line); display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 24px; }
  .nav-fallback nav a { display:flex; align-items:center; min-height:44px; color:var(--color-text); text-decoration:none; }
  .nav-fallback nav a[aria-current] { color:var(--color-accent); }
  .nav-fallback :is(summary,a):focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  @media(max-width:720px) { .nav-fallback { display:block; } }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-panel-strong) 88%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(135%);
    backdrop-filter: blur(20px) saturate(135%);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 8px 32px -28px rgb(0 0 0 / 90%);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: var(--color-bg);
    }
  }

  .nav-inner {
    height: var(--nav-h);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    margin-right: auto;
  }

  .nav-link {
    position: relative;
    padding: 0.55rem 0.72rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--color-dim);
    text-decoration: none;
    transition:
      color 0.18s,
      background 0.18s;
  }

  .nav-link:hover {
    color: var(--color-text-strong);
    background: var(--color-surface);
  }

  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: -0.78rem;
    height: 2px;
    background: var(--color-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.55rem 0.35rem 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-bg-soft);
    color: var(--color-faint);
    cursor: pointer;
    transition:
      border-color 0.18s,
      color 0.18s;
  }

  .search-trigger:hover {
    border-color: var(--color-line-bright);
    color: var(--color-text);
  }

  .search-trigger svg {
    width: 15px;
    height: 15px;
    stroke-linecap: round;
  }

  .search-trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius-sm);
    color: var(--color-faint);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0 6px;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.25s var(--ease-out-expo);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 0.65rem 1.25rem 1.1rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-panel-strong);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: 0 22px 50px -32px rgb(0 0 0 / 95%);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    padding: 0.6rem 0;
    font-size: 1rem;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-link.active {
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
    .nav-inner {
      gap: 8px;
      padding-inline: 1rem;
    }
    .brand {
      margin-right: auto;
    }
    .menu-toggle {
      display: flex;
    }
    .mobile-menu:not([hidden]) {
      display: flex;
    }
    .search-trigger kbd {
      display: none;
    }
    .nav-actions { gap: 8px; flex-shrink: 0; }
    .search-trigger { width: 44px; min-width: 44px; min-height: 44px; padding: 0; justify-content: center; }
  }
</style>

<script>
  let ac: AbortController | null = null

  function setupMenu() {
    ac?.abort()
    ac = new AbortController()
    const { signal } = ac

    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
    if (!toggle || !menu) return

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
      menu.hidden = !open
    }

    // 客户端跳转不会重置这段状态，新页面会残留上一页的展开态
    setOpen(false)
    toggle.hidden = false
    const fallback = document.querySelector<HTMLElement>('[data-nav-fallback]')
    if (fallback) fallback.hidden = true

    toggle.addEventListener(
      'click',
      () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
      { signal },
    )

    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => setOpen(false), { signal }))

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setOpen(false)
          toggle.focus()
        }
      },
      { signal },
    )

    document.addEventListener(
      'click',
      (event) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return
        if (!(event.target instanceof Node) || toggle.contains(event.target) || menu.contains(event.target)) return
        setOpen(false)
      },
      { signal },
    )
  }

  setupMenu()
  document.addEventListener('astro:after-swap', setupMenu)
</script>
