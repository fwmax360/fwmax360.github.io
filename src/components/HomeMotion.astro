<!-- A one-time assembly, then silence. Hover/drag still use the shared toggle. -->
<script>
  let dispose: (() => void) | undefined
  let activeRoot: HTMLElement | null = null

  function setupHomeMotion() {
    const root = document.querySelector<HTMLElement>('[data-home-motion]')
    // Initial script execution and Astro's page-load can target the same DOM.
    // Keep the running entrance rather than cancelling/replaying it.
    if (root && root === activeRoot) return
    dispose?.()
    const art = root?.querySelector<HTMLElement>('.feature-art')
    const toggle = root?.querySelector<HTMLButtonElement>('[data-home-motion-toggle]')
    const label = toggle?.querySelector<HTMLElement>('[data-motion-label]')
    if (!root || !art || !toggle || !label) return
    activeRoot = root

    const controller = new AbortController()
    const { signal } = controller
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    let paused = root.dataset.homePaused === 'true'
    const animations: Animation[] = []
    const stopEntrance = () => animations.splice(0).forEach(animation => animation.cancel())

    const enter = () => {
      if (root.dataset.heroEntered === 'true') return
      root.dataset.heroEntered = 'true'
      if (typeof art.animate !== 'function' || document.hidden) return
      const easing = 'cubic-bezier(.16,1,.3,1)'
      // Each original SVG layer returns to its exact original geometry.
      const layers: [string, number, number][] = [
        ['.art-layer-bottom', 20, 0],
        ['.art-layer-middle', 12, 70],
        ['.art-layer-top', -24, 140],
        ['.art-layer-core', -34, 190],
      ]
      layers.forEach(([selector, offset, delay]) => {
        const element = art.querySelector<SVGElement>(selector)
        if (element) animations.push(element.animate([
          { opacity: .15, transform: `translateY(${offset}px)` },
          { opacity: 1, transform: 'translateY(0)' },
        ], { duration: 760, delay, easing, fill: 'backwards' }))
      })
      root.querySelectorAll<HTMLElement>('[data-hero-enter]').forEach((element, index) => {
        animations.push(element.animate([
          { opacity: .35, transform: 'translateY(10px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ], { duration: 620, delay: index * 90, easing, fill: 'backwards' }))
      })
    }

    const update = () => {
      const enabled = !reduced.matches && document.documentElement.dataset.motion === 'ready'
      root.dataset.homeMotion = enabled && !paused ? 'on' : 'off'
      root.dataset.homePaused = String(paused)
      toggle.hidden = !enabled
      toggle.setAttribute('aria-pressed', String(paused))
      const text = paused ? '启用插画交互动效' : '停用插画交互动效'
      toggle.setAttribute('aria-label', text)
      toggle.title = text
      label.textContent = text
      if (!enabled || paused || document.hidden) stopEntrance()
      else enter()
    }

    const capabilityObserver = new MutationObserver(update)
    capabilityObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] })
    toggle.addEventListener('click', () => { paused = !paused; update() }, { signal })
    document.addEventListener('visibilitychange', update, { signal })
    reduced.addEventListener('change', update, { signal })
    update()

    dispose = () => {
      activeRoot = null
      controller.abort()
      capabilityObserver.disconnect()
      stopEntrance()
    }
  }

  setupHomeMotion()
  document.addEventListener('astro:page-load', setupHomeMotion)
  document.addEventListener('astro:before-swap', () => dispose?.())
</script>
