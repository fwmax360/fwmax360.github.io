---
// 全文搜索。索引由 Pagefind 在 build 之后扫描 dist/ 生成，纯静态、无后端。
---

<dialog class="search" data-search aria-label="搜索文章">
  <div class="search-box">
    <div class="search-head">
      <span class="mono search-prompt" aria-hidden="true">/</span>
      <input
        type="search"
        class="search-input"
        data-search-input
        placeholder="搜索文章内容…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-expanded="false"
      />
      <button type="button" class="search-action search-clear" data-search-clear aria-label="清空搜索" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 8h12M9 8V5h6v3m-8 0 1 11h8l1-11M10 11v5m4-5v5"></path>
        </svg>
      </button>
      <kbd class="search-esc">esc</kbd>
      <button type="button" class="search-action search-close" data-search-close aria-label="关闭搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <p class="sr-only" data-search-status aria-live="polite"></p>
    <div class="search-body" id="search-results" data-search-results role="listbox" aria-label="搜索结果">
      <p class="search-hint">输入关键词开始搜索，支持正文全文匹配。</p>
    </div>

    <div class="search-foot mono">
      <span class="search-shortcut"><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span class="search-shortcut"><kbd>↵</kbd> 打开</span>
      <span class="search-brand">pagefind</span>
    </div>
  </div>
</dialog>

<style>
  .search {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .search::backdrop {
    background: color-mix(in srgb, #030507 78%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(0.8);
    backdrop-filter: blur(8px) saturate(0.8);
  }

  .search[open] .search-box {
    animation: pop 0.22s var(--ease-out-expo);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search[open] .search-box {
      animation: none;
    }
  }

  .search-box {
    width: min(42rem, calc(100vw - 2rem - env(safe-area-inset-left, 0px) - env(safe-area-inset-right, 0px)));
    margin: max(12vh, calc(env(safe-area-inset-top, 0px) + 4.5rem)) auto 0;
    background: var(--color-panel-strong);
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 2%),
      0 32px 100px -38px rgb(0 0 0 / 96%),
      var(--shadow-accent);
    overflow: hidden;
    /* iOS Safari dialog 里用 max-height 防止被键盘顶出视口 */
    max-height: min(85vh, 85dvh);
    display: flex;
    flex-direction: column;
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: linear-gradient(180deg, rgb(255 255 255 / 2.5%), transparent);
  }

  .search-prompt {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: var(--color-text-strong);
    /* ≥16px，避免 iOS 聚焦时整页缩放 */
    font-size: 1rem;
    font-family: var(--font-sans);
    /* iOS 去默认外观 */
    -webkit-appearance: none;
    appearance: none;
    border-radius: 0;
  }

  .search-input::placeholder {
    color: var(--color-faint);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-esc,
  .search-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius-sm);
    color: var(--color-faint);
  }

  .search-action {
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-faint);
    cursor: pointer;
    transition:
      color 0.16s,
      border-color 0.16s,
      background 0.16s;
  }

  .search-action[hidden] {
    display: none;
  }

  .search-action:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-soft);
    background: var(--color-surface-2);
  }

  .search-action svg {
    width: 16px;
    height: 16px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .search-body {
    flex: 1;
    min-height: 0;
    max-height: min(26rem, 50dvh);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem;
  }

  .search-hint,
  .search-empty {
    padding: 1.5rem 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-faint);
  }

  .search-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--color-line);
    background: rgb(5 7 10 / 64%);
    font-size: 0.7rem;
    color: var(--color-faint);
  }

  .search-foot kbd {
    margin-right: 0.15rem;
  }

  .search-brand {
    margin-left: auto;
    opacity: 0.5;
  }

  @media (max-width: 640px), (pointer: coarse) {
    .search-box {
      margin-top: max(6vh, calc(env(safe-area-inset-top, 0px) + 4rem));
    }

    .search-head {
      gap: 0.45rem;
      padding-inline: 0.75rem;
    }

    .search-esc,
    .search-shortcut {
      display: none;
    }

    .search-action {
      width: 40px;
      height: 40px;
    }
  }
</style>

<style is:global>
  .search-item {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 0.16s,
      border-color 0.16s,
      transform 0.16s var(--ease-out-expo);
  }

  .search-item:hover,
  .search-item[data-active='true'] {
    background: linear-gradient(90deg, rgb(61 220 132 / 6%), rgb(255 255 255 / 2%));
    border-color: var(--color-line-bright);
    transform: translateX(2px);
  }

  .search-item-title {
    display: block;
    color: var(--color-text-strong);
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .search-item[data-active='true'] .search-item-title {
    color: var(--color-accent);
  }

  .search-item[aria-selected='true'] {
    outline: 1px solid var(--color-accent-soft);
    outline-offset: -1px;
  }

  .search-item-excerpt {
    display: block;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--color-dim);
  }

  .search-item-excerpt mark {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-accent);
    border-radius: 2px;
    padding: 0 0.1em;
  }
</style>

<script>
  type PagefindResult = {
    id: string
    data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }>
  }
  type Pagefind = {
    debouncedSearch: (q: string, opts?: unknown, ms?: number) => Promise<{ results: PagefindResult[] } | null>
    init?: () => Promise<void>
  }

  let pagefind: Pagefind | null = null
  let loading: Promise<void> | null = null

  // 索引只在 build 产物里存在，dev 下没有。这里用 new Function 构造 import，
  // 完全绕开 Vite 的静态分析——它会把 import() 包进 preload 辅助函数，
  // 而内联脚本这条路径上 __VITE_PRELOAD__ 占位符不会被替换，运行时直接报错。
  const pagefindPath = '/pagefind/pagefind.js'

  async function loadPagefind() {
    if (pagefind) return
    if (loading) return loading
    loading = (async () => {
      try {
        pagefind = await import(/* @vite-ignore */ pagefindPath) as Pagefind
        await pagefind.init?.()
      } catch {
        pagefind = null
      }
    })()
    try {
      await loading
    } finally {
      loading = null
    }
  }

  // document 不随 View Transitions 替换，重新 setup 前必须撤掉上一轮的监听
  let ac: AbortController | null = null

  function setup() {
    ac?.abort()
    ac = new AbortController()
    const { signal } = ac

    const dialog = document.querySelector<HTMLDialogElement>('dialog[data-search]')
    const input = document.querySelector<HTMLInputElement>('[data-search-input]')
    const list = document.querySelector<HTMLElement>('[data-search-results]')
    const status = document.querySelector<HTMLElement>('[data-search-status]')
    const clearButton = document.querySelector<HTMLButtonElement>('[data-search-clear]')
    const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]')
    if (!dialog || !input || !list || !status || !clearButton || !closeButton) return

    // 弹窗开着时发生客户端跳转，close 事件不会触发，滚动会被永久锁住
    if (!dialog.open) document.body.style.overflow = ''

    let cursor = -1
    let requestId = 0

    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('.search-item')]

    const announce = (message: string) => {
      status.textContent = message
    }

    const setActive = (next: number) => {
      const all = items()
      cursor = next
      all.forEach((el, i) => {
        const active = i === cursor
        el.setAttribute('data-active', String(active))
        el.setAttribute('aria-selected', String(active))
      })
      const active = all[cursor]
      if (active?.id) input.setAttribute('aria-activedescendant', active.id)
      else input.removeAttribute('aria-activedescendant')
      active?.scrollIntoView({ block: 'nearest' })
    }

    const move = (delta: number) => {
      const all = items()
      if (!all.length) return
      if (cursor === -1) {
        setActive(delta > 0 ? 0 : all.length - 1)
        return
      }
      setActive((cursor + delta + all.length) % all.length)
    }

    const open = () => {
      if (dialog.open) return
      dialog.showModal()
      document.body.style.overflow = 'hidden'
      input.setAttribute('aria-expanded', 'true')
      input.focus()
      void loadPagefind()
    }

    const close = () => {
      dialog.close()
      document.body.style.overflow = ''
      input.setAttribute('aria-expanded', 'false')
    }

    const render = (html: string) => {
      list.innerHTML = html
      setActive(-1)
    }

    const run = async (query: string) => {
      const currentRequest = ++requestId
      clearButton.hidden = !query
      if (!query.trim()) {
        render('<p class="search-hint">输入关键词开始搜索，支持正文全文匹配。</p>')
        announce('等待输入搜索关键词')
        return
      }

      await loadPagefind()
      if (currentRequest !== requestId) return
      if (!pagefind) {
        render('<p class="search-empty">搜索索引尚未生成。执行 <code>npm run build</code> 后可用。</p>')
        announce('搜索索引加载失败')
        return
      }

      const search = await pagefind.debouncedSearch(query, undefined, 200)
      if (currentRequest !== requestId) return
      if (!search) return

      if (!search.results.length) {
        render(`<p class="search-empty">没有匹配 “${escapeHtml(query)}” 的内容。</p>`)
        announce('没有搜索结果')
        return
      }

      const top = await Promise.all(search.results.slice(0, 8).map((r) => r.data()))
      if (currentRequest !== requestId) return
      render(
        top
          .map(
            (d, i) => `<a class="search-item" id="search-result-${i}" role="option" aria-selected="false" href="${d.url}">
              <span class="search-item-title">${escapeHtml(d.meta.title ?? '未命名')}</span>
              <span class="search-item-excerpt">${d.excerpt}</span>
            </a>`,
          )
          .join(''),
      )
      announce(`找到 ${top.length} 条结果`)
    }

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)

    input.addEventListener('input', () => void run(input.value), { signal })
    clearButton.addEventListener(
      'click',
      () => {
        input.value = ''
        void run('')
        input.focus()
      },
      { signal },
    )
    closeButton.addEventListener('click', close, { signal })

    document
      .querySelectorAll('[data-search-open]')
      .forEach((btn) => btn.addEventListener('click', open, { signal }))

    dialog.addEventListener(
      'click',
      (e) => {
        if (e.target === dialog) close()
      },
      { signal },
    )

    dialog.addEventListener(
      'close',
      () => {
        document.body.style.overflow = ''
        input.setAttribute('aria-expanded', 'false')
        input.removeAttribute('aria-activedescendant')
      },
      { signal },
    )

    dialog.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault()
          move(1)
        } else if (e.key === 'ArrowUp') {
          e.preventDefault()
          move(-1)
        } else if (e.key === 'Enter' && cursor >= 0) {
          e.preventDefault()
          items()[cursor]?.click()
        }
      },
      { signal },
    )

    document.addEventListener(
      'keydown',
      (e) => {
        const tag = (e.target as HTMLElement)?.tagName
        const typing =
          tag === 'INPUT' || tag === 'TEXTAREA' || (e.target as HTMLElement)?.isContentEditable

        if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) {
          e.preventDefault()
          open()
        }
      },
      { signal },
    )
  }

  setup()
  document.addEventListener('astro:after-swap', setup)
</script>
