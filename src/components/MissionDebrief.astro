---
import { coverSvgUrl } from '../lib/covers'
import { categoryUrl, formatDate, postUrl, tagUrl, type Post } from '../lib/posts'

interface DebriefTarget {
  href: string
  label: string
  title: string
  meta?: string
  cover?: string
}

interface SourceLink {
  href: string
  label: string
  host: string
}

interface Props {
  mode: 'series' | 'timeline'
  previous?: DebriefTarget | null
  next?: DebriefTarget | null
  related: Post[]
  sources: SourceLink[]
  tags: string[]
  category: string
  words: number
  minutes: number
  headingsCount: number
  publishedAt: Date
  updatedAt?: Date
  series?: string
  chapter?: number
  seriesPosition?: number
  seriesTotal?: number
  accent?: string
}

const {
  mode,
  previous,
  next,
  related,
  sources,
  tags,
  category,
  words,
  minutes,
  headingsCount,
  publishedAt,
  updatedAt,
  series,
  chapter,
  seriesPosition,
  seriesTotal,
  accent,
} = Astro.props

const cards = related.slice(0, 3)
const routeCount = Number(Boolean(previous)) + Number(Boolean(next))
const lifecycle = updatedAt ? `revised ${formatDate(updatedAt)}` : `published ${formatDate(publishedAt)}`
const seriesState = series && seriesPosition && seriesTotal
  ? `CH ${String(chapter ?? seriesPosition).padStart(2, '0')} · ${seriesPosition}/${seriesTotal}`
  : null
const style = accent ? `--debrief-accent:${accent}` : undefined
---

<section
  class="mission-debrief"
  aria-labelledby="mission-debrief-title"
  style={style}
  data-pagefind-ignore
  data-reveal
  data-spotlight
>
  <span class="debrief-scan" aria-hidden="true"></span>
  <header class="debrief-head">
    <div>
      <p class="debrief-code mono">MISSION_DEBRIEF / END_OF_RECORD</p>
      <h2 id="mission-debrief-title">任务收束</h2>
    </div>
    <span class="completion mono"><i aria-hidden="true"></i>article complete</span>
  </header>

  <div class="completion-board" data-stagger data-reveal-stagger="45">
    <div class="completion-summary" data-reveal data-parallax="0.035">
      <span class="completion-seal" aria-hidden="true"><i></i></span>
      <p class="summary-kicker mono">completion_state</p>
      <p class="summary-value">阅读记录已抵达文末</p>
      <div class="summary-meta mono">
        <a href={categoryUrl(category)}>{category}</a>
        <span>{lifecycle}</span>
        {seriesState && <span>{seriesState}</span>}
      </div>
    </div>

    <dl class="completion-stats" aria-label="文章完成统计">
      <div data-reveal>
        <dt class="mono">words</dt>
        <dd data-count-up>{words}</dd>
      </div>
      <div data-reveal>
        <dt class="mono">minutes</dt>
        <dd data-count-up>{minutes}</dd>
      </div>
      <div data-reveal>
        <dt class="mono">sections</dt>
        <dd data-count-up>{headingsCount}</dd>
      </div>
      <div data-reveal>
        <dt class="mono">record</dt>
        <dd><span data-count-up>100</span>%</dd>
      </div>
    </dl>
  </div>

  {
    routeCount > 0 && (
      <nav class="route" aria-label={mode === 'series' ? '系列阅读路径' : '时间线阅读路径'}>
        <div class="section-label">
          <span class="mono">next_route</span>
          <small class="mono">{mode === 'series' ? series : 'chronological timeline'}</small>
        </div>
        <div class:list={['route-grid', { solo: routeCount === 1 }]} data-stagger data-reveal-stagger="55">
          {previous && (
            <a
              class="route-card previous"
              href={previous.href}
              data-reveal
              data-spotlight
              data-tilt="3"
              data-jmp
              data-jmp-source="RET / previous route"
              data-jmp-title={previous.title}
            >
              {previous.cover && (
                <img
                  src={previous.cover}
                  width="1200"
                  height="630"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  data-no-viewer
                  data-parallax="0.07"
                />
              )}
              <span class="route-shade" aria-hidden="true"></span>
              <span class="route-copy">
                <span class="route-label mono">← {previous.label}</span>
                <strong>{previous.title}</strong>
                {previous.meta && <span class="route-meta mono">{previous.meta}</span>}
              </span>
            </a>
          )}
          {next && (
            <a
              class="route-card next"
              href={next.href}
              data-reveal
              data-spotlight
              data-tilt="3"
              data-jmp
              data-jmp-source="STEP INTO / next route"
              data-jmp-title={next.title}
            >
              {next.cover && (
                <img
                  src={next.cover}
                  width="1200"
                  height="630"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  data-no-viewer
                  data-parallax="0.07"
                />
              )}
              <span class="route-shade" aria-hidden="true"></span>
              <span class="route-copy">
                <span class="route-label mono">{next.label} →</span>
                <strong>{next.title}</strong>
                {next.meta && <span class="route-meta mono">{next.meta}</span>}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }

  {
    cards.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="section-label">
          <h3 id="related-title" class="mono">related_signals</h3>
          <small class="mono">{String(cards.length).padStart(2, '0')} records</small>
        </div>
        <div class="related-grid" data-stagger data-reveal-stagger="55">
          {cards.map((item) => (
            <a
              class="related-card"
              href={postUrl(item)}
              data-reveal
              data-spotlight
              data-tilt="2.5"
              data-jmp
              data-jmp-source="related signal"
              data-jmp-title={item.data.title}
            >
              <span class="related-cover" aria-hidden="true">
                <img
                  src={coverSvgUrl(item)}
                  width="1200"
                  height="630"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  data-no-viewer
                  data-parallax="0.055"
                />
              </span>
              <span class="related-copy">
                <span class="related-meta mono">
                  <span>{item.data.category}</span>
                  <time datetime={item.data.pubDate.toISOString()}>{formatDate(item.data.pubDate)}</time>
                </span>
                <strong>{item.data.title}</strong>
                <span class="related-arrow mono" aria-hidden="true">open ↗</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-title">
        <div class="section-label">
          <h3 id="sources-title" class="mono">sources</h3>
          <small class="mono">external references · {String(sources.length).padStart(2, '0')}</small>
        </div>
        <ol class="source-list" data-stagger data-reveal-stagger="35">
          {sources.map((source, index) => (
            <li data-reveal>
              <span class="source-index mono">{String(index + 1).padStart(2, '0')}</span>
              <a href={source.href} target="_blank" rel="noopener noreferrer">
                <span>{source.label}</span>
                <small class="mono">{source.host} ↗</small>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <div class="debrief-tags">
    <span class="mono">signals</span>
    <div data-stagger data-reveal-stagger="30">
      {tags.map((tag) => <a href={tagUrl(tag)} class="mono" data-reveal>#{tag}</a>)}
    </div>
  </div>
</section>

<style>
  .mission-debrief {
    --debrief-accent: var(--color-accent);
    position: relative;
    isolation: isolate;
    border: 1px solid var(--color-line);
    border-top-color: color-mix(in srgb, var(--debrief-accent) 48%, var(--color-line));
    background:
      radial-gradient(circle at 90% 8%, color-mix(in srgb, var(--debrief-accent) 8%, transparent), transparent 30%),
      color-mix(in srgb, var(--color-bg-soft) 90%, transparent);
    box-shadow:
      inset 2px 0 color-mix(in srgb, var(--debrief-accent) 56%, transparent),
      0 2rem 4rem -3.5rem rgb(0 0 0 / 0.95);
  }

  .mission-debrief::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size: 2.6rem 2.6rem;
    -webkit-mask-image: linear-gradient(90deg, transparent 18%, #000);
    mask-image: linear-gradient(90deg, transparent 18%, #000);
  }

  .debrief-scan {
    position: absolute;
    z-index: 0;
    inset: 0 auto 0 -18%;
    width: 16%;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--debrief-accent) 8%, transparent) 65%,
      color-mix(in srgb, var(--debrief-accent) 26%, transparent)
    );
    opacity: 0;
  }

  html[data-motion='ready'] .mission-debrief[data-reveal-state='visible'] .debrief-scan {
    animation: debrief-scan 4.8s 0.35s var(--ease-out-expo) both;
  }

  @keyframes debrief-scan {
    0% { left: -18%; opacity: 0; }
    18% { opacity: 0.7; }
    82% { opacity: 0.24; }
    100% { left: 104%; opacity: 0; }
  }

  .debrief-head,
  .completion-board,
  .route,
  .related,
  .sources,
  .debrief-tags {
    position: relative;
    z-index: 1;
  }

  .debrief-head,
  .section-label,
  .debrief-tags {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .debrief-head {
    padding: 0.95rem 1.05rem;
    border-bottom: 1px solid var(--color-line);
  }

  .debrief-code,
  .summary-kicker,
  .section-label > :first-child,
  .debrief-tags > span {
    color: color-mix(in srgb, var(--debrief-accent) 75%, var(--color-dim));
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .debrief-head h2 {
    margin-top: 0.12rem;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .completion {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-faint);
    font-size: 0.59rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .completion i {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--debrief-accent);
    box-shadow: 0 0 0.7rem color-mix(in srgb, var(--debrief-accent) 72%, transparent);
  }

  .completion-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.78fr);
    border-bottom: 1px solid var(--color-line);
  }

  .completion-summary {
    position: relative;
    min-width: 0;
    padding: 1.15rem 1.05rem;
    border-right: 1px solid var(--color-line);
  }

  .completion-seal {
    position: absolute;
    top: 50%;
    right: 1.05rem;
    width: 3.7rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--debrief-accent) 22%, var(--color-line));
    border-radius: 50%;
    opacity: 0.42;
    transform: translateY(-50%);
  }

  .completion-seal::before,
  .completion-seal::after {
    content: '';
    position: absolute;
    border-radius: 50%;
  }

  .completion-seal::before {
    inset: 0.42rem;
    border: 1px dashed color-mix(in srgb, var(--debrief-accent) 40%, transparent);
  }

  .completion-seal::after {
    inset: 50%;
    width: 0.42rem;
    height: 0.7rem;
    border-right: 1px solid var(--debrief-accent);
    border-bottom: 1px solid var(--debrief-accent);
    border-radius: 0;
    transform: translate(-50%, -65%) rotate(45deg);
  }

  .completion-seal i {
    position: absolute;
    inset: -1px;
    border: 1px solid transparent;
    border-top-color: var(--debrief-accent);
    border-radius: 50%;
  }

  html[data-motion='ready'] .mission-debrief[data-reveal-state='visible'] .completion-seal i {
    animation: seal-complete 1.15s 0.45s var(--ease-out-expo) both;
  }

  @keyframes seal-complete {
    from { opacity: 0; transform: rotate(-120deg) scale(0.82); }
    to { opacity: 1; transform: rotate(1turn) scale(1); }
  }

  .summary-value {
    max-width: calc(100% - 4.5rem);
    margin-top: 0.38rem;
    color: var(--color-text-strong);
    font-size: 1.02rem;
    font-weight: 570;
  }

  .summary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: 0.72rem;
    color: var(--color-faint);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .summary-meta > * + *::before {
    content: '/';
    margin-right: 0.75rem;
    color: var(--color-line-bright);
  }

  .summary-meta a {
    color: color-mix(in srgb, var(--debrief-accent) 68%, var(--color-dim));
    text-decoration: none;
  }

  .summary-meta a:is(:hover, :focus-visible) {
    color: var(--debrief-accent);
  }

  .completion-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }

  .completion-stats > div {
    padding: 0.76rem 0.82rem;
  }

  .completion-stats > div:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .completion-stats > div:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  .completion-stats dt {
    color: var(--color-faint);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .completion-stats dd {
    margin: 0.18rem 0 0;
    color: var(--color-text);
    font: 650 0.85rem/1.2 var(--font-mono);
  }

  .route,
  .related,
  .sources {
    padding: 1.05rem;
    border-bottom: 1px solid var(--color-line);
  }

  .section-label {
    margin-bottom: 0.7rem;
  }

  .section-label h3 {
    margin: 0;
    font-weight: 500;
  }

  .section-label small {
    color: var(--color-faint);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .route-grid.solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .route-card {
    position: relative;
    isolation: isolate;
    display: flex;
    min-width: 0;
    min-height: 8.2rem;
    overflow: hidden;
    border: 1px solid var(--color-line-bright);
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 1px rgb(255 255 255 / 0.02);
    transition:
      border-color 0.2s ease,
      translate 0.24s var(--ease-out-expo),
      box-shadow 0.22s ease;
  }

  .route-card img,
  .route-shade {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .route-card img {
    object-fit: cover;
    opacity: 0.17;
    filter: saturate(0.75) contrast(1.08);
    transition: transform 0.45s var(--ease-out-expo), opacity 0.2s ease;
  }

  .route-shade {
    z-index: -1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-bg) 94%, transparent), color-mix(in srgb, var(--color-bg) 45%, transparent)),
      linear-gradient(0deg, var(--color-bg), transparent 75%);
  }

  .route-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    padding: 0.9rem;
  }

  .route-label,
  .route-meta {
    color: color-mix(in srgb, var(--debrief-accent) 70%, var(--color-dim));
    font-size: 0.57rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .route-card strong {
    margin-top: 0.36rem;
    color: var(--color-text-strong);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }

  .route-meta {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--color-faint);
  }

  .route-card:is(:hover, :focus-visible) {
    z-index: 1;
    border-color: color-mix(in srgb, var(--debrief-accent) 58%, var(--color-line-bright));
    translate: 0 -2px;
    box-shadow: 0 1.25rem 2.2rem -1.8rem rgb(0 0 0 / 0.9);
  }

  .route-card:is(:hover, :focus-visible) img {
    opacity: 0.24;
    transform: scale(1.025);
  }

  .route-card:focus-visible,
  .related-card:focus-visible,
  .source-list a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--debrief-accent) 78%, white);
    outline-offset: 2px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .related-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 52%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      translate 0.24s var(--ease-out-expo),
      background 0.2s ease;
  }

  .related-cover {
    position: relative;
    z-index: 1;
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .related-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.72;
    filter: saturate(0.8) brightness(0.82);
    transition:
      transform 0.45s var(--ease-out-expo),
      filter 0.22s ease;
  }

  .related-copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 8.2rem;
    flex-direction: column;
    padding: 0.78rem;
  }

  .related-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-faint);
    font-size: 0.52rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .related-card strong {
    display: -webkit-box;
    margin-top: 0.52rem;
    overflow: hidden;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 590;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .related-arrow {
    margin-top: auto;
    padding-top: 0.7rem;
    color: color-mix(in srgb, var(--debrief-accent) 64%, var(--color-faint));
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-card:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--debrief-accent) 48%, var(--color-line-bright));
    background: color-mix(in srgb, var(--debrief-accent) 4%, var(--color-surface));
    translate: 0 -2px;
  }

  .related-card:is(:hover, :focus-visible) .related-cover img {
    filter: saturate(0.92) brightness(0.9);
    transform: scale(1.025);
  }

  .source-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .source-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    border-bottom: 1px solid var(--color-line);
  }

  .source-index {
    padding-top: 0.68rem;
    color: var(--color-faint);
    font-size: 0.56rem;
  }

  .source-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 0.58rem 0;
    color: var(--color-dim);
    font-size: 0.75rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .source-list a > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .source-list small {
    flex: 0 0 auto;
    color: var(--color-faint);
    font-size: 0.52rem;
    letter-spacing: 0.04em;
  }

  .source-list a:is(:hover, :focus-visible) > span {
    color: var(--debrief-accent);
  }

  .debrief-tags {
    min-height: 3rem;
    padding: 0.65rem 1.05rem;
  }

  .debrief-tags > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.38rem 0.75rem;
  }

  .debrief-tags a {
    color: var(--color-faint);
    font-size: 0.59rem;
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .debrief-tags a:is(:hover, :focus-visible) {
    color: var(--debrief-accent);
  }

  @media (max-width: 680px) {
    .completion-seal {
      width: 3.15rem;
    }
    .completion-board {
      grid-template-columns: minmax(0, 1fr);
    }

    .completion-summary {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .route-grid,
    .route-grid.solo,
    .related-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .route-card {
      min-height: 7.6rem;
    }

    .related-card {
      display: grid;
      grid-template-columns: minmax(7rem, 0.42fr) minmax(0, 1fr);
    }

    .related-cover {
      height: 100%;
      min-height: 7.6rem;
      border-right: 1px solid var(--color-line);
      border-bottom: 0;
    }

    .related-copy {
      min-height: 7.6rem;
    }

    .source-list a {
      align-items: flex-start;
      flex-direction: column;
