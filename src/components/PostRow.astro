---
import type { Post } from '../lib/posts'
import { formatDate, postUrl, tagUrl, categoryUrl } from '../lib/posts'

interface Props {
  post: Post
  /** 列表序号，会以十六进制显示 */
  index?: number
  /** 所在页面的标题层级；首页/相关文章默认使用 h3 */
  headingLevel?: 'h2' | 'h3'
  /** 首页使用更紧凑的情报流，归档和相关文章保持默认密度 */
  variant?: 'default' | 'compact'
}

const { post, index, headingLevel = 'h3', variant = 'default' } = Astro.props
const { title, description, pubDate, tags, category, series, pinned } = post.data
const hex = index === undefined ? null : `0x${index.toString(16).padStart(2, '0')}`
const Heading = headingLevel
---

<article class:list={['row', variant]}>
  <a
    href={postUrl(post)}
    class="row-hit"
    aria-label={title}
    data-jmp
    data-jmp-source="field note"
    data-jmp-title={title}
  ></a>

  <div class="row-side mono">
    {hex && <span class="row-hex">{hex}</span>}
    <time datetime={pubDate.toISOString()} class="row-date">{formatDate(pubDate)}</time>
  </div>

  <div class="row-main">
    <Heading class="row-title">
      {pinned > 0 && <span class="row-pin mono" title="置顶">PIN</span>}
      {title}
    </Heading>

    <p class="row-desc">{description}</p>

    <div class="row-meta mono">
      <a href={categoryUrl(category)} class="row-cat">{category}</a>
      {series && <span class="row-series">series: {series}</span>}
      <span class="row-tags">
        {tags.slice(0, 4).map((t) => <a href={tagUrl(t)} class="row-tag">#{t}</a>)}
      </span>
    </div>
  </div>

  <span class="row-arrow mono" aria-hidden="true">→</span>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: 1.25rem;
    align-items: start;
    padding: 1.35rem 1rem 1.35rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
    border-left: 1px solid transparent;
    transition:
      border-left-color 0.22s var(--ease-out-expo),
      background 0.22s,
      padding-left 0.22s var(--ease-out-expo);
  }

  .row:hover {
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    border-left-color: var(--color-accent);
    padding-left: 1.25rem;
  }

  /* 整行可点，标签链接靠 z-index 浮在上面 */
  .row-hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .row-side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 0.2rem;
    font-size: 0.74rem;
  }

  /* 十六进制序号是这个站的记号，别让它糊在背景里 */
  .row-hex {
    color: color-mix(in srgb, var(--color-accent) 70%, var(--color-faint));
    letter-spacing: 0.05em;
    transition: color 0.18s;
  }

  .row:hover .row-hex {
    color: var(--color-accent);
  }

  /* hover 时行首弹出的游标 */
  .row-hex::before {
    content: '▸';
    position: absolute;
    left: -0.85rem;
    color: var(--color-accent);
    opacity: 0;
    translate: -3px 0;
    transition:
      opacity 0.2s,
      translate 0.2s var(--ease-out-expo);
  }

  .row:hover .row-hex::before {
    opacity: 1;
    translate: 0 0;
  }

  .row-date {
    color: var(--color-faint);
  }

  .row-title {
    font-size: 1.08rem;
    font-weight: 650;
    line-height: 1.45;
    color: var(--color-text-strong);
    transition: color 0.18s;
  }

  .row:hover .row-title {
    color: var(--color-accent);
  }

  .row-pin {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding: 0.1rem 0.3rem;
    margin-right: 0.4rem;
    border: 1px solid var(--color-accent-soft);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    vertical-align: 0.15em;
  }

  .row-desc {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row-meta {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
  }

  .row-cat {
    position: relative;
    z-index: 2;
    color: var(--color-text);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-line-bright);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .row-cat:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-soft);
  }

  .row-series {
    color: var(--color-warn);
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .row-tag {
    position: relative;
    z-index: 2;
    color: var(--color-faint);
    text-decoration: none;
    transition: color 0.15s;
  }

  .row-tag:hover {
    color: var(--color-accent);
  }

  .row-arrow {
    align-self: center;
    color: var(--color-faint);
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 0.22s,
      translate 0.22s var(--ease-out-expo);
  }

  .row:hover .row-arrow {
    opacity: 1;
    translate: 0 0;
    color: var(--color-accent);
  }

  .row.compact {
    grid-template-columns: 5.4rem minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1rem 0.75rem;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-surface) 18%, transparent));
  }

  .row.compact:hover {
    padding-left: 1rem;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-accent) 5%, transparent),
      color-mix(in srgb, var(--color-surface) 48%, transparent)
    );
  }

  .compact .row-side {
    gap: 0.08rem;
    font-size: 0.68rem;
  }

  .compact .row-title {
    font-size: 1rem;
    line-height: 1.4;
  }

  .compact .row-desc {
    margin-top: 0.22rem;
    font-size: 0.81rem;
    line-height: 1.55;
    -webkit-line-clamp: 1;
  }

  .compact .row-meta {
    margin-top: 0.42rem;
    gap: 0.6rem;
    font-size: 0.67rem;
  }

  .compact .row-cat {
    padding-block: 0.06rem;
  }

  .compact .row-arrow {
    padding-right: 0.2rem;
    font-size: 0.8rem;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .row-side {
      flex-direction: row;
      gap: 0.7rem;
      padding-top: 0;
    }

    .row-arrow {
      display: none;
    }

    .row.compact {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.38rem;
      padding: 0.95rem 0.65rem;
      background: transparent;
    }

    .row.compact:hover {
      padding-left: 0.85rem;
    }

    .compact .row-side {
      gap: 0.7rem;
    }

    .compact .row-desc {
      -webkit-line-clamp: 2;
    }

    .compact .row-meta {
      gap: 0.55rem;
    }

    .compact .row-tags a:nth-child(n + 3) {
      display: none;
    }
  }
</style>
