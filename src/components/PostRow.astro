---
import type { Post } from '../lib/posts'
import { formatDate, postUrl, categoryUrl } from '../lib/posts'

interface Props {
  post: Post
  index?: number
  headingLevel?: 'h2' | 'h3'
  variant?: 'default' | 'compact'
}

const { post, headingLevel = 'h3' } = Astro.props
const { title, description, pubDate, category, series, pinned } = post.data
const Heading = headingLevel
---

<article class="row">
  <Heading class="row-title">
    {pinned > 0 && <span class="row-pin">置顶</span>}
    <a href={postUrl(post)}>{title}</a>
  </Heading>
  <p class="row-desc">{description}</p>
  <p class="row-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <a href={categoryUrl(category)}>{category}</a>
    {series && <span>{series}</span>}
  </p>
</article>

<style>
  .row + .row {
    margin-top: 2rem;
  }

  .row-title {
    color: var(--color-text-strong);
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .row-title a {
    color: inherit;
    text-decoration: none;
  }

  .row-title a:hover {
    color: var(--color-accent);
  }

  .row-pin {
    margin-right: 0.45rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .row-desc {
    max-width: 42rem;
    margin-top: 0.55rem;
    color: var(--color-dim);
    font-size: 1rem;
    line-height: 1.6;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.7rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .row-meta a {
    color: inherit;
    text-decoration: none;
  }

  .row-meta a:hover {
    color: var(--color-text);
  }
</style>
