---
export interface BinaryXrayCounts {
  /** Published field notes. */
  entries: number
  /** Top-level content channels/categories. */
  tracks: number
  /** Curated learning routes. */
  series: number
  /** Indexed tags/signals. */
  signals: number
}

export interface BinaryXrayLatest {
  title: string
  href: string
  label?: string
  date?: string | Date
}

export interface BinaryXraySeries {
  name: string
  count: number
  href: string
}

interface Props {
  counts: BinaryXrayCounts
  latest: BinaryXrayLatest
  series: BinaryXraySeries[]
  class?: string
}

const {
  counts,
  latest,
  series,
  class: className,
} = Astro.props

const number = new Intl.NumberFormat('en-US', { minimumIntegerDigits: 2 })
const displayDate = latest.date instanceof Date
  ? new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(latest.date)
  : latest.date
const dateTime = latest.date instanceof Date ? latest.date.toISOString() : latest.date

const routes = series.slice(0, 3)
const layers = [
  {
    id: 'MANIFEST',
    index: '01',
    name: 'Manifest',
    type: 'AXML / ENTRY',
    tone: '#52e198',
    signature: 'activity · permission · intent',
    bytes: '41 58 4D 4C 00 01 08 00',
    title: 'Resolve the attack surface',
    description: '从组件、权限与 intent-filter 定位入口，再决定静态分析从哪里开始。',
    stat: `${number.format(counts.tracks)} channels`,
  },
  {
    id: 'DEX',
    index: '02',
    name: 'Classes.dex',
    type: 'DEX / SMALI',
    tone: '#65d9ed',
    signature: 'string_id · method_id · code_item',
    bytes: '64 65 78 0A 30 33 35 00',
    title: 'Turn bytecode into behavior',
    description: '沿字符串、方法索引与调用关系还原 Java / Kotlin 层的真实执行路径。',
    stat: `${number.format(counts.entries)} records`,
  },
  {
    id: 'JNI',
    index: '03',
    name: 'JNI bridge',
    type: 'JNI / BOUNDARY',
    tone: '#ae91ff',
    signature: 'JNI_OnLoad · RegisterNatives',
    bytes: '4A 4E 49 5F 4F 6E 4C 6F',
    title: 'Cross the managed boundary',
    description: '把 Java 声明、动态注册与 Native 实现重新对齐，锁定真正的算法入口。',
    stat: `${number.format(counts.series)} routes`,
  },
  {
    id: 'ELF',
    index: '04',
    name: 'Native ELF',
    type: 'ARM64 / SO',
    tone: '#f2bd5b',
    signature: '.text · .rodata · init_array',
    bytes: '7F 45 4C 46 02 01 01 00',
    title: 'Read the machine underneath',
    description: '从装载布局、ARM64 调用约定与控制流中提炼可以验证的实现假设。',
    stat: latest.label || 'latest sample',
  },
  {
    id: 'TRACE',
    index: '05',
    name: 'Runtime trace',
    type: 'FRIDA / EVIDENCE',
    tone: '#ff778e',
    signature: 'Java → JNI → ARM64 → syscall',
    bytes: '50 43 3D 37 46 34 35 34 43',
    title: 'Verify intent at runtime',
    description: '把 Hook、寄存器与系统调用拼成证据链，让静态推断在运行时落地。',
    stat: `${number.format(counts.signals)} signals`,
  },
] as const
---

<section
  class:list={['binary-xray', className]}
  data-binary-xray
  data-active-layer="MANIFEST"
  data-xray-view="surface"
  data-intro="idle"
  data-layers="MANIFEST,DEX,JNI,ELF,TRACE"
  data-count-entries={counts.entries}
  data-count-tracks={counts.tracks}
  data-count-series={counts.series}
  data-count-signals={counts.signals}
  data-latest-href={latest.href}
  aria-labelledby="binary-xray-heading"
>
  <header class="bx-chrome mono">
    <div class="bx-chrome-title">
      <span class="bx-led" aria-hidden="true"></span>
      <span>BINARY_SPECIMEN / LIVE_ANALYSIS</span>
    </div>
    <div class="bx-phase" aria-hidden="true">
      <span data-xray-phase>SPECIMEN READY</span>
      <i></i>
      <b>ARM64</b>
    </div>
  </header>

  <div class="bx-layout">
    <div class="bx-copy">
      <p class="bx-command mono" aria-label="命令 analyze latest dot apk">
        <span aria-hidden="true">$</span>
        <span>analyze</span>
        <em>--layers</em>
        <strong>latest.apk</strong>
      </p>

      <div class="bx-heading">
        <span class="bx-kicker mono">APK / X-RAY WORKBENCH</span>
        <h2 id="binary-xray-heading" class="font-display">
          Break the package.<br />
          <span>Read its intent.</span>
        </h2>
        <p>从入口、字节码到 Native 运行轨迹，逐层拆开一个 Android 样本。</p>
      </div>

      <dl class="bx-counts mono" aria-label="知识库统计">
        <div>
          <dt>entries</dt>
          <dd>{number.format(counts.entries)}</dd>
        </div>
        <div>
          <dt>tracks</dt>
          <dd>{number.format(counts.tracks)}</dd>
        </div>
        <div>
          <dt>series</dt>
          <dd>{number.format(counts.series)}</dd>
        </div>
        <div>
          <dt>signals</dt>
          <dd>{number.format(counts.signals)}</dd>
        </div>
      </dl>

      <div class="bx-readout" aria-live="polite" aria-atomic="true">
        {layers.map((layer, index) => (
          <article
            id={`binary-xray-panel-${layer.id.toLowerCase()}`}
            role="tabpanel"
            class="bx-panel"
            data-xray-panel={layer.id}
            aria-labelledby={`binary-xray-tab-${layer.id.toLowerCase()}`}
            hidden={index !== 0}
          >
            <div class="bx-panel-meta mono">
              <span>{layer.index} / {layer.id}</span>
              <strong>{layer.stat}</strong>
            </div>
            <h3>{layer.title}</h3>
            <p>{layer.description}</p>
            <code>{layer.signature}</code>
          </article>
        ))}
      </div>
    </div>

    <div class="bx-workbench">
      <div
        class="bx-stage"
        data-xray-stage
        aria-label="APK 五层解剖图。使用方向键或点击切换分析层；触屏设备再次点击当前层切换表层与透视层。"
      >
        <div class="bx-address mono" aria-hidden="true">
          <span>0x7F454C46</span>
          <i></i>
          <span>RX / 64</span>
        </div>

        <svg class="bx-wires" viewBox="0 0 720 470" aria-hidden="true">
          <path d="M42 68H185L239 114H666" />
          <path d="M42 405H169L223 352H668" />
          <path d="M604 114V352" />
          <circle cx="42" cy="68" r="3" />
          <circle cx="42" cy="405" r="3" />
          <circle cx="604" cy="233" r="5" />
        </svg>

        <div class="bx-stack bx-stack-surface" role="tablist" aria-label="选择 APK 分析层">
          {layers.map((layer, index) => (
            <button
              type="button"
              id={`binary-xray-tab-${layer.id.toLowerCase()}`}
              class="bx-sheet"
              role="tab"
              data-xray-layer={layer.id}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`binary-xray-panel-${layer.id.toLowerCase()}`}
              tabindex={index === 0 ? 0 : -1}
              style={`--i:${index};--tone:${layer.tone}`}
            >
              <span class="bx-sheet-id mono">{layer.index}</span>
              <span class="bx-sheet-copy">
                <strong>{layer.name}</strong>
                <small class="mono">{layer.type}</small>
              </span>
              <span class="bx-sheet-mark mono" aria-hidden="true">{layer.id}</span>
            </button>
          ))}
        </div>

        <div class="bx-xray" aria-hidden="true">
          <div class="bx-stack bx-stack-inside">
            {layers.map((layer, index) => (
              <div
                class="bx-sheet bx-sheet-inside"
                data-xray-internal={layer.id}
                style={`--i:${index};--tone:${layer.tone}`}
              >
                <span class="bx-inside-rule"></span>
                <span class="bx-inside-bytes mono">{layer.bytes}</span>
                <span class="bx-inside-signal mono">{layer.signature}</span>
                <span class="bx-inside-node one"></span>
                <span class="bx-inside-node two"></span>
                <span class="bx-inside-node three"></span>
              </div>
            ))}
          </div>
        </div>

        <div class="bx-lens" data-xray-lens aria-hidden="true">
          <span></span>
          <i></i>
        </div>

        <div class="bx-scan" aria-hidden="true"></div>

        <div class="bx-stage-footer mono">
          <span><i></i> signature verified</span>
          <button
            type="button"
            data-xray-view-toggle
            aria-label="切换表层与透视层"
            aria-pressed="false"
          >
            view / <b data-xray-view-label>SURFACE</b>
          </button>
          <span>drag / inspect</span>
        </div>
      </div>

      <footer class="bx-evidence">
        <a
          class="bx-latest"
          href={latest.href}
          data-jmp
          data-jmp-source="HOME / BINARY SPECIMEN"
          data-jmp-title={latest.title}
          data-jmp-trace="APK › DEX › JNI › ELF › TRACE"
        >
          <span class="mono">LATEST_INGRESS</span>
          <strong>{latest.title}</strong>
          <small class="mono">
            {latest.label && <span>{latest.label}</span>}
            {displayDate && <time datetime={dateTime}>{displayDate}</time>}
          </small>
        </a>

        {routes.length > 0 && (
          <nav class="bx-routes" aria-label="推荐学习路线">
            <span class="mono">ROUTES / {number.format(routes.length)}</span>
            <ol>
              {routes.map((route, index) => (
                <li>
                  <a href={route.href}>
                    <span class="mono">0{index + 1}</span>
                    <strong>{route.name}</strong>
                    <small class="mono">×{number.format(route.count)}</small>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </footer>
    </div>
  </div>
</section>

<script>
  type SelectSource = 'click' | 'keyboard' | 'intro' | 'external'
  type XrayRoot = HTMLElement & {
    selectLayer?: (layer: string, source?: SelectSource) => boolean
    getXrayState?: () => { layer: string; view: string; intro: string }
  }

  const LAYER_IDS = ['MANIFEST', 'DEX', 'JNI', 'ELF', 'TRACE'] as const

  function setupBinaryXrays() {
    document.querySelectorAll<XrayRoot>('[data-binary-xray]').forEach((root) => {
      if (root.dataset.xrayBound) return
      root.dataset.xrayBound = 'true'

      const lifecycle = new AbortController()
      const { signal } = lifecycle
      const stage = root.querySelector<HTMLElement>('[data-xray-stage]')
      const controls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-xray-layer]'))
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-xray-panel]'))
      const phase = root.querySelector<HTMLElement>('[data-xray-phase]')
      const viewToggle = root.querySelector<HTMLButtonElement>('[data-xray-view-toggle]')
      const viewLabel = root.querySelector<HTMLElement>('[data-xray-view-label]')
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
      const compact = window.matchMedia('(max-width: 760px), (pointer: coarse)')
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')

      if (!stage || controls.length === 0 || panels.length === 0) return

      let activeIndex = Math.max(0, LAYER_IDS.indexOf((root.dataset.activeLayer || 'MANIFEST') as typeof LAYER_IDS[number]))
      let introPlayed = false
      let introRunning = false
      let isVisible = !('IntersectionObserver' in window)
      let pointerFrame = 0
      let pointerClientX = 0
      let pointerClientY = 0
      let nextX = 50
      let nextY = 50
      let introTimers: number[] = []

      const emit = (name: string, detail: Record<string, unknown>) => {
        root.dispatchEvent(new CustomEvent(name, { bubbles: true, detail }))
      }

      const currentState = () => ({
        layer: LAYER_IDS[activeIndex],
        view: root.dataset.xrayView || 'surface',
        intro: root.dataset.intro || 'idle',
      })

      const setView = (view: 'surface' | 'inside', source: SelectSource | 'toggle' = 'toggle') => {
        root.dataset.xrayView = view
        if (viewLabel) viewLabel.textContent = view === 'inside' ? 'X-RAY' : 'SURFACE'
        viewToggle?.setAttribute('aria-pressed', String(view === 'inside'))
        emit('binary-xray:viewchange', { ...currentState(), source })
      }

      const selectLayer = (
        layer: string,
        source: SelectSource = 'external',
        moveFocus = false,
      ) => {
        const normalized = layer.toUpperCase() as typeof LAYER_IDS[number]
        const nextIndex = LAYER_IDS.indexOf(normalized)
        if (nextIndex < 0) return false

        activeIndex = nextIndex
        root.dataset.activeLayer = normalized

        controls.forEach((control, index) => {
          const active = index === activeIndex
          control.setAttribute('aria-selected', String(active))
          control.tabIndex = active ? 0 : -1
          if (moveFocus && active) control.focus({ preventScroll: true })
        })

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.xrayPanel !== normalized
        })

        emit('binary-xray:change', {
          ...currentState(),
          index: activeIndex,
          source,
        })
        return true
      }

      const clearIntroTimers = () => {
        introTimers.forEach((timer) => window.clearTimeout(timer))
        introTimers = []
      }

      const settleIntro = (source: string) => {
        if (!introRunning && root.dataset.intro === 'settled') return
        clearIntroTimers()
        introRunning = false
        introPlayed = true
        root.dataset.intro = 'settled'
        if (phase) phase.textContent = 'SPECIMEN READY'
        emit('binary-xray:introend', { ...currentState(), source })
      }

      const runIntro = () => {
        if (
          introPlayed ||
          introRunning ||
          !isVisible ||
          document.hidden ||
          reduced.matches ||
          compact.matches ||
          document.documentElement.dataset.motion !== 'ready'
        ) return

        introRunning = true
        root.dataset.intro = 'running'
        emit('binary-xray:introstart', currentState())

        const steps = [
          [80, 'VERIFYING SIGNATURE'],
          [560, 'UNPACKING DEX'],
          [1040, 'RESOLVING JNI'],
          [1520, 'TRACING NATIVE'],
          [2240, 'SPECIMEN READY'],
        ] as const

        steps.forEach(([delay, label], index) => {
          introTimers.push(window.setTimeout(() => {
            if (phase) phase.textContent = label
            if (index === steps.length - 1) settleIntro('complete')
          }, delay))
        })
      }

      const syncMotion = () => {
        const ready = document.documentElement.dataset.motion === 'ready'
        if (!ready || reduced.matches || compact.matches) {
          if (introRunning) settleIntro('motion')
          else root.dataset.intro = 'settled'
          root.dataset.lens = 'off'
          return
        }
        runIntro()
      }

      controls.forEach((control, index) => {
        control.addEventListener('click', () => {
          const selected = LAYER_IDS[index]
          const isSame = root.dataset.activeLayer === selected
          selectLayer(selected, 'click')

          if (compact.matches) {
            if (isSame) {
              setView(root.dataset.xrayView === 'inside' ? 'surface' : 'inside')
            } else {
              setView('inside', 'click')
            }
          }
        }, { signal })

        control.addEventListener('keydown', (event) => {
          let next = activeIndex
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (activeIndex + 1) % controls.length
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (activeIndex - 1 + controls.length) % controls.length
          else if (event.key === 'Home') next = 0
          else if (event.key === 'End') next = controls.length - 1
          else if (event.key === 'Escape' && compact.matches) {
            setView('surface', 'keyboard')
            return
          } else return

          event.preventDefault()
          selectLayer(LAYER_IDS[next], 'keyboard', true)
        }, { signal })
      })

      viewToggle?.addEventListener('click', () => {
        setView(root.dataset.xrayView === 'inside' ? 'surface' : 'inside')
      }, { signal })

      stage.addEventListener('pointerenter', () => {
        if (finePointer.matches && document.documentElement.dataset.motion === 'ready') {
          root.dataset.lens = 'active'
        }
      }, { signal })

      stage.addEventListener('pointerleave', () => {
        root.dataset.lens = 'off'
      }, { signal })

      stage.addEventListener('pointermove', (event) => {
        if (!finePointer.matches || document.documentElement.dataset.motion !== 'ready') return
        pointerClientX = event.clientX
        pointerClientY = event.clientY
        if (pointerFrame) return
        pointerFrame = window.requestAnimationFrame(() => {
          pointerFrame = 0
          const bounds = stage.getBoundingClientRect()
          nextX = Math.max(3, Math.min(97, ((pointerClientX - bounds.left) / bounds.width) * 100))
          nextY = Math.max(3, Math.min(97, ((pointerClientY - bounds.top) / bounds.height) * 100))
          root.style.setProperty('--xray-x', `${nextX}%`)
          root.style.setProperty('--xray-y', `${nextY}%`)
        })
      }, { signal, passive: true })

      root.addEventListener('binary-xray:select', ((event: CustomEvent<{ layer?: string }>) => {
        if (event.detail?.layer) selectLayer(event.detail.layer, 'external')
      }) as EventListener, { signal })

      let observer: IntersectionObserver | undefined
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(([entry]) => {
          isVisible = Boolean(entry?.isIntersecting)
          if (isVisible) runIntro()
        }, { threshold: 0.34 })
        observer.observe(root)
      }

      root.selectLayer = (layer, source = 'external') => selectLayer(layer, source)
      root.getXrayState = currentState

      document.addEventListener('sleep4r:motionchange', syncMotion, { signal })
      document.addEventListener('visibilitychange', syncMotion, { signal })
      reduced.addEventListener('change', syncMotion, { signal })
      compact.addEventListener('change', syncMotion, { signal })

      document.addEventListener('astro:before-swap', () => {
        clearIntroTimers()
        if (pointerFrame) window.cancelAnimationFrame(pointerFrame)
        observer?.disconnect()
        lifecycle.abort()
        delete root.selectLayer
        delete root.getXrayState
      }, { once: true })

      selectLayer(LAYER_IDS[activeIndex], 'external')
      setView('surface', 'external')
      syncMotion()
      emit('binary-xray:ready', currentState())
    })
  }

  setupBinaryXrays()
  document.addEventListener('astro:after-swap', setupBinaryXrays)
</script>

<style>
  .binary-xray {
    --xray-x: 68%;
    --xray-y: 42%;
    --bx-green: var(--color-accent, #3ddc84);
    --bx-panel: color-mix(in srgb, var(--color-panel, #0c1015) 92%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--color-line-bright, #26303a);
    background:
      linear-gradient(120deg, rgb(61 220 132 / 0.045), transparent 32%),
      radial-gradient(circle at 78% 32%, rgb(101 217 237 / 0.055), transparent 30%),
      var(--bx-panel);
    box-shadow:
      var(--shadow-panel, 0 1.5rem 4rem rgb(0 0 0 / 0.28)),
      inset 0 1px rgb(255 255 255 / 0.025);
    color: var(--color-text, #c6cbd2);
    contain: layout paint;
  }

  .binary-xray::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.018) 1px, transparent 1px);
    background-size: 3rem 3rem;
    mask-image: linear-gradient(90deg, transparent, #000 38%, #000);
  }

  .mono {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }

  .bx-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.35rem;
    padding: 0.45rem 0.78rem;
    border-bottom: 1px solid var(--color-line, #1a222b);
    background: rgb(4 7 10 / 0.58);
    color: var(--color-faint, #5b6570);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  .bx-chrome-title,
  .bx-phase {
    display: flex;
    align-items: center;
    gap: 0.52rem;
  }

  .bx-led {
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: var(--bx-green);
    box-shadow: 0 0 0.75rem rgb(61 220 132 / 0.65);
  }

  .bx-phase i {
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--bx-green));
  }

  .bx-phase b {
    color: color-mix(in srgb, var(--bx-green) 74%, white);
    font-weight: 500;
  }

  .bx-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.78fr) minmax(30rem, 1.42fr);
    min-height: 35rem;
  }

  .bx-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.35rem, 3.2vw, 2.6rem);
    border-right: 1px solid var(--color-line, #1a222b);
    background: linear-gradient(105deg, rgb(4 7 10 / 0.72), rgb(4 7 10 / 0.12));
  }

  .bx-command {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.48rem;
    margin: 0 0 clamp(1.8rem, 4vw, 3.6rem);
    color: var(--color-dim, #8c96a2);
    font-size: clamp(0.66rem, 1vw, 0.78rem);
  }

  .bx-command > span:first-child {
    color: var(--bx-green);
    text-shadow: 0 0 0.75rem rgb(61 220 132 / 0.35);
  }

  .bx-command em {
    color: #65d9ed;
    font-style: normal;
  }

  .bx-command strong {
    color: var(--color-text-strong, #edf2f7);
    font-weight: 500;
  }

  .bx-kicker {
    display: block;
    margin-bottom: 0.72rem;
    color: var(--bx-green);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
  }

  .bx-heading h2 {
    margin: 0;
    color: var(--color-text-strong, #f0f4f8);
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(2rem, 3.05vw, 3rem);
    font-weight: 620;
    letter-spacing: -0.034em;
    line-height: 1;
    text-wrap: balance;
  }

  .bx-heading h2 span {
    color: color-mix(in srgb, var(--color-text-strong, #f0f4f8) 45%, var(--bx-green));
  }

  .bx-heading > p {
    max-width: 31rem;
    margin: 1.15rem 0 0;
    color: var(--color-dim, #8c96a2);
    font-size: 0.86rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.72;
  }

  .bx-counts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(1.5rem, 3.5vw, 2.5rem) 0 0;
    padding: 0;
    border-block: 1px solid var(--color-line, #1a222b);
