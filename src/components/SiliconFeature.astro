---
interface Props { stage?: boolean }
const { stage = false } = Astro.props
---
<section id="silicon" class:list={["silicon-feature", { "silicon-stage": stage }]} aria-labelledby="silicon-heading">
  <a class="silicon-feature-link" href="/silicon/" data-astro-reload>
    <div class="silicon-feature-art">
      {stage && <><span class="stage-ring" aria-hidden="true"></span><span class="stage-label stage-label-top">Package</span><span class="stage-label stage-label-bottom">Silicon die</span><span class="stage-caption">Conceptual architecture</span></>}
      <img src="/images/silicon/layers.webp" width="840" height="580" alt="Exploded conceptual chip showing the package, interconnects, and silicon" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="silicon-feature-copy">
      <h2 id="silicon-heading">Inside the Silicon</h2>
      <p class="silicon-summary">Package. Silicon. Systems.</p>
      <span class="silicon-cta">Explore layers <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</section>
<style>
  .silicon-feature { container: silicon-card / inline-size; margin: 0; min-width: 0; scroll-margin-top: 100px; align-self: center; }
  .silicon-feature-link { display: flex; flex-direction: column; gap: 20px; color: var(--color-text-strong); }
  .silicon-feature-art { min-width: 0; }
  .silicon-feature-art img {
    display: block; width: min(100%,460px); width: min(100%,clamp(264px,80cqi,460px)); height: auto; margin: auto;
    filter: brightness(1.12); mix-blend-mode: lighten;
    mask-image: linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent),linear-gradient(transparent,#000 12%,#000 88%,transparent);
    mask-composite: intersect;
    transition: transform 550ms cubic-bezier(.2,.8,.2,1);
  }
  .silicon-feature-copy { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 8px 20px; padding-inline: 12px; }
  .silicon-feature h2 { grid-column: 1; margin: 0; color: var(--color-text-strong); font-size: 1.5rem; font-weight: 500; letter-spacing: -.035em; line-height: 1.25; text-wrap: balance; }
  .silicon-summary { grid-column: 1; margin: 0; color: var(--color-dim); font-size: var(--type-meta); line-height: 1.6; }
  .silicon-cta { grid-column: 2; grid-row: 1/3; display: inline-flex; gap: 12px; align-items: center; min-height: 44px; color: var(--color-text); font-size: var(--type-meta); white-space: nowrap; }
  .silicon-cta > span { transition: transform 250ms cubic-bezier(.2,.8,.2,1); }
  .silicon-feature-link:is(:hover,:focus-visible) .silicon-cta { color: var(--color-accent); }
  @media (hover: hover) and (pointer: fine) {
    html[data-motion='ready'] .silicon-feature-link:hover img { transform: translateY(-4px); }
    html[data-motion='ready'] .silicon-feature-link:hover .silicon-cta > span { transform: translate(2px,-2px); }
  }
  /* The home stage is a spatial exhibit; the lightweight image remains the entry. */
  .silicon-stage { align-self: stretch; position: relative; }
  .silicon-stage .silicon-feature-link { height: 100%; justify-content: center; gap: 0; }
  .silicon-stage .silicon-feature-art { position: relative; isolation: isolate; display: grid; place-items: center; min-height: 320px; }
  .silicon-stage .silicon-feature-art::before { content: ''; position: absolute; inset: 3% -3%; z-index: -1; background: radial-gradient(ellipse at 50% 46%,#c7d5dd20,transparent 66%); }
  .silicon-stage img { width: 100%; max-width: 640px; filter: brightness(1.35) saturate(.65); position: relative; z-index: 1; }
  .stage-ring { position: absolute; width: 82%; aspect-ratio: 1; border: 1px solid #89999d30; border-radius: 50%; transform: rotateX(58deg) rotate(-24deg); box-shadow: 0 0 44px #becad00a; }
  .stage-ring::after { content: ''; position: absolute; inset: 15%; border: 1px dashed #89999d28; border-radius: inherit; }
  .stage-label { position: absolute; z-index: 2; font-size: var(--type-caption); line-height:1.4; color: var(--color-text); padding-bottom: 8px; border-bottom: 1px solid #85959b70; }
  .stage-label::after { content: ''; position: absolute; bottom: -3px; width: 5px; height: 5px; background: #dce4e7; border-radius: 50%; }
  .stage-label-top { top: 26%; right: 7%; padding-left: 36px; }
  .stage-label-top::after { left: 0; }
  .stage-label-bottom { left: 6%; top: 43%; padding-right: 36px; }
  .stage-label-bottom::after { right: 0; }
  .stage-caption { position: absolute; bottom: 10px; right: 12px; max-width:75%; font-size: var(--type-caption); line-height:1.4; text-align:right; color: var(--color-faint); }
  .silicon-stage .silicon-feature-copy { padding: 16px 12px; border-top: 1px solid #73808838; margin-inline: 12px; }
  .silicon-stage h2 { font-size: 1.375rem; }
  @media (max-width: 700px) {
    .silicon-stage .silicon-feature-art { min-height: 0; height: 9rem; }
    .silicon-stage img { width: 13.125rem; max-width: 100%; }
    .stage-ring { width: 64%; }
    .stage-label-top { top: 24%; right: 9%; }
    .stage-label-bottom { top: 38%; left: 7%; }
    .stage-caption { bottom: 0; }
    .silicon-stage .silicon-feature-copy { padding: 10px 0; margin-inline: 0; }
    .silicon-stage h2 { font-size: 1.25rem; }
  }
  /* Adapt to the card's usable width, including narrow desktop columns. */
  @container silicon-card (max-width: 420px) {
    .silicon-feature-link { gap: 12px; }
    .silicon-feature-copy { gap: 6px 12px; padding-inline: 0; }
    .silicon-feature h2 { font-size: 1.25rem; }
    .silicon-cta { gap: 8px; }
  }
  @container silicon-card (max-width: 18rem) {
    .silicon-feature-copy { grid-template-columns:minmax(0,1fr); }
    .silicon-cta { grid-column:1; grid-row:auto; justify-self:start; }
    .stage-label-top { top:20%; right:4%; }
    .stage-label-bottom { top:47%; left:4%; }
  }
  html[data-motion='off'] .silicon-feature-link :is(img,.silicon-cta > span) { transform: none; transition: none; }
  @media (prefers-reduced-motion: reduce), print {
    .silicon-feature-link :is(img,.silicon-cta > span) { transform: none !important; transition: none !important; }
  }
</style>
