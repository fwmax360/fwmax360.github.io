---
import type { KnowledgeMapData, KnowledgeNode } from '../lib/knowledgeMap'

interface Props {
  data: KnowledgeMapData
}

const { data } = Astro.props
const rootNode = data.nodes.find((node) => node.kind === 'root')!
const nodePayload = Object.fromEntries(
  data.nodes.map((node) => [
    node.id,
    {
      id: node.id,
      kind: node.kind,
      label: node.label,
      eyebrow: node.eyebrow,
      detail: node.detail,
      meta: node.meta,
      href: node.href,
      count: node.count,
    },
  ]),
)
const payloadJson = JSON.stringify(nodePayload).replaceAll('<', '\\u003c')

const treeCategories = data.categories.map((category) => {
  const posts = data.posts.filter((post) => post.category === category.name)
  const series = data.series
    .map((item) => ({
      ...item,
      posts: posts
        .filter((post) => post.series === item.name)
        .sort(
          (a, b) =>
            (a.order ?? Number.MAX_SAFE_INTEGER) - (b.order ?? Number.MAX_SAFE_INTEGER) ||
            a.date.localeCompare(b.date),
        ),
    }))
    .filter((item) => item.posts.length > 0)

  return {
    ...category,
    series,
    standalone: posts.filter((post) => !post.series),
  }
})

const nodeStyle = (node: KnowledgeNode) => `--node-accent:${node.accent}`
const postSearch = (node: KnowledgeNode) =>
  [node.label, node.detail, node.category, node.series, ...(node.tags ?? [])].filter(Boolean).join(' ')
---

<section
  class="knowledge-map col-side"
  data-knowledge-map
  data-payload-id="knowledge-map-payload"
  aria-labelledby="knowledge-map-title"
>
  <header class="map-toolbar">
    <div class="query-field">
      <label class="mono" for="knowledge-query">filter / keyword</label>
      <div class="query-control">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.25"></circle>
          <path d="m12.5 12.5 4 4"></path>
        </svg>
        <input
          id="knowledge-query"
          data-map-query
          type="search"
          placeholder="标题、系列、标签…"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
    </div>

    <div class="category-field">
      <label class="mono" for="knowledge-category">scope / category</label>
      <select id="knowledge-category" data-map-category>
        <option value="">全部分类</option>
        {data.categories.map((category) => (
          <option value={category.name}>{category.name} · {String(category.count).padStart(2, '0')}</option>
        ))}
      </select>
    </div>

    <button class="clear-filter mono" type="button" data-map-clear disabled>
      clear
    </button>

    <div class="filter-status mono" aria-live="polite">
      <i aria-hidden="true"></i>
      <span data-map-results>{data.stats.posts} / {data.stats.posts} articles visible</span>
    </div>
  </header>

  <div class="signal-strip" aria-label="高频标签">
    <span class="signal-label mono">HIGH-FREQ SIGNALS</span>
    <div class="signal-tags mono">
      {data.highTags.map((tag) => (
        <a href={tag.href} data-map-node-ref={`tag:${tag.name}`}>
          #{tag.name}<sup>{tag.count}</sup>
        </a>
      ))}
    </div>
  </div>

  <div class="map-legend mono" aria-label="图例">
    <span><i class="root-key" aria-hidden="true"></i>core</span>
    <span><i class="category-key" aria-hidden="true"></i>category</span>
    <span><i class="series-key" aria-hidden="true"></i>series</span>
    <span><i class="tag-key" aria-hidden="true"></i>tag signal</span>
    <span><i class="post-key" aria-hidden="true"></i>article</span>
    <span class="legend-hint">hover / focus to trace</span>
  </div>

  <div class="map-workbench">
    <div class="map-visual">
      <div class="map-canvas" data-map-canvas>
        <svg
          class="knowledge-graph"
          viewBox={`0 0 ${data.width} ${data.height}`}
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-labelledby="graph-title graph-description"
        >
          <title id="graph-title">sleep4r 博客交互知识图谱</title>
          <desc id="graph-description">
            从中心知识库连接分类、系列、高频标签与全部文章。节点均可通过键盘聚焦并打开对应页面。
          </desc>

          <defs>
            <pattern id="map-grid" width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M 32 0 L 0 0 0 32" class="grid-line"></path>
            </pattern>
            <radialGradient id="core-halo">
              <stop offset="0" stop-color="#52e198" stop-opacity="0.2"></stop>
              <stop offset="1" stop-color="#52e198" stop-opacity="0"></stop>
            </radialGradient>
          </defs>

          <rect class="graph-grid" width={data.width} height={data.height} fill="url(#map-grid)"></rect>
          <circle class="core-halo" cx={rootNode.x} cy={rootNode.y} r="166" fill="url(#core-halo)"></circle>
          <circle class="core-orbit orbit-a" cx={rootNode.x} cy={rootNode.y} r="116"></circle>
          <circle class="core-orbit orbit-b" cx={rootNode.x} cy={rootNode.y} r="154"></circle>

          <g class="map-edges" aria-hidden="true">
            {data.edges.map((edge) => (
              <path
                class:list={['map-edge', `edge--${edge.relation}`]}
                d={edge.path}
                data-edge-from={edge.from}
                data-edge-to={edge.to}
                data-post-ids={edge.postIds.join(',')}
                style={`--edge-accent:${edge.accent}`}
                vector-effect="non-scaling-stroke"
              ></path>
            ))}
          </g>

          <g class="map-nodes">
            {data.nodes.map((node) => (
              <a
                href={node.href}
                class:list={['map-node', `node--${node.kind}`]}
                style={nodeStyle(node)}
                data-node-id={node.id}
                data-node-kind={node.kind}
                data-jmp={node.kind === 'post' ? '' : undefined}
                data-jmp-source={node.kind === 'post' ? 'knowledge map' : undefined}
                data-jmp-title={node.kind === 'post' ? node.label : undefined}
                data-post-id={node.kind === 'post' ? node.postIds[0] : undefined}
                data-post-ids={node.postIds.join(',')}
                data-category={node.category}
                data-search={node.kind === 'post' ? postSearch(node) : undefined}
                tabindex="0"
                aria-label={`${node.eyebrow}：${node.label}，${node.count} 篇关联文章`}
              >
                <title>{node.eyebrow} · {node.label}</title>
                <g transform={`translate(${node.x} ${node.y})`}>
                  {node.kind === 'root' && (
                    <>
                      <rect class="node-frame" x={-node.width / 2} y={-node.height / 2} width={node.width} height={node.height}></rect>
                      <path class="core-corners" d={`M ${-node.width / 2} -24 v-13 h18 M ${node.width / 2} -24 v-13 h-18 M ${-node.width / 2} 24 v13 h18 M ${node.width / 2} 24 v13 h-18`}></path>
                      <text class="node-eyebrow" y="-15" text-anchor="middle">KNOWLEDGE CORE</text>
                      <text class="node-label root-label" y="5" text-anchor="middle">sleep4r / map</text>
                      <text class="node-count" y="24" text-anchor="middle">{String(node.count).padStart(2, '0')} INDEXED ARTICLES</text>
                    </>
                  )}

                  {(node.kind === 'category' || node.kind === 'series') && (
                    <>
                      <rect class="node-frame" x={-node.width / 2} y={-node.height / 2} width={node.width} height={node.height}></rect>
                      <rect class="node-rail" x={-node.width / 2} y={-node.height / 2} width="3" height={node.height}></rect>
                      <text class="node-eyebrow" x={-node.width / 2 + 16} y="-9">{node.eyebrow}</text>
                      <text class="node-label" x={-node.width / 2 + 16} y="12">{node.shortLabel}</text>
                      <text class="node-count" x={node.width / 2 - 12} y="12" text-anchor="end">{String(node.count).padStart(2, '0')}</text>
                    </>
                  )}

                  {node.kind === 'tag' && (
                    <>
                      <rect class="node-frame" x={-node.width / 2} y={-node.height / 2} width={node.width} height={node.height}></rect>
                      <text class="node-label tag-label" x={-node.width / 2 + 11} y="5">{node.shortLabel}</text>
                      <text class="node-count" x={node.width / 2 - 9} y="5" text-anchor="end">{node.count}</text>
                    </>
                  )}

                  {node.kind === 'post' && (
                    <>
                      <rect class="node-frame" x={-node.width / 2} y={-node.height / 2} width={node.width} height={node.height}></rect>
                      <circle class="article-port" cx={-node.width / 2 + 13} cy="0" r="3.5"></circle>
                      <text class="node-eyebrow" x={-node.width / 2 + 25} y="-7">{node.eyebrow}</text>
                      <text class="node-label article-label" x={-node.width / 2 + 25} y="11">{node.shortLabel}</text>
                      <path class="article-arrow" d={`M ${node.width / 2 - 21} -4 l 7 4 -7 4`}></path>
                    </>
                  )}
                </g>
              </a>
            ))}
          </g>
        </svg>
      </div>

      <section class="knowledge-tree" aria-labelledby="knowledge-tree-title">
        <header class="tree-head">
          <div>
            <p class="mono">MOBILE KNOWLEDGE TREE</p>
            <h2 id="knowledge-tree-title">按路径浏览</h2>
          </div>
          <span class="tree-count mono">{data.stats.posts} nodes</span>
        </header>

        <p class="tree-empty mono" data-tree-empty hidden>NO_MATCHING_ARTICLES</p>

        {treeCategories.map((category, categoryIndex) => (
          <details
            class="tree-category"
            data-filter-group
            data-post-ids={category.postIds.join(',')}
            open={categoryIndex === 0}
          >
            <summary>
              <span class="tree-index mono">0{categoryIndex + 1}</span>
              <span class="tree-category-name">{category.name}</span>
              <span class="tree-category-count mono">{String(category.count).padStart(2, '0')} articles</span>
            </summary>

            <div class="tree-branches">
              {category.series.map((series) => (
                <section class="tree-series" data-filter-group data-post-ids={series.posts.map((post) => post.id).join(',')}>
                  <header>
                    <span class="branch-line" aria-hidden="true"></span>
                    <a href={series.href} data-map-node-ref={`series:${series.name}`}>{series.name}</a>
                    <span class="mono">series · {String(series.posts.length).padStart(2, '0')}</span>
                  </header>
                  <ol>
                    {series.posts.map((post) => (
                      <li
                        class="tree-post"
                        data-post-id={post.id}
                        data-category={post.category}
                        data-search={[post.title, post.description, post.category, post.series, ...post.tags].filter(Boolean).join(' ')}
                      >
                        <a
                          href={post.href}
                          data-map-node-ref={post.nodeId}
                          data-jmp
                          data-jmp-source="knowledge tree"
                          data-jmp-title={post.title}
                        >
                          <span class="tree-order mono">{String(post.order ?? 0).padStart(2, '0')}</span>
                          <span class="tree-post-copy">
                            <strong>{post.title}</strong>
                            <small class="mono">{post.tags.slice(0, 3).map((tag) => `#${tag}`).join('  ')}</small>
                          </span>
                          <span class="tree-open mono" aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}

              {category.standalone.length > 0 && (
                <section class="tree-series tree-standalone" data-filter-group data-post-ids={category.standalone.map((post) => post.id).join(',')}>
                  <header>
                    <span class="branch-line" aria-hidden="true"></span>
                    <span>独立文章</span>
                    <span class="mono">standalone · {String(category.standalone.length).padStart(2, '0')}</span>
                  </header>
                  <ol>
                    {category.standalone.map((post, index) => (
                      <li
                        class="tree-post"
                        data-post-id={post.id}
                        data-category={post.category}
                        data-search={[post.title, post.description, post.category, ...post.tags].join(' ')}
                      >
                        <a
                          href={post.href}
                          data-map-node-ref={post.nodeId}
                          data-jmp
                          data-jmp-source="knowledge tree"
                          data-jmp-title={post.title}
                        >
                          <span class="tree-order mono">{String(index + 1).padStart(2, '0')}</span>
                          <span class="tree-post-copy">
                            <strong>{post.title}</strong>
                            <small class="mono">{post.tags.slice(0, 3).map((tag) => `#${tag}`).join('  ')}</small>
                          </span>
                          <span class="tree-open mono" aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </section>
              )}
            </div>
          </details>
        ))}
      </section>
    </div>

    <aside class="map-inspector" aria-labelledby="inspector-title" aria-live="polite">
      <header class="inspector-head mono">
        <span><i aria-hidden="true"></i> NODE INSPECTOR</span>
        <span data-inspector-index>0x00</span>
      </header>
      <div class="inspector-scan" aria-hidden="true"><span></span></div>
      <p class="inspector-type mono" data-inspector-type>{rootNode.eyebrow}</p>
      <h2 id="inspector-title" data-inspector-title>{rootNode.label}</h2>
      <p class="inspector-detail" data-inspector-detail>{rootNode.detail}</p>
      <p class="inspector-meta mono" data-inspector-meta>{rootNode.meta}</p>
      <dl class="inspector-stats mono">
        <div><dt>articles</dt><dd>{String(data.stats.posts).padStart(2, '0')}</dd></div>
        <div><dt>relations</dt><dd>{String(data.stats.relations).padStart(2, '0')}</dd></div>
        <div><dt>signals</dt><dd>{String(data.stats.tags).padStart(2, '0')}</dd></div>
      </dl>
      <a class="inspector-link mono" href={rootNode.href} data-inspector-link>
        explore node <span aria-hidden="true">↗</span>
      </a>
      <p class="inspector-help mono">TAB TO NAVIGATE<br />ENTER TO OPEN NODE</p>
    </aside>
  </div>

  <script id="knowledge-map-payload" type="application/json" set:html={payloadJson} is:inline></script>
</section>

<script>
  type InspectorNode = {
    id: string
    kind: 'root' | 'category' | 'series' | 'tag' | 'post'
    label: string
    eyebrow: string
    detail: string
    meta: string
    href: string
    count: number
  }

  const initKnowledgeMaps = () => {
    document.querySelectorAll<HTMLElement>('[data-knowledge-map]').forEach((map) => {
      if (map.dataset.mapReady === 'true') return
      map.dataset.mapReady = 'true'

      const payloadElement = document.getElementById(map.dataset.payloadId ?? '')
      if (!payloadElement?.textContent) return
      const payload = JSON.parse(payloadElement.textContent) as Record<string, InspectorNode>
      const query = map.querySelector<HTMLInputElement>('[data-map-query]')
      const category = map.querySelector<HTMLSelectElement>('[data-map-category]')
      const clear = map.querySelector<HTMLButtonElement>('[data-map-clear]')
      const results = map.querySelector<HTMLElement>('[data-map-results]')
      const treeEmpty = map.querySelector<HTMLElement>('[data-tree-empty]')
      const canvas = map.querySelector<HTMLElement>('[data-map-canvas]')
      const graphPosts = [...map.querySelectorAll<SVGElement>('.map-node.node--post')]
      const allPostIds = graphPosts.map((node) => node.dataset.postId ?? '').filter(Boolean)
      const nodeElements = [...map.querySelectorAll<SVGElement>('.map-node')]
      const edgeElements = [...map.querySelectorAll<SVGPathElement>('.map-edge')]
      let visiblePostIds = new Set(allPostIds)

      const inspectorType = map.querySelector<HTMLElement>('[data-inspector-type]')
      const inspectorTitle = map.querySelector<HTMLElement>('[data-inspector-title]')
      const inspectorDetail = map.querySelector<HTMLElement>('[data-inspector-detail]')
      const inspectorMeta = map.querySelector<HTMLElement>('[data-inspector-meta]')
      const inspectorLink = map.querySelector<HTMLAnchorElement>('[data-inspector-link]')
      const inspectorIndex = map.querySelector<HTMLElement>('[data-inspector-index]')

      const postIdsFor = (element: Element) =>
        (element.getAttribute('data-post-ids') ?? '').split(',').filter(Boolean)

      const setInspector = (id = 'root') => {
        const node = payload[id] ?? payload.root
        if (!node) return
        if (inspectorType) inspectorType.textContent = node.eyebrow
        if (inspectorTitle) inspectorTitle.textContent = node.label
        if (inspectorDetail) inspectorDetail.textContent = node.detail
        if (inspectorMeta) inspectorMeta.textContent = node.meta
        if (inspectorLink) {
          inspectorLink.href = node.href
          inspectorLink.firstChild!.textContent = node.kind === 'post' ? 'read article ' : 'explore node '
        }
        if (inspectorIndex) {
          const index = Math.max(0, Object.keys(payload).indexOf(id))
          inspectorIndex.textContent = `0x${index.toString(16).toUpperCase().padStart(2, '0')}`
        }
      }

      const activateNode = (id: string) => {
        if (!payload[id]) return
        const activeEdges = edgeElements.filter(
          (edge) => edge.dataset.edgeFrom === id || edge.dataset.edgeTo === id,
        )
        const related = new Set<string>()
        activeEdges.forEach((edge) => {
          if (edge.dataset.edgeFrom) related.add(edge.dataset.edgeFrom)
          if (edge.dataset.edgeTo) related.add(edge.dataset.edgeTo)
        })
        related.delete(id)

        map.classList.toggle('is-inspecting', id !== 'root')
        nodeElements.forEach((node) => {
          node.classList.toggle('is-active', node.dataset.nodeId === id)
          node.classList.toggle('is-related', related.has(node.dataset.nodeId ?? ''))
        })
        edgeElements.forEach((edge) => edge.classList.toggle('is-active', activeEdges.includes(edge)))
        setInspector(id)
      }

      const resetInspector = () => {
        map.classList.remove('is-inspecting')
        nodeElements.forEach((node) => node.classList.remove('is-active', 'is-related'))
        edgeElements.forEach((edge) => edge.classList.remove('is-active'))
        setInspector('root')
      }

      const referencedNode = (target: EventTarget | null) => {
        if (!(target instanceof Element)) return null
        const element = target.closest<HTMLElement>('[data-node-id], [data-map-node-ref]')
        if (!element || !map.contains(element)) return null
        return element.dataset.nodeId ?? element.dataset.mapNodeRef ?? null
      }

      map.addEventListener('pointerover', (event) => {
        const id = referencedNode(event.target)
        if (id) activateNode(id)
      })
      map.addEventListener('focusin', (event) => {
        const id = referencedNode(event.target)
        if (id) activateNode(id)
      })
      canvas?.addEventListener('pointerleave', () => {
        if (!canvas.contains(document.activeElement)) resetInspector()
      })
      map.addEventListener('focusout', (event) => {
        if (!(event.relatedTarget instanceof Node) || !map.contains(event.relatedTarget)) resetInspector()
      })

      const applyFilters = () => {
        const term = query?.value.trim().toLocaleLowerCase('zh-CN') ?? ''
        const selectedCategory = category?.value ?? ''
        visiblePostIds = new Set<string>()

        for (const node of graphPosts) {
          const matchesTerm = !term || (node.dataset.search ?? '').toLocaleLowerCase('zh-CN').includes(term)
          const matchesCategory = !selectedCategory || node.dataset.category === selectedCategory
          const visible = matchesTerm && matchesCategory
          const postId = node.dataset.postId
          if (visible && postId) visiblePostIds.add(postId)
        }

        map.querySelectorAll<HTMLElement>('[data-post-id]').forEach((element) => {
          const postId = element.dataset.postId ?? ''
          const visible = visiblePostIds.has(postId)
          if (element.matches('.tree-post')) element.hidden = !visible
          if (element.matches('.map-node')) {
            element.classList.toggle('is-filtered', !visible)
            element.setAttribute('aria-hidden', String(!visible))
            element.setAttribute('tabindex', visible ? '0' : '-1')
          }
        })

        edgeElements.forEach((edge) => {
          const edgePosts = postIdsFor(edge)
          edge.classList.toggle('is-filtered', edgePosts.length > 0 && !edgePosts.some((id) => visiblePostIds.has(id)))
        })
        nodeElements.forEach((node) => {
          if (node.dataset.nodeKind === 'root' || node.dataset.nodeKind === 'post') return
          const nodePosts = postIdsFor(node)
          const empty = nodePosts.length > 0 && !nodePosts.some((id) => visiblePostIds.has(id))
          node.classList.toggle('is-empty', empty)
          node.setAttribute('aria-hidden', String(empty))
          node.setAttribute('tabindex', empty ? '-1' : '0')
        })
        map.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
          const groupPosts = postIdsFor(group)
          const hidden = groupPosts.length > 0 && !groupPosts.some((id) => visiblePostIds.has(id))
          group.hidden = hidden
          if (!hidden && (term || selectedCategory) && group.matches('.tree-category')) {
            const details = group as HTMLDetailsElement
            details.open = true
          }
        })

        if (results) results.textContent = `${visiblePostIds.size} / ${allPostIds.length} articles visible`
        if (treeEmpty) treeEmpty.hidden = visiblePostIds.size > 0
        if (clear) clear.disabled = !term && !selectedCategory
        resetInspector()
      }

      query?.addEventListener('input', applyFilters)
      category?.addEventListener('change', applyFilters)
      clear?.addEventListener('click', () => {
        if (query) query.value = ''
        if (category) category.value = ''
        applyFilters()
        query?.focus()
      })
      setInspector('root')
    })
  }

  initKnowledgeMaps()
  document.addEventListener('astro:page-load', initKnowledgeMaps)
</script>

<style>
  .knowledge-map {
    --map-green: #52e198;
    --map-cyan: #65d9ed;
    --map-amber: #f2bd5b;
    --map-violet: #ae91ff;
    margin-top: 2rem;
  }

  .map-toolbar {
    display: grid;
    grid-template-columns: minmax(16rem, 1fr) minmax(11rem, 0.42fr) auto auto;
    gap: 0.85rem;
    align-items: end;
    padding: 1rem;
    border: 1px solid var(--color-line-bright);
    border-bottom: 0;
    background: color-mix(in srgb, var(--color-panel-strong) 92%, transparent);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .query-field,
  .category-field {
    min-width: 0;
  }

  .query-field > label,
  .category-field > label {
    display: block;
    margin-bottom: 0.38rem;
    color: var(--color-faint);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .query-control {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
    min-height: 2.65rem;
    padding: 0 0.7rem;
    border: 1px solid var(--color-line-bright);
    background: rgb(5 8 12 / 0.72);
  }

  .query-control:focus-within {
    border-color: color-mix(in srgb, var(--map-green) 62%, var(--color-line));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--map-green) 18%, transparent);
  }

  .query-control svg {
    width: 1rem;
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 1.4;
  }

  .query-control input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text-strong);
    font: 0.8rem/1.2 var(--font-mono);
  }

  .query-control input::placeholder {
    color: var(--color-faint);
  }

