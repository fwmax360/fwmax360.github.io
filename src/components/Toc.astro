---
import type { MarkdownHeading } from 'astro'
interface Props { headings: MarkdownHeading[]; variant?: 'rail' | 'mobile' }
const { headings, variant = 'rail' } = Astro.props
const items = headings.filter(h => h.depth >= 2 && h.depth <= 3)
const minDepth = items.length ? Math.min(...items.map(h => h.depth)) : 2
---
{items.length > 0 && <nav class:list={['toc', variant]} data-toc aria-label="本文目录">
  {variant === 'mobile' ? <details class="toc-fold">
    <summary class="toc-summary"><span>本文目录 <small>{items.length} 节</small></span><span class="toc-chevron" aria-hidden="true"></span></summary>
    <div class="toc-scroll"><ol class="toc-list">{items.map(h => <li style={`--indent:${h.depth - minDepth}`}><a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>{h.text}</a></li>)}</ol></div>
  </details> : <>
    <h2 class="toc-title">本文目录</h2>
    <div class="toc-scroll"><ol class="toc-list">{items.map(h => <li style={`--indent:${h.depth - minDepth}`}><a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>{h.text}</a></li>)}</ol></div>
  </>}
</nav>}
<style>
  .toc-title { margin-bottom: 1rem; color: var(--color-text); font-size: .8125rem; font-weight: 600; }
  .toc-scroll { position: relative; max-height: calc(100vh - var(--nav-offset) - 15rem); max-height: calc(100dvh - var(--nav-offset) - 15rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .toc-list { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--color-line); }
  .toc-list li { padding-left: calc(var(--indent) * .75rem); }
  .toc-link { display: block; padding: .5rem .75rem; border-left: 2px solid transparent; color: var(--color-dim); font-size: .8125rem; line-height: 1.6; text-decoration: none; transition: color 180ms, background-color 180ms; }
  .toc-link:hover { color: var(--color-text-strong); }
  .toc-link.active { border-left-color: var(--color-accent); color: var(--color-text-strong); font-weight: 550; background: transparent; }
  .toc.mobile { display: none; }
  .toc-fold { margin-bottom: 1.75rem; border: 0; border-radius: 0; background: transparent; }
  .toc-summary { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; gap: 1rem; padding: .75rem 0; color: var(--color-text); font-size: .8125rem; cursor: pointer; list-style: none; }
  .toc-summary::-webkit-details-marker { display: none; }
  .toc-summary small { margin-left: .75rem; color: var(--color-faint); font-size: .75rem; }
  .toc-chevron { width: .5rem; height: .5rem; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg); transition: transform 180ms; }
  .toc-fold[open] .toc-chevron { transform: rotate(225deg); }
  .toc-fold[open] .toc-summary { border-bottom: 0; }
  .toc-fold .toc-scroll { position: relative; max-height: 55vh; padding: .75rem 0; }
  .toc.mobile .toc-link { min-height: 44px; }
  @media (max-width: 1100px) { .toc.mobile { display: block; } }
  @media (prefers-reduced-motion: reduce) { .toc-link, .toc-chevron { transition: none; } }
</style>
<script>
  let cleanup: (() => void) | undefined
  function setupToc() {
    cleanup?.()
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')]
    if (!links.length) return
    const targets = [...new Set(links.map(link => link.dataset.tocLink!))].map(id => document.getElementById(id)).filter((heading): heading is HTMLElement => heading !== null)
    const controller = new AbortController()
    const { signal } = controller
    let frame = 0
    let active = ''
    const setActive = (id: string) => {
      if (active === id) return
      active = id
      links.forEach(link => {
        const selected = link.dataset.tocLink === id
        link.classList.toggle('active', selected)
        if (selected) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      })
      const railLink = links.find(link => link.dataset.tocLink === id && link.closest('.toc.rail'))
      const scroll = railLink?.closest<HTMLElement>('.toc-scroll')
      if (railLink && scroll) {
        const top = railLink.offsetTop
        if (top < scroll.scrollTop) scroll.scrollTop = top
        else if (top + railLink.offsetHeight > scroll.scrollTop + scroll.clientHeight) scroll.scrollTop = top + railLink.offsetHeight - scroll.clientHeight
      }
    }
    const sync = () => {
      frame = 0
      const scanLine = (document.querySelector('.nav')?.getBoundingClientRect().bottom ?? 60) + 100
      const current = [...targets].reverse().find(heading => heading.getBoundingClientRect().top <= scanLine) ?? targets[0]
      if (current) setActive(current.id)
    }
    const requestSync = () => { if (!frame) frame = requestAnimationFrame(sync) }
    window.addEventListener('scroll', requestSync, { passive: true, signal })
    window.addEventListener('resize', requestSync, { passive: true, signal })
    window.addEventListener('hashchange', requestSync, { signal })
    links.forEach(link => link.addEventListener('click', () => {
      setActive(link.dataset.tocLink!)
      const fold = link.closest<HTMLDetailsElement>('.toc-fold')
      if (fold) {
        fold.open = false
        const target = document.getElementById(link.dataset.tocLink!)
        target?.setAttribute('tabindex', '-1')
        target?.focus({ preventScroll: true })
      }
    }, { signal }))
    sync()
    cleanup = () => { controller.abort(); if (frame) cancelAnimationFrame(frame) }
  }
  setupToc()
  document.addEventListener('astro:page-load', setupToc)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
