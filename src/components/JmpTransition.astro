---
/**
 * 站内控制流转场。所有 /posts/ 链接会自动接入，也可显式声明更精确的语义：
 *
 * <a
 *   href="/posts/example/"
 *   data-jmp
 *   data-jmp-source="FEATURED_DOSSIER"
 *   data-jmp-address="0x00401000"
 *   data-jmp-trace="HOME / FEATURED / ARTICLE"
 *   data-jmp-title="目标文章标题"
 *   data-jmp-delay="520"
 * >…</a>
 *
 * 属性均可省略；地址、路径和标题会由目标链接自动推导。
 */
import '../styles/jmp-transition.css'
---

<div
  class="jmp-transition"
  data-jmp-overlay
  data-jmp-phase="idle"
  transition:persist="jmp-transition-overlay"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  aria-hidden="true"
>
  <div class="jmp-transition__veil" aria-hidden="true"></div>
  <div class="jmp-transition__scan" aria-hidden="true"></div>
  <svg
    class="jmp-transition__route"
    data-jmp-route
    viewBox="0 0 1 1"
    preserveAspectRatio="none"
    focusable="false"
    aria-hidden="true"
  >
    <path class="jmp-transition__route-shadow" data-jmp-route-path pathLength="1"></path>
    <path class="jmp-transition__route-line" data-jmp-route-path pathLength="1"></path>
  </svg>
  <div class="jmp-transition__callsite" aria-hidden="true">
    <i></i>
    <span class="mono">CALLSITE</span>
  </div>

  <div class="jmp-transition__packet">
    <header class="jmp-transition__head mono">
      <span class="jmp-transition__source">
        <i aria-hidden="true"></i>
        <span data-jmp-output="source">INTERNAL_ROUTE</span>
      </span>
      <span>CONTROL_TRANSFER / ARMED</span>
    </header>

    <div class="jmp-transition__instruction mono">
      <strong>JMP</strong>
      <span data-jmp-output="address">0x00000000</span>
    </div>

    <p class="jmp-transition__target" data-jmp-output="title">Loading target</p>

    <div class="jmp-transition__trace mono">
      <span>TRACE</span>
      <span data-jmp-output="trace">/ → /</span>
    </div>

    <footer class="jmp-transition__foot mono">
      <span data-jmp-output="path">/</span>
      <span data-jmp-output="status">BRANCH COMMITTED</span>
    </footer>

    <div class="jmp-transition__progress" aria-hidden="true"><i></i></div>
  </div>
</div>

<script>
  import { navigate, supportsViewTransitions } from 'astro:transitions/client'

  type JmpSingleton = {
    controller: AbortController
    navigationTimer: number
    resetTimer: number
    sequence: number
    navigating: boolean
  }

  type JmpLink = HTMLAnchorElement | SVGAElement
  type JmpPoint = { x: number; y: number }

  declare global {
    interface Window {
      __sleep4rJmpTransition?: JmpSingleton
    }
  }

  const LINK_SELECTOR = 'a[href]'
  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)'
  const DEFAULT_DELAY = 520
  const MIN_DELAY = 460
  const MAX_DELAY = 600
  const RESET_DELAY = 220

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value))

  const compact = (value: string | null | undefined, fallback: string, max = 180) => {
    const text = value?.replace(/\s+/g, ' ').trim()
    if (!text) return fallback
    return text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text
  }

  const linkFromEvent = (event: Event) => {
    const origin = event.composed ? event.composedPath()[0] : event.target
    return origin instanceof Element ? origin.closest<JmpLink>(LINK_SELECTOR) : null
  }

  const addressFor = (url: URL) => {
    // FNV-1a：只为稳定生成视觉地址，不暴露随机状态，也不会跨换页跳动。
    let hash = 0x811c9dc5
    const input = `${url.pathname}${url.search}${url.hash}`
    for (let index = 0; index < input.length; index += 1) {
      hash ^= input.charCodeAt(index)
      hash = Math.imul(hash, 0x01000193)
    }
    return `0x${(hash >>> 0).toString(16).toUpperCase().padStart(8, '0')}`
  }

  const targetUrl = (anchor: JmpLink) => {
    const href = anchor.getAttribute('href')
    if (!href) return null

    try {
      // SVG <a> 的 .href 是 SVGAnimatedString；始终以序列化 attribute 为准。
      return new URL(href, window.location.href)
    } catch {
      return null
    }
  }

  const isInternalPageLink = (anchor: JmpLink, url: URL) => {
    const target = anchor.getAttribute('target')
    if (
      anchor.hasAttribute('download') ||
      anchor.hasAttribute('data-astro-reload') ||
      (target && target.toLowerCase() !== '_self') ||
      url.origin !== window.location.origin ||
      (url.protocol !== 'http:' && url.protocol !== 'https:')
    ) {
      return false
    }

    const current = new URL(window.location.href)
    const sameDocument = url.pathname === current.pathname && url.search === current.search
    // 页内锚点和返回顶部仍交给浏览器 / ClientRouter 原生处理，不演出一次页面级 JMP。
    return !sameDocument
  }

  const isJmpDestination = (anchor: JmpLink, url: URL) =>
    anchor.hasAttribute('data-jmp') || url.pathname.startsWith('/posts/')

  const motionEnabled = () =>
    document.documentElement.dataset.motion === 'ready' &&
    !window.matchMedia(REDUCED_MOTION_QUERY).matches

  const output = (overlay: HTMLElement, field: string, value: string) => {
    const element = overlay.querySelector<HTMLElement>(`[data-jmp-output="${field}"]`)
    if (element) element.textContent = value
  }

  const inferredSource = () => {
    const section = window.location.pathname.split('/').filter(Boolean)[0] ?? 'home'
    return section === 'posts' ? 'ARTICLE / INLINE REFERENCE' : `${section} / ARTICLE ROUTE`
  }

  const overlayElement = () => document.querySelector<HTMLElement>('[data-jmp-overlay]')

  const positionRoute = (
    overlay: HTMLElement,
    anchor: JmpLink,
    pointer?: JmpPoint,
  ) => {
    const viewportWidth = document.documentElement.clientWidth
    const viewportHeight = document.documentElement.clientHeight
    const anchorRect = anchor.getBoundingClientRect()
    const originX = clamp(pointer?.x ?? anchorRect.left + anchorRect.width / 2, 18, viewportWidth - 18)
    const originY = clamp(pointer?.y ?? anchorRect.top + anchorRect.height / 2, 18, viewportHeight - 18)
    const packet = overlay.querySelector<HTMLElement>('.jmp-transition__packet')
    const packetRect = packet?.getBoundingClientRect()
    const targetX = packetRect
      ? originX <= packetRect.left + packetRect.width / 2
        ? packetRect.left
        : packetRect.right
      : viewportWidth / 2
    const targetY = packetRect
      ? clamp(originY, packetRect.top + 24, packetRect.bottom - 24)
      : viewportHeight / 2
    const elbowX = originX + (targetX - originX) * 0.52
    const path = `M ${originX.toFixed(2)} ${originY.toFixed(2)} H ${elbowX.toFixed(2)} V ${targetY.toFixed(2)} H ${targetX.toFixed(2)}`

    overlay.style.setProperty('--jmp-origin-x', `${originX}px`)
    overlay.style.setProperty('--jmp-origin-y', `${originY}px`)
    overlay.dataset.jmpOrigin = originX > viewportWidth * 0.68 ? 'right' : 'left'

    const route = overlay.querySelector<SVGSVGElement>('[data-jmp-route]')
    route?.setAttribute('viewBox', `0 0 ${viewportWidth} ${viewportHeight}`)
    overlay.querySelectorAll<SVGPathElement>('[data-jmp-route-path]').forEach((element) => {
      element.setAttribute('d', path)
    })
  }

  const clearRootState = () => {
    delete document.documentElement.dataset.jmp
  }

  const setIdle = (state: JmpSingleton) => {
    window.clearTimeout(state.resetTimer)
    state.resetTimer = 0
    state.navigating = false
    const overlay = overlayElement()
    if (!overlay) {
      clearRootState()
      return
    }

    overlay.dataset.jmpPhase = 'idle'
    overlay.setAttribute('aria-hidden', 'true')
    overlay.style.removeProperty('--jmp-duration')
    overlay.style.removeProperty('--jmp-origin-x')
    overlay.style.removeProperty('--jmp-origin-y')
    delete overlay.dataset.jmpMode
    delete overlay.dataset.jmpTrigger
    delete overlay.dataset.jmpOrigin
    clearRootState()
  }

  const showDeparture = (
    state: JmpSingleton,
    anchor: JmpLink,
    url: URL,
    trigger: 'pointer' | 'keyboard',
    pointer?: JmpPoint,
  ) => {
    const overlay = overlayElement()
    if (!overlay) return false

    const context = anchor.closest<HTMLElement>('[data-jmp-context]')
    const source = compact(
      anchor.dataset.jmpSource ?? anchor.dataset.jmpKind ?? context?.dataset.jmpContext,
      inferredSource(),
      42,
    ).toUpperCase()
    const address = compact(anchor.dataset.jmpAddress, addressFor(url), 32)
    const from = `${window.location.pathname}${window.location.search}` || '/'
    const path = `${url.pathname}${url.search}${url.hash}` || '/'
    const trace = compact(anchor.dataset.jmpTrace, `${from}  ›  ${path}`, 150)
    const title = compact(
      anchor.dataset.jmpTitle ?? anchor.getAttribute('aria-label') ?? anchor.textContent,
      path,
      120,
    )
    const requestedDelay = Number.parseFloat(anchor.dataset.jmpDelay ?? '')
    const delay = Number.isFinite(requestedDelay)
      ? clamp(requestedDelay, MIN_DELAY, MAX_DELAY)
      : DEFAULT_DELAY

    window.clearTimeout(state.navigationTimer)
    window.clearTimeout(state.resetTimer)
    state.sequence += 1
    const sequence = state.sequence
    state.navigating = false

    output(overlay, 'source', source)
    output(overlay, 'address', address)
    output(overlay, 'trace', trace)
    output(overlay, 'title', title)
    output(overlay, 'path', path)
    output(overlay, 'status', 'BRANCH COMMITTED')

    overlay.dataset.jmpPhase = 'idle'
    overlay.dataset.jmpMode = supportsViewTransitions ? 'view' : 'fade'
    overlay.dataset.jmpTrigger = trigger
    overlay.style.setProperty('--jmp-duration', `${delay}ms`)
    overlay.setAttribute('aria-hidden', 'false')
    positionRoute(overlay, anchor, pointer)
    // 允许用户在离场前改选另一条链接时重新播放，而不复制 overlay 实例。
    void overlay.offsetWidth
    overlay.dataset.jmpPhase = 'depart'
    document.documentElement.dataset.jmp = 'depart'

    document.dispatchEvent(
      new CustomEvent('sleep4r:jmpstart', {
        detail: { source, address, trace, title, href: url.href, trigger, delay },
      }),
    )

    state.navigationTimer = window.setTimeout(() => {
      if (sequence !== state.sequence) return
      state.navigationTimer = 0
      state.navigating = true
      output(overlay, 'status', 'TRANSFER IN PROGRESS')
      void navigate(url.href, {
        history: anchor.dataset.astroHistory === 'replace' ? 'replace' : 'auto',
        sourceElement: anchor,
      }).catch(() => window.location.assign(url.href))
    }, delay)

    return true
  }

  const installJmpTransition = () => {
    const existing = window.__sleep4rJmpTransition
    if (existing && !existing.controller.signal.aborted) return

    const controller = new AbortController()
    const state: JmpSingleton = {
      controller,
      navigationTimer: 0,
      resetTimer: 0,
      sequence: 0,
      navigating: false,
    }
    window.__sleep4rJmpTransition = state

    const onClick = (event: MouseEvent) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey
      ) {
        return
      }

      const anchor = linkFromEvent(event)
      if (!anchor) return
      const url = targetUrl(anchor)
      if (
        !url ||
        !isJmpDestination(anchor, url) ||
        !isInternalPageLink(anchor, url) ||
        !motionEnabled()
      ) return

      event.preventDefault()
      const trigger = event.detail === 0 ? 'keyboard' : 'pointer'
      showDeparture(
        state,
        anchor,
        url,
        trigger,
        trigger === 'pointer' ? { x: event.clientX, y: event.clientY } : undefined,
      )
    }

    const onKeydown = (event: KeyboardEvent) => {
      if (
        event.defaultPrevented ||
        event.repeat ||
        event.key !== 'Enter' ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey
      ) {
        return
      }

      const anchor = linkFromEvent(event)
      if (!anchor) return
      const url = targetUrl(anchor)
      if (
        !url ||
        !isJmpDestination(anchor, url) ||
        !isInternalPageLink(anchor, url) ||
        !motionEnabled()
      ) return

      // 阻止 Enter 随后再合成一枚 click；焦点始终留在原链接，overlay 不接管键盘。
      event.preventDefault()
      showDeparture(state, anchor, url, 'keyboard')
    }

    const onAfterSwap = () => {
      const overlay = overlayElement()
      if (!overlay || (!state.navigating && overlay.dataset.jmpPhase !== 'depart')) return

      window.clearTimeout(state.navigationTimer)
      state.navigationTimer = 0
      state.navigating = false
      overlay.dataset.jmpPhase = 'arrive'
      output(overlay, 'status', 'TARGET LOCKED')
      overlay.setAttribute('aria-hidden', 'true')
      document.documentElement.dataset.jmp = 'arrive'

      state.resetTimer = window.setTimeout(() => setIdle(state), RESET_DELAY)
      document.dispatchEvent(new CustomEvent('sleep4r:jmpend'))
    }

    const dispose = () => {
      controller.abort()
      window.clearTimeout(state.navigationTimer)
      window.clearTimeout(state.resetTimer)
      state.navigationTimer = 0
      state.resetTimer = 0
      if (window.__sleep4rJmpTransition === state) delete window.__sleep4rJmpTransition
    }

    const onPageHide = (event: PageTransitionEvent) => {
      if (event.persisted) {
        window.clearTimeout(state.navigationTimer)
        state.navigationTimer = 0
        state.sequence += 1
        setIdle(state)
        return
      }
      dispose()
    }

    const onPageShow = (event: PageTransitionEvent) => {
      if (event.persisted) setIdle(state)
    }

    document.addEventListener('click', onClick, { capture: true, signal: controller.signal })
    document.addEventListener('keydown', onKeydown, { capture: true, signal: controller.signal })
    document.addEventListener('astro:after-swap', onAfterSwap, { signal: controller.signal })
    window.addEventListener('pagehide', onPageHide, { signal: controller.signal })
    window.addEventListener('pageshow', onPageShow, { signal: controller.signal })

    const overlay = overlayElement()
    if (overlay?.dataset.jmpPhase !== 'depart' && overlay?.dataset.jmpPhase !== 'arrive') {
      setIdle(state)
    }
  }

  installJmpTransition()
</script>
