.silicon-editorial .ambient-field i:nth-child(2){left:45%;top:20%;background:radial-gradient(ellipse,#6a647136,transparent 65%);animation-duration:23s;animation-delay:-9s}
.silicon-editorial .ambient-field span{position:absolute;inset:0;background:linear-gradient(115deg,transparent 32%,#c4d2db0b 47%,transparent 62%);animation:studio-sweep 24s ease-in-out infinite alternate;animation-play-state:paused}
