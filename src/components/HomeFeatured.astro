---
import type { Post } from '../lib/posts'
import { categoryUrl, formatDate, postUrl, readingStats, tagUrl } from '../lib/posts'
import { coverSvgUrl } from '../lib/covers'
import { getSeriesVisual } from '../lib/seriesVisual'

interface Props {
  post: Post
}

const { post } = Astro.props
const { title, description, pubDate, tags, category, series } = post.data
const stats = readingStats(post.body ?? '')
const seriesVisual = series ? getSeriesVisual(series) : null
const featuredStyle = seriesVisual
  ? `--featured-tone:${seriesVisual.palette.accent};--featured-glow:${seriesVisual.palette.glow}`
  : undefined
---

<section
  class="featured"
  aria-labelledby="featured-title"
  style={featuredStyle}
  data-reveal="section"
  data-spotlight
>
  <header class="featured-head mono">
    <span class="featured-kicker"><i aria-hidden="true"></i> featured intelligence</span>
    <span class="featured-index">LATEST / 0x00</span>
  </header>

  <article class="featured-card" data-tilt="2.5">
    <div class="featured-copy" data-parallax="0.06">
      <div class="featured-meta mono">
        <a href={categoryUrl(category)} class="featured-category">{category}</a>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{stats.minutes} min read</span>
      </div>

      <h2 id="featured-title" class="featured-title">
        <a
          href={postUrl(post)}
          data-jmp
          data-jmp-source="HOME / FEATURED"
          data-jmp-trace="HOME › FEATURED › ARTICLE"
          data-jmp-title={title}
        >{title}</a>
      </h2>
      <p class="featured-desc">{description}</p>

      {series && (
        <p class="featured-series mono">
          <span>series</span>
          {series}
        </p>
      )}
    </div>

    <!-- col-side 同时作为 Live2D 的避让标记，模型不会压住主视觉。 -->
    <a
      href={postUrl(post)}
      class="featured-visual col-side"
      aria-label={`阅读最新文章：${title}`}
      data-no-viewer
      data-tilt="4"
      data-jmp
      data-jmp-source="HOME / FEATURED SPECIMEN"
      data-jmp-trace="HOME › FEATURED › ARTICLE"
      data-jmp-title={title}
      transition:name={`post-cover-${post.id}`}
    >
      <span class="visual-frame">
        <img
          src={coverSvgUrl(post)}
          width="1200"
          height="630"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-no-viewer
          data-parallax="0.10"
        />
        <span class="visual-depth" aria-hidden="true" data-parallax="0.12"></span>
        <span class="visual-reticle" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="visual-scan" aria-hidden="true"></span>
      </span>
      <span class="visual-caption mono" aria-hidden="true">
        <span>VECTOR / 1200×630</span>
        <span class="visual-indexed"><i></i>{String(stats.words).padStart(4, '0')} WORDS · INDEXED</span>
      </span>
    </a>

    <footer class="featured-foot">
      <div class="featured-tags mono" aria-label="文章标签">
        {tags.slice(0, 4).map((tag) => <a href={tagUrl(tag)}>#{tag}</a>)}
      </div>
      <a
        href={postUrl(post)}
        class="featured-open mono"
        data-jmp
        data-jmp-source="HOME / FEATURED ANALYSIS"
        data-jmp-trace="HOME › FEATURED › ARTICLE"
        data-jmp-title={title}
      >
        open analysis <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </article>
</section>

<style>
  .featured {
    margin-top: 1.5rem;
  }

  .featured-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
    color: var(--color-faint);
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .featured-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-dim);
  }

  .featured-kicker i {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--featured-tone, var(--color-accent));
    box-shadow: 0 0 0.8rem color-mix(in srgb, var(--featured-tone, var(--color-accent)) 72%, transparent);
  }

  :global(html[data-motion='ready']) .featured-kicker i {
    animation: featured-pulse 2.2s ease-out infinite;
  }

  @keyframes featured-pulse {
    55% { box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--featured-tone, var(--color-accent)) 0%, transparent); }
  }

  .featured-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(18rem, 0.86fr) minmax(24rem, 1.14fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    padding: clamp(1.35rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line-bright);
    border-left: 2px solid var(--featured-tone, var(--color-accent));
    background:
      linear-gradient(110deg, color-mix(in srgb, #111820 92%, transparent), color-mix(in srgb, #0b1117 74%, transparent)),
      var(--color-bg-soft);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      0 1.6rem 4rem -3rem rgb(0 0 0 / 0.9),
      inset 0 1px rgb(255 255 255 / 0.025);
  }

  .featured-card::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 28rem;
    height: 28rem;
    top: -20rem;
    right: -6rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--featured-glow, color-mix(in srgb, var(--color-accent) 13%, transparent)), transparent 66%);
  }

  .featured-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: linear-gradient(90deg, transparent 0 49.8%, rgb(255 255 255 / 0.025) 50%, transparent 50.2%);
    background-size: 4rem 100%;
    -webkit-mask-image: linear-gradient(to left, #000, transparent 62%);
    mask-image: linear-gradient(to left, #000, transparent 62%);
  }

  .featured-copy {
    min-width: 0;
    align-self: center;
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-faint);
    font-size: 0.72rem;
  }

  .featured-category {
    color: var(--featured-tone, var(--color-accent));
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-category:hover {
    color: var(--color-text-strong);
  }

  .featured-title {
    max-width: 46rem;
    margin-top: 0.8rem;
    font-size: clamp(1.65rem, 3.4vw, 2.55rem);
    font-weight: 620;
    line-height: 1.25;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .featured-title a {
    color: var(--color-text-strong);
    text-decoration: none;
    transition: color 0.18s;
  }

  .featured-title a:hover {
    color: var(--featured-tone, var(--color-accent));
  }

  .featured-desc {
    max-width: 44rem;
    margin-top: 0.9rem;
    color: var(--color-dim);
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .featured-series {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    color: var(--featured-tone, var(--color-warn));
    font-size: 0.72rem;
  }

  .featured-series span {
    padding: 0.08rem 0.32rem;
    border: 1px solid color-mix(in srgb, var(--featured-tone, var(--color-warn)) 42%, transparent);
    color: var(--featured-tone, var(--color-warn));
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured-visual {
    align-self: center;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .visual-frame {
    position: relative;
    display: block;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--featured-tone, var(--color-accent)) 38%, var(--color-line-bright));
    background: var(--color-bg);
    box-shadow:
      0 1.25rem 2.75rem -1.8rem rgb(0 0 0 / 0.95),
      0 0 2.5rem -1.8rem var(--featured-tone, var(--color-accent));
  }

  .visual-frame::before,
  .visual-frame::after {
    content: '';
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .visual-frame::before {
    inset: 0;
    border: 1px solid rgb(255 255 255 / 0.035);
    box-shadow: inset 0 0 2rem rgb(0 0 0 / 0.18);
  }

  .visual-frame::after {
    right: 0;
    bottom: 0;
    width: 3rem;
    height: 3rem;
    border-right: 1px solid var(--featured-tone, var(--color-accent));
    border-bottom: 1px solid var(--featured-tone, var(--color-accent));
    opacity: 0.8;
  }

  .visual-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }

  .visual-depth {
    position: absolute;
    z-index: 1;
    inset: -15%;
    pointer-events: none;
    background:
      radial-gradient(circle at 72% 28%, color-mix(in srgb, var(--featured-tone, var(--color-accent)) 14%, transparent), transparent 22%),
      linear-gradient(112deg, transparent 35%, rgb(255 255 255 / 0.045) 48%, transparent 61%);
    mix-blend-mode: screen;
  }

  .visual-reticle {
    position: absolute;
    z-index: 3;
    inset: 0.7rem;
    pointer-events: none;
  }

  .visual-reticle i {
    position: absolute;
    width: 0.72rem;
    height: 0.72rem;
    opacity: 0.62;
  }

  .visual-reticle i:nth-child(1) { inset: 0 auto auto 0; border-top: 1px solid var(--featured-tone, var(--color-accent)); border-left: 1px solid var(--featured-tone, var(--color-accent)); }
  .visual-reticle i:nth-child(2) { inset: 0 0 auto auto; border-top: 1px solid var(--featured-tone, var(--color-accent)); border-right: 1px solid var(--featured-tone, var(--color-accent)); }
  .visual-reticle i:nth-child(3) { inset: auto auto 0 0; border-bottom: 1px solid var(--featured-tone, var(--color-accent)); border-left: 1px solid var(--featured-tone, var(--color-accent)); }
  .visual-reticle i:nth-child(4) { inset: auto 0 0 auto; border-bottom: 1px solid var(--featured-tone, var(--color-accent)); border-right: 1px solid var(--featured-tone, var(--color-accent)); }

  .visual-scan {
    position: absolute;
    z-index: 2;
    inset: -0.15rem 0 auto;
    height: 0.15rem;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 3%, var(--featured-tone, var(--color-accent)) 50%, transparent 97%);
    opacity: 0;
    filter: drop-shadow(0 0 0.4rem var(--featured-tone, var(--color-accent)));
  }

  :global(html[data-motion='ready']) .visual-scan {
    opacity: 0.42;
    animation: featured-scan 5.6s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }

  :global(html[data-motion='ready']) .visual-depth {
    animation: featured-depth 7s ease-in-out infinite alternate;
  }

  :global(html[data-motion='ready']) .visual-reticle i {
    animation: reticle-lock 3.6s ease-in-out infinite;
  }

  @keyframes featured-scan {
    0%, 12% { top: -0.15rem; opacity: 0; }
    20% { opacity: 0.44; }
    72% { top: calc(100% + 0.15rem); opacity: 0.35; }
    73%, 100% { top: calc(100% + 0.15rem); opacity: 0; }
  }

  @keyframes featured-depth {
    to { opacity: 0.55; transform: translate3d(-1.2%, 0.8%, 0) scale(1.025); }
  }

  @keyframes reticle-lock {
    0%, 100% { opacity: 0.4; }
    45%, 55% { opacity: 0.9; transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -1px, 0); }
  }

  .featured-visual:hover .visual-frame img {
    filter: brightness(1.06) saturate(1.04);
    transform: scale(1.012);
  }

  .featured-visual:focus-visible {
    outline: 2px solid var(--featured-tone, var(--color-accent));
    outline-offset: 5px;
  }

  .visual-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.55rem;
    color: var(--color-faint);
    font-size: 0.57rem;
    letter-spacing: 0.08em;
  }

  .visual-caption span:last-child {
    color: color-mix(in srgb, var(--featured-tone, var(--color-accent)) 68%, var(--color-dim));
    text-align: right;
  }

  .visual-indexed {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .visual-indexed i {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--featured-tone, var(--color-accent));
    box-shadow: 0 0 0.45rem var(--featured-tone, var(--color-accent));
  }

  :global(html[data-motion='ready']) .visual-indexed i {
    animation: indexed-blink 1.8s steps(2, end) infinite;
  }

  @keyframes indexed-blink { 50% { opacity: 0.25; } }

  .featured-foot {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .featured-tags a {
    color: var(--color-faint);
    font-size: 0.7rem;
    text-decoration: none;
    transition: color 0.16s;
  }

  .featured-tags a:hover {
    color: var(--featured-tone, var(--accent, var(--color-accent)));
  }

  .featured-open {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-line-bright);
    color: var(--color-text);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color 0.18s,
      border-color 0.18s,
      background 0.18s;
  }

  .featured-open:hover {
    border-color: color-mix(in srgb, var(--featured-tone, var(--color-accent)) 58%, var(--color-line));
    background: color-mix(in srgb, var(--featured-tone, var(--color-accent)) 8%, transparent);
    color: var(--featured-tone, var(--color-accent));
  }

  @media (max-width: 940px) {
    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-visual {
      width: 100%;
    }

    .featured-foot {
      grid-column: auto;
    }
  }

  @media (max-width: 720px) {
    .featured {
      margin-top: 1.1rem;
    }

    .featured-index {
      display: none;
    }

    .featured-card {
      gap: 1.2rem;
      padding: 1.25rem 1.1rem;
    }

    .featured-title {
      font-size: clamp(1.5rem, 8vw, 2rem);
      line-height: 1.24;
    }

    .featured-desc {
      font-size: 0.9rem;
      line-height: 1.72;
    }

    .visual-caption {
      margin-top: 0.45rem;
      font-size: 0.52rem;
    }

    .visual-caption span:first-child {
      display: none;
    }

    .visual-caption span:last-child {
      margin-left: auto;
    }

    .featured-tags {
      gap: 0.5rem;
    }

    .featured-tags a:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .featured-meta span[aria-hidden='true'],
    .featured-meta span:last-child {
      display: none;
    }

    .featured-foot {
      align-items: stretch;
      flex-direction: column;
    }

    .featured-open {
      justify-content: space-between;
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-kicker i,
    .visual-scan,
    .visual-depth,
    .visual-reticle i,
    .visual-indexed i {
      animation: none !important;
      transform: none !important;
    }
    .visual-scan { display: none; }
  }

  :global(html[data-motion='off']) .featured-kicker i,
  :global(html[data-motion='off']) .visual-depth,
  :global(html[data-motion='off']) .visual-reticle i,
  :global(html[data-motion='off']) .visual-indexed i {
    animation: none !important;
    transform: none !important;
  }

  :global(html[data-motion='off']) .visual-scan { display: none; }
</style>
