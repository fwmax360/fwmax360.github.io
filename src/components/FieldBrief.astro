---
import { categoryUrl, formatDate, tagUrl } from '../lib/posts'
import { seriesUrl } from '../lib/series'

interface BriefHeading {
  depth: number
  slug: string
  text: string
}

interface Props {
  description: string
  category: string
  tags: string[]
  publishedAt: Date
  updatedAt?: Date
  series?: string
  order?: number
  words: number
  minutes: number
  headings: BriefHeading[]
  accent?: string
}

const {
  description,
  category,
  tags,
  publishedAt,
  updatedAt,
  series,
  order,
  words,
  minutes,
  headings,
  accent,
} = Astro.props

const verificationHeadings = headings.filter((heading) =>
  /(验证|校验|测试|自检|检测|证据|结果|复现)/i.test(heading.text),
)
const depths = new Map<number, number>()
for (const heading of headings) depths.set(heading.depth, (depths.get(heading.depth) ?? 0) + 1)
const outline = [...depths.entries()]
  .sort(([a], [b]) => a - b)
  .map(([depth, count]) => `H${depth} ${count}`)
  .join(' / ')
const maintenance = updatedAt ? `revised ${formatDate(updatedAt)}` : 'published snapshot'
const scopeLabel = series ? `${series} · CH ${String(order ?? 1).padStart(2, '0')}` : 'standalone record'
const style = accent ? `--brief-accent:${accent}` : undefined
---

<section
  class="field-brief"
  aria-labelledby="field-brief-title"
  style={style}
  data-pagefind-ignore
  data-reveal
  data-spotlight
>
  <span class="brief-scan" aria-hidden="true"></span>
  <span class="brief-radar" aria-hidden="true"><i></i></span>
  <header class="brief-head">
    <div>
      <p class="brief-code mono">FIELD_BRIEF / PRE-READ</p>
      <h2 id="field-brief-title">阅读任务简报</h2>
    </div>
    <span class="brief-state mono"><i aria-hidden="true"></i>{maintenance}</span>
  </header>

  <div class="brief-grid" data-stagger data-reveal-stagger="45">
    <section class="brief-objective" aria-labelledby="brief-objective-label" data-reveal data-parallax="0.04">
      <h3 id="brief-objective-label" class="brief-label mono">objective</h3>
      <p>{description}</p>
      <div class="brief-read mono" aria-label={`${words} 字，预计阅读 ${minutes} 分钟`}>
        <span><b data-count-up>{words}</b> chars</span>
        <span><b data-count-up>{minutes}</b> min</span>
      </div>
    </section>

    <dl class="brief-facts">
      <div data-reveal data-tilt="2">
        <dt class="mono">scope</dt>
        <dd>
          <a href={categoryUrl(category)}>{category}</a>
          <span aria-hidden="true">/</span>
          {series ? <a href={seriesUrl(series)}>{scopeLabel}</a> : <span>{scopeLabel}</span>}
        </dd>
      </div>
      <div data-reveal data-tilt="2">
        <dt class="mono">record</dt>
        <dd><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time></dd>
      </div>
      <div data-reveal data-tilt="2">
        <dt class="mono">validation</dt>
        <dd>
          {
            verificationHeadings.length > 0
              ? `${verificationHeadings.length} 个验证相关章节`
              : '未单列验证章节'
          }
        </dd>
      </div>
      <div data-reveal data-tilt="2">
        <dt class="mono">outline</dt>
        <dd>{headings.length} sections{outline && <small>{outline}</small>}</dd>
      </div>
    </dl>
  </div>

  <div class="brief-signals">
    <span class="brief-label mono">signals</span>
    <div class="signal-list mono" aria-label="文章信号标签" data-stagger data-reveal-stagger="35">
      {tags.map((tag) => <a href={tagUrl(tag)} data-reveal>#{tag}</a>)}
    </div>
  </div>
</section>

<style>
  .field-brief {
    --brief-accent: var(--color-accent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: clamp(2.6rem, 6vw, 4.25rem);
    border: 1px solid var(--color-line);
    border-top-color: color-mix(in srgb, var(--brief-accent) 45%, var(--color-line));
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--brief-accent) 5%, transparent), transparent 45%),
      color-mix(in srgb, var(--color-bg-soft) 86%, transparent);
    box-shadow:
      inset 2px 0 0 color-mix(in srgb, var(--brief-accent) 55%, transparent),
      0 1.5rem 3rem -2.8rem rgb(0 0 0 / 0.9);
  }

  .field-brief::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.022) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000);
    mask-image: linear-gradient(90deg, transparent 30%, #000);
  }

  .brief-scan {
    position: absolute;
    z-index: 0;
    inset: -35% 0 auto;
    height: 30%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in srgb, var(--brief-accent) 7%, transparent) 70%,
      color-mix(in srgb, var(--brief-accent) 32%, transparent)
    );
    opacity: 0;
    transform: translateY(0);
  }

  html[data-motion='ready'] .field-brief[data-reveal-state='visible'] .brief-scan {
    animation: brief-scan 3.8s 0.25s var(--ease-out-expo) both;
  }

  .brief-radar {
    position: absolute;
    z-index: 0;
    top: 0.85rem;
    right: 1rem;
    width: 2.6rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--brief-accent) 13%, transparent);
    border-radius: 50%;
    opacity: 0.32;
    pointer-events: none;
  }

  .brief-radar::before,
  .brief-radar::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px solid color-mix(in srgb, var(--brief-accent) 18%, transparent);
  }

  .brief-radar::after {
    transform: rotate(90deg);
  }

  .brief-radar i {
    position: absolute;
    inset: 50% 50% 0 0;
    border-right: 1px solid color-mix(in srgb, var(--brief-accent) 42%, transparent);
    transform-origin: 100% 0;
  }

  html[data-motion='ready'] .field-brief[data-reveal-state='visible'] .brief-radar i {
    animation: brief-radar 4.8s linear infinite;
  }

  @keyframes brief-scan {
    0% { opacity: 0; transform: translateY(0); }
    18% { opacity: 0.75; }
    88% { opacity: 0.34; }
    100% { opacity: 0; transform: translateY(440%); }
  }

  @keyframes brief-radar {
    to { transform: rotate(1turn); }
  }

  .brief-head,
  .brief-grid,
  .brief-signals {
    position: relative;
    z-index: 1;
  }

  .brief-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.05rem;
    border-bottom: 1px solid var(--color-line);
  }

  .brief-code,
  .brief-label,
  .brief-facts dt {
    color: color-mix(in srgb, var(--brief-accent) 72%, var(--color-dim));
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .brief-head h2 {
    margin-top: 0.12rem;
    color: var(--color-text-strong);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .brief-state {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--color-faint);
    font-size: 0.59rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brief-state i {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--brief-accent);
    box-shadow: 0 0 0.7rem color-mix(in srgb, var(--brief-accent) 70%, transparent);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(16rem, 0.88fr);
  }

  .brief-objective {
    min-width: 0;
    padding: 1.15rem 1.05rem;
    border-right: 1px solid var(--color-line);
  }

  .brief-objective > p {
    margin-top: 0.48rem;
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .brief-read {
    display: flex;
    gap: 0.9rem;
    margin-top: 0.85rem;
    color: var(--color-faint);
    font-size: 0.59rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brief-read b {
    color: color-mix(in srgb, var(--brief-accent) 75%, var(--color-text));
    font: inherit;
    font-variant-numeric: tabular-nums;
  }

  .brief-read span + span::before {
    content: '·';
    margin-right: 0.9rem;
    color: var(--color-line-bright);
  }

  .brief-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
  }

  .brief-facts > div {
    min-width: 0;
    padding: 0.72rem 0.82rem;
  }

  .brief-facts > div:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .brief-facts > div:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }

  .brief-facts dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem 0.4rem;
    margin: 0.24rem 0 0;
    color: var(--color-dim);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .brief-facts dd small {
    flex-basis: 100%;
    color: var(--color-faint);
    font: 0.56rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .brief-facts a {
    color: var(--color-dim);
    text-decoration: none;
  }

  .brief-facts a:hover,
  .brief-facts a:focus-visible {
    color: var(--brief-accent);
  }

  .brief-signals {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 2.8rem;
    padding: 0.6rem 1.05rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 42%, transparent);
  }

  .signal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
  }

  .signal-list a {
    color: var(--color-faint);
    font-size: 0.62rem;
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .signal-list a:hover,
  .signal-list a:focus-visible {
    color: var(--brief-accent);
  }

  @media (max-width: 680px) {
    .brief-radar {
      display: none;
    }
    .brief-head {
      align-items: flex-start;
    }

    .brief-state {
      max-width: 8.5rem;
      justify-content: flex-end;
      text-align: right;
    }

    .brief-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .brief-objective {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .brief-signals {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .brief-head,
    .brief-objective,
    .brief-signals {
      padding-inline: 0.85rem;
    }

    .brief-facts > div {
      padding-inline: 0.7rem;
    }
  }

  html[data-motion='off'] .brief-scan,
  html[data-motion='off'] .brief-radar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .brief-scan,
    .brief-radar {
      display: none;
    }
  }
</style>
