---
/**
 * 文章页阅读遥测：ScrollMiku 负责全宽细轨，这里补充百分比、章节位置与当前章节。
 * 内容完全由页面现有 h2/h3 派生，ClientRouter 换页时会重新绑定。
 */
---

<aside class="reading-telemetry mono" data-reading-telemetry data-pagefind-ignore aria-label="阅读进度">
  <span class="telemetry-rail" aria-hidden="true">
    <span class="telemetry-fill"></span>
    <span class="telemetry-node"></span>
  </span>
  <span class="telemetry-copy">
    <span class="telemetry-head" aria-hidden="true">
      <span class="telemetry-kicker">READING_STREAM</span>
      <strong class="telemetry-state" data-reading-state>TRACE ARMED</strong>
    </span>
    <span class="telemetry-section" data-reading-section>opening record</span>
    <span class="telemetry-registers" aria-hidden="true">
      <span class="telemetry-register">
        <i>PC</i>
        <b data-reading-pc>0x--------</b>
      </span>
      <span class="telemetry-register">
        <i>BLOCK</i>
        <b data-reading-block>00 / 00</b>
      </span>
    </span>
    <span class="telemetry-meta">
      <span data-reading-index>00 / 00</span>
      <strong data-reading-percent>00%</strong>
    </span>
  </span>
  <span class="trace-announcer" data-reading-announcer role="status" aria-live="polite" aria-atomic="true"></span>
</aside>

<style>
  .reading-telemetry {
    --reading-progress: 0;
    position: fixed;
    z-index: 42;
    /* 为 ScrollMiku 的 56px 跑动精灵留出垂直空间，避免 100% 时在右上角相撞。 */
    top: calc(var(--nav-offset, var(--nav-h)) + 4.4rem);
    right: max(0.8rem, calc((100vw - var(--container-wide)) / 2 - 7.6rem));
    display: grid;
    grid-template-columns: 2px minmax(0, 7.2rem);
    gap: 0.65rem;
    min-height: 10.5rem;
    pointer-events: none;
    color: var(--color-faint);
    opacity: 0;
    transform: translate3d(8px, 0, 0);
    transition:
      opacity 0.42s ease,
      transform 0.52s var(--ease-out-expo);
  }

  .reading-telemetry[data-ready='true'] {
    opacity: 0.72;
    transform: none;
  }

  .reading-telemetry[data-active='true'] {
    opacity: 0.92;
  }

  .telemetry-rail {
    position: relative;
    display: block;
    overflow: visible;
    background: var(--color-line);
  }

  .telemetry-fill {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--reading-progress) * 1%);
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-accent));
    box-shadow: 0 0 0.85rem color-mix(in srgb, var(--color-accent) 25%, transparent);
    transition: height 0.16s linear;
  }

  .telemetry-node {
    position: absolute;
    top: calc(var(--reading-progress) * 1%);
    left: 50%;
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: 0 0 0.7rem color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: translate(-50%, -50%);
    transition: top 0.16s linear;
  }

  .telemetry-copy {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding-top: 0.05rem;
  }

  .telemetry-head {
    display: grid;
    gap: 0.18rem;
  }

  .telemetry-kicker {
    color: color-mix(in srgb, var(--color-accent) 68%, var(--color-dim));
    font-size: 0.5rem;
    letter-spacing: 0.14em;
  }

  .telemetry-state {
    color: var(--color-faint);
    font-size: 0.49rem;
    font-weight: 560;
    letter-spacing: 0.055em;
    line-height: 1.35;
    white-space: nowrap;
    transition: color 0.18s ease, text-shadow 0.18s ease;
  }

  .telemetry-section {
    display: -webkit-box;
    margin-top: 0.52rem;
    overflow: hidden;
    color: var(--color-dim);
    font: 550 0.65rem/1.5 var(--font-sans);
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .telemetry-registers {
    display: grid;
    gap: 0.26rem;
    margin-top: 0.58rem;
    padding-block: 0.42rem;
    border-block: 1px dashed color-mix(in srgb, var(--color-line) 78%, transparent);
  }

  .telemetry-register {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem;
    min-width: 0;
  }

  .telemetry-register i {
    color: var(--color-faint);
    font-size: 0.46rem;
    font-style: normal;
    letter-spacing: 0.1em;
  }

  .telemetry-register b {
    color: color-mix(in srgb, var(--color-accent) 68%, var(--color-dim));
    font-size: 0.51rem;
    font-weight: 540;
    letter-spacing: 0.025em;
    white-space: nowrap;
    transition: color 0.18s ease, text-shadow 0.18s ease;
  }

  .telemetry-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
  }

  .telemetry-meta strong {
    color: var(--color-accent);
    font-size: 0.64rem;
    font-weight: 600;
  }

  .reading-telemetry[data-complete='true'] .telemetry-node {
    background: var(--color-accent);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent),
      0 0 0.8rem color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .reading-telemetry[data-breakpoint='true'] .telemetry-state,
  .reading-telemetry[data-breakpoint='true'] .telemetry-register b {
    color: var(--color-warn);
    text-shadow: 0 0 0.65rem color-mix(in srgb, var(--color-warn) 38%, transparent);
  }

  html[data-motion='ready'] .reading-telemetry[data-breakpoint='true'] .telemetry-copy {
    animation: breakpoint-lock 0.72s var(--ease-out-expo) both;
  }

  html[data-motion='ready'] .reading-telemetry[data-breakpoint='true'] .telemetry-node {
    animation: breakpoint-node 0.72s var(--ease-out-expo) both;
  }

  .reading-telemetry[data-complete='true'] .telemetry-state,
  .reading-telemetry[data-complete='true'] .telemetry-register b {
    color: var(--color-accent);
    text-shadow: 0 0 0.7rem color-mix(in srgb, var(--color-accent) 34%, transparent);
  }

  @keyframes breakpoint-lock {
    0% { opacity: 0.52; transform: translateX(5px); }
    38% { opacity: 1; transform: translateX(-1px); }
    100% { opacity: 1; transform: none; }
  }

  @keyframes breakpoint-node {
    0% { background: var(--color-bg); box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-warn) 42%, transparent); }
    45% { background: var(--color-warn); box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-warn) 0%, transparent); }
    100% { background: var(--color-bg); }
  }

  .trace-announcer {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1380px) {
    .reading-telemetry {
      right: 0.55rem;
      grid-template-columns: 2px 5.5rem;
    }
  }

  @media (max-width: 1160px) {
    .reading-telemetry {
      top: calc(var(--nav-offset, var(--nav-h)) + 0.65rem);
      right: 0.65rem;
      display: block;
      width: min(20rem, calc(100vw - 1.3rem));
      min-height: 0;
      padding: 0.48rem 0.62rem 0.5rem;
      border: 1px solid var(--color-line);
      background: color-mix(in srgb, var(--color-bg-soft) 86%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      box-shadow: 0 0.8rem 2rem -1.6rem rgb(0 0 0 / 0.9);
    }

    .telemetry-rail,
    .telemetry-kicker {
      display: none;
    }

    .telemetry-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head meta'
        'section registers';
      align-items: center;
      gap: 0.16rem 0.72rem;
      padding: 0;
    }

    .telemetry-head {
      grid-area: head;
    }

    .telemetry-state {
      font-size: 0.47rem;
    }

    .telemetry-section {
      grid-area: section;
      display: block;
      margin: 0;
      overflow: hidden;
      font-size: 0.59rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .telemetry-registers {
      grid-area: registers;
      display: flex;
      gap: 0.58rem;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .telemetry-register {
      gap: 0.2rem;
    }

    .telemetry-register i {
      font-size: 0.41rem;
    }

    .telemetry-register b {
      font-size: 0.47rem;
    }

    .telemetry-meta {
      grid-area: meta;
      margin: 0;
      padding: 0;
      border: 0;
    }

    [data-reading-index] {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .reading-telemetry {
      top: calc(var(--nav-offset, var(--nav-h)) + 0.45rem);
      right: 0.5rem;
      width: calc(100vw - 1rem);
      padding-block: 0.4rem;
    }

    .telemetry-copy {
      column-gap: 0.5rem;
    }

    .telemetry-section {
      font-size: 0.55rem;
    }

    .telemetry-registers {
      gap: 0.42rem;
    }

    .telemetry-register i {
      display: none;
    }
  }

  html[data-motion='off'] .reading-telemetry,
  html[data-motion='off'] .telemetry-fill,
  html[data-motion='off'] .telemetry-node,
  html[data-motion='off'] .telemetry-state,
  html[data-motion='off'] .telemetry-register b {
    transition: none;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-telemetry,
    .telemetry-fill,
    .telemetry-node,
    .telemetry-state,
    .telemetry-register b,
    .telemetry-copy {
      transition: none;
      animation: none !important;
    }
  }

  @media print {
    .reading-telemetry {
      display: none;
    }
  }
</style>

<script>
  import { tracePcAddress, traceSlugFromPathname } from '../lib/traceAddress'

  let readingCleanup: (() => void) | null = null

  const clampReading = (value: number) => Math.min(100, Math.max(0, value))

  function setupReadingTelemetry() {
    readingCleanup?.()
    readingCleanup = null

    const telemetry = document.querySelector<HTMLElement>('[data-reading-telemetry]')
    const prose = document.querySelector<HTMLElement>('[data-article] .prose')
    if (!telemetry || !prose) return

    const percentNode = telemetry.querySelector<HTMLElement>('[data-reading-percent]')
    const sectionNode = telemetry.querySelector<HTMLElement>('[data-reading-section]')
    const indexNode = telemetry.querySelector<HTMLElement>('[data-reading-index]')
    const stateNode = telemetry.querySelector<HTMLElement>('[data-reading-state]')
    const pcNode = telemetry.querySelector<HTMLElement>('[data-reading-pc]')
    const blockNode = telemetry.querySelector<HTMLElement>('[data-reading-block]')
    const announcer = telemetry.querySelector<HTMLElement>('[data-reading-announcer]')
    const headings = [...prose.querySelectorAll<HTMLElement>('h2[id], h3[id]')]
    const postSlug = traceSlugFromPathname(window.location.pathname)
    const blocks = headings.map((heading, index) => ({
      heading,
      pc: tracePcAddress(postSlug, heading.id, index),
    }))
    const entryPc = tracePcAddress(postSlug, 'entry', 0)
    const controller = new AbortController()
    const { signal } = controller
    const resizeObserver = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(() => remeasure())
    let frame = 0
    let breakpointTimer = 0
    let previousActiveIndex: number | null = null
    let wasComplete = false
    let geometry: { start: number; end: number; sections: number[] } | null = null

    const padded = (value: number) => String(value).padStart(2, '0')

    const setTraceRegister = (activeIndex: number) => {
      const position = activeIndex >= 0 ? activeIndex + 1 : 0
      if (pcNode) pcNode.textContent = blocks[activeIndex]?.pc ?? entryPc
      if (blockNode) blockNode.textContent = `${padded(position)} / ${padded(blocks.length)}`
    }

    const clearBreakpointTimer = () => {
      if (!breakpointTimer) return
      window.clearTimeout(breakpointTimer)
      breakpointTimer = 0
    }

    const canAnimateBreakpoint = () =>
      document.documentElement.dataset.motion === 'ready' &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const hitBreakpoint = (activeIndex: number) => {
      const block = blocks[activeIndex]
      if (!block) return

      clearBreakpointTimer()
      if (stateNode) stateNode.textContent = 'BREAKPOINT HIT'
      if (announcer) {
        announcer.textContent = `断点命中，PC ${block.pc}，区块 ${activeIndex + 1}，共 ${blocks.length} 个区块。`
      }

      if (!canAnimateBreakpoint()) {
        delete telemetry.dataset.breakpoint
        return
      }

      // 属性重新挂载让快速跨越多个章节时也能重新执行一次短促的断点反馈。
      delete telemetry.dataset.breakpoint
      void telemetry.offsetWidth
      telemetry.dataset.breakpoint = 'true'
      breakpointTimer = window.setTimeout(() => {
        breakpointTimer = 0
        delete telemetry.dataset.breakpoint
        if (telemetry.dataset.complete !== 'true' && stateNode) stateNode.textContent = 'TRACE RUNNING'
      }, 980)
    }

    const setProcessComplete = () => {
      clearBreakpointTimer()
      delete telemetry.dataset.breakpoint
      if (stateNode) stateNode.textContent = 'PROCESS EXITED 0'
      if (announcer) announcer.textContent = `文章阅读完成，共执行 ${blocks.length} 个区块，进程正常退出。`
    }

    const measure = () => {
      const proseRect = prose.getBoundingClientRect()
      const pageTop = window.scrollY
      const start = proseRect.top + pageTop - window.innerHeight * 0.2
      const end = proseRect.bottom + pageTop - window.innerHeight * 0.72
      geometry = {
        start,
        end: Math.max(start + 1, end),
        sections: headings.map((heading) => heading.getBoundingClientRect().top + pageTop),
      }
    }

    const update = () => {
      frame = 0
      if (!geometry) measure()
      if (!geometry) return

      const scanLine = window.scrollY + window.innerHeight * 0.24
      const progress = clampReading(((scanLine - geometry.start) / (geometry.end - geometry.start)) * 100)
      const rounded = Math.round(progress)
      let activeIndex = -1
      geometry.sections.forEach((top, index) => {
        if (top <= scanLine + 2) activeIndex = index
      })

      telemetry.style.setProperty('--reading-progress', progress.toFixed(2))
      telemetry.dataset.ready = 'true'
      telemetry.dataset.active = progress > 0 && progress < 100 ? 'true' : 'false'
      const complete = progress >= 99.5
      telemetry.dataset.complete = complete ? 'true' : 'false'
      if (percentNode) percentNode.textContent = `${String(rounded).padStart(2, '0')}%`
      if (indexNode) {
        const position = activeIndex >= 0 ? activeIndex + 1 : 0
        indexNode.textContent = `${padded(position)} / ${padded(headings.length)}`
      }
      if (sectionNode) {
        sectionNode.textContent = complete
          ? 'record complete'
          : activeIndex >= 0
            ? headings[activeIndex].textContent?.trim() || 'current section'
            : 'opening record'
      }

      setTraceRegister(activeIndex)

      if (previousActiveIndex === null) {
        previousActiveIndex = activeIndex
        if (complete) setProcessComplete()
        else if (stateNode) stateNode.textContent = activeIndex >= 0 ? 'TRACE ATTACHED' : 'TRACE ARMED'
      } else if (complete && !wasComplete) {
        setProcessComplete()
      } else if (!complete && activeIndex !== previousActiveIndex) {
        if (activeIndex >= 0) hitBreakpoint(activeIndex)
        else {
          clearBreakpointTimer()
          delete telemetry.dataset.breakpoint
          if (stateNode) stateNode.textContent = 'TRACE ARMED'
        }
      } else if (!complete && wasComplete && stateNode) {
        stateNode.textContent = activeIndex >= 0 ? 'TRACE RUNNING' : 'TRACE ARMED'
      }

      previousActiveIndex = activeIndex
      wasComplete = complete
    }

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    const remeasure = () => {
      geometry = null
      requestUpdate()
    }

    window.addEventListener('scroll', requestUpdate, { passive: true, signal })
    window.addEventListener('resize', remeasure, { passive: true, signal })
    document.fonts?.ready.then(remeasure).catch(() => {})
    resizeObserver?.observe(prose)
    measure()
    update()

    readingCleanup = () => {
      controller.abort()
      resizeObserver?.disconnect()
      if (frame) cancelAnimationFrame(frame)
      clearBreakpointTimer()
    }
  }

  setupReadingTelemetry()
  document.addEventListener('astro:page-load', setupReadingTelemetry)
</script>
