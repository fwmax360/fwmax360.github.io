---
import { SITE, SOCIAL } from '../consts'

const year = new Date().getFullYear()

const linkAttrs = (href: string) => {
  const external = href.startsWith('http')
  const hard = href.endsWith('.xml') || href.endsWith('.xsl')
  return {
    href,
    class: 'footer-link',
    ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    ...(hard ? { 'data-astro-reload': true } : {}),
  }
}
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <p class="mono footer-sig">
        <span class="text-accent">$</span> echo "{SITE.handle}"
      </p>
      <p class="footer-note">© {year} {SITE.author} · 内容采用 CC BY-NC-SA 4.0 授权</p>
    </div>

    <div class="footer-right">
      {SOCIAL.map((s) => <a {...linkAttrs(s.href)}>{s.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-soft) 60%, transparent);
  }

  .footer-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: 2.25rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: space-between;
    align-items: flex-end;
  }

  .footer-sig {
    font-size: 0.85rem;
    color: var(--color-dim);
  }

  .text-accent {
    color: var(--color-accent);
  }

  .footer-note {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-faint);
  }

  .footer-right {
    display: flex;
    gap: 1.25rem;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-dim);
    text-decoration: none;
    transition: color 0.18s;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }
</style>
