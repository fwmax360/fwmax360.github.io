---
import { NAV, SITE, SOCIAL } from '../consts'

const year = new Date().getFullYear()

const linkAttrs = (href: string) => {
  const external = href.startsWith('http')
  const hard = href.endsWith('.xml') || href.endsWith('.xsl')
  return {
    href,
    ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    ...(hard ? { 'data-astro-reload': true } : {}),
  }
}
---

<footer class="footer">
  <div class="inner">
    <div>
      <p class="name">{SITE.title}</p>
      <p class="desc">{SITE.description}</p>
    </div>
    <nav aria-label="页脚">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      {SOCIAL.map((item) => <a {...linkAttrs(item.href)}>{item.label}</a>)}
    </nav>
  </div>
  <p class="legal">© {year} {SITE.author}</p>
</footer>

<style>
  .footer {
    margin-top: 6.25rem;
    padding: 2rem 1.5rem 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--container-wide);
    margin-inline: auto;
  }

  .name {
    color: var(--color-text-strong);
    font-weight: 650;
  }

  .desc {
    max-width: 24rem;
    margin-top: 0.4rem;
    color: var(--color-dim);
    font-size: 0.95rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-end;
    gap: 0.75rem 1.25rem;
    max-width: 24rem;
  }

  a {
    color: var(--color-dim);
    font-size: 0.95rem;
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
  }

  .legal {
    max-width: var(--container-wide);
    margin: 2rem auto 0;
    color: var(--color-faint);
    font-size: 0.8125rem;
  }

  @media (max-width: 733px) {
    .footer {
      margin-top: 3.75rem;
      padding-inline: 1rem;
    }

    .inner,
    nav {
      display: grid;
      justify-content: start;
    }
  }
</style>
