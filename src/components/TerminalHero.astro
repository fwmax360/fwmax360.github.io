---
import { SITE } from '../consts'

interface Props {
  /** 每行： [命令, 输出] */
  lines: { cmd: string; out?: string; html?: string }[]
}

const { lines } = Astro.props
const prompt = `${SITE.handle}@${SITE.host}:~$`
---

<section class="term" data-term data-reveal="hero" data-spotlight data-tilt="1.5">
  <div class="term-bar">
    <span class="term-flag mono" aria-hidden="true">▌</span>
    <span class="term-title mono">{SITE.handle}@{SITE.host}</span>
    <span class="term-shell mono" aria-hidden="true">zsh</span>
    <span class="term-link mono" aria-hidden="true">
      <span class="term-bars"><i></i><i></i><i></i><i></i></span>
      encrypted link
    </span>
    <button
      type="button"
      class="term-tap mono"
      data-term-tap
      title="点一下跑条玩笑命令"
      aria-label="运行一条玩笑命令"
    >
      tap
    </button>
  </div>

  <div class="term-body mono" data-term-body>
    {
      lines.map((line, i) => (
        <div class="term-line" data-line style={`--i:${i};--chars:${line.cmd.length}`}>
          <div class="term-cmd">
            <span class="term-prompt">{prompt}</span>
            <span class="term-typed">{line.cmd}</span>
          </div>
          {line.html ? (
            <div class="term-out" set:html={line.html} />
          ) : line.out ? (
            <div class="term-out">{line.out}</div>
          ) : null}
        </div>
      ))
    }
    <div class="term-line live" data-term-live style={`--i:${lines.length}`}>
      <div class="term-cmd">
        <span class="term-prompt">{prompt}</span>
        <span class="cursor" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <div class="term-stream mono" aria-hidden="true">
    <span class="stream-label"><i></i> telemetry</span>
    <span class="stream-track"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="stream-seq">SEQ / <b data-term-seq>7A:31</b></span>
  </div>
</section>

<script>
  const EXTRAS = [
    { cmd: 'fortune', out: '客户：「随便看看。」\n你：打开 IDA。\n两周后：还在看。' },
    { cmd: 'echo $CAFFEINE', out: 'level=critical; refill=asap' },
    { cmd: 'kill -9 boredom', out: 'bash: kill: (boredom) - No such process\n# 它已经住进你的样本里了' },
    { cmd: 'cat ~/todo.txt', out: '- [ ] 睡一觉\n- [ ] 把这篇写完\n- [x] 打开另一个样本' },
    { cmd: 'ping reality', out: 'Request timeout.\n# 你已进入伪代码世界' },
  ]

  function setupTerm() {
    const root = document.querySelector<HTMLElement>('[data-term]')
    const body = document.querySelector<HTMLElement>('[data-term-body]')
    const live = document.querySelector<HTMLElement>('[data-term-live]')
    const tap = document.querySelector<HTMLButtonElement>('[data-term-tap]')
    if (!root || !body || !live || !tap || root.dataset.bound) return
    root.dataset.bound = '1'

    const lifecycle = new AbortController()
    const sequence = root.querySelector<HTMLElement>('[data-term-seq]')
    let sequenceStep = 0x7a31
    let sequenceTimer = 0
    const runSequence = () => {
      if (!sequence || document.documentElement.dataset.motion !== 'ready' || document.hidden) return
      sequenceStep = (sequenceStep + 0x17) & 0xffff
      const value = sequenceStep.toString(16).toUpperCase().padStart(4, '0')
      sequence.textContent = `${value.slice(0, 2)}:${value.slice(2)}`
    }

    const syncMotion = () => {
      window.clearInterval(sequenceTimer)
      sequenceTimer = 0

      const enabled = document.documentElement.dataset.motion === 'ready'
      if (enabled) root.dataset.termEnhanced = 'true'
      else delete root.dataset.termEnhanced

      if (enabled && !document.hidden && sequence) {
        sequenceTimer = window.setInterval(runSequence, 1700)
      }
    }

    syncMotion()
    document.addEventListener('sleep4r:motionchange', syncMotion, { signal: lifecycle.signal })
    document.addEventListener('visibilitychange', syncMotion, { signal: lifecycle.signal })
    document.addEventListener(
      'astro:before-swap',
      () => {
        lifecycle.abort()
        window.clearInterval(sequenceTimer)
      },
      { once: true },
    )

    let i = 0
    const prompt = live.querySelector('.term-prompt')?.textContent ?? '$'

    tap.addEventListener('click', () => {
      const item = EXTRAS[i % EXTRAS.length]
      i++

      const block = document.createElement('div')
      block.className = 'term-line'
      block.style.setProperty('--i', '0')
      block.style.setProperty('--chars', String(item.cmd.length))
      block.style.opacity = '1'
      block.innerHTML = `
        <div class="term-cmd">
          <span class="term-prompt">${prompt}</span>
          <span class="term-typed">${item.cmd}</span>
        </div>
        <div class="term-out"></div>
      `
      block.querySelector('.term-out')!.textContent = item.out
      body.insertBefore(block, live)
      tap.classList.add('pulse')
      setTimeout(() => tap.classList.remove('pulse'), 220)
    })
  }

  setupTerm()
  document.addEventListener('astro:after-swap', setupTerm)
</script>

<style>
  .term {
    position: relative;
    border: 1px solid var(--color-line-bright);
    background:
      linear-gradient(145deg, rgb(61 220 132 / 3.5%), transparent 34%),
      var(--color-panel);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    overflow: hidden;
    box-shadow:
      var(--shadow-panel),
      var(--shadow-accent),
      inset 0 1px 0 rgb(255 255 255 / 2%);
  }

  .term::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 1.9rem 0 auto;
    height: 4.5rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgb(61 220 132 / 0.045), transparent);
    opacity: 0;
  }

  /* 极淡的 CRT 扫描线，凑近才看得见 */
  .term::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.014) 0 1px,
      transparent 1px 3px
    );
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 3%), rgb(5 7 10 / 48%));
    border-bottom: 1px solid var(--color-line);
    font-size: 0.72rem;
  }

  .term-flag {
    color: var(--color-accent);
    line-height: 1;
    text-shadow: 0 0 10px rgb(61 220 132 / 42%);
  }

  .term-title {
    color: var(--color-dim);
  }

  .term-shell {
    color: var(--color-faint);
  }

  .term-shell::before {
    content: '· ';
  }

  .term-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: var(--color-faint);
    font-size: 0.57rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .term-bars {
    display: inline-flex;
    align-items: end;
    gap: 2px;
    height: 0.65rem;
  }

  .term-bars i {
    width: 2px;
    height: 35%;
    background: var(--color-accent);
    opacity: 0.42;
  }

  .term-bars i:nth-child(2) { height: 55%; }
  .term-bars i:nth-child(3) { height: 78%; }
  .term-bars i:nth-child(4) { height: 100%; }

  .term-tap {
    margin-left: 0.35rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--color-line-bright);
    background: transparent;
    color: var(--color-faint);
    font-size: 0.68rem;
    cursor: pointer;
    transition:
      color 0.16s,
      border-color 0.16s,
      background 0.16s;
  }

  .term-tap:hover {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 18px rgb(61 220 132 / 12%);
  }

  .term-tap.pulse {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .term-body {
    padding: 0.85rem 1.2rem 0.95rem;
    font-size: 0.875rem;
    line-height: 1.62;
  }

  .term-line {
    /* 动效被浏览器或用户样式关闭时仍直接显示内容 */
    opacity: 1;
    animation: line-in 0.45s var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 0.28s + 0.15s);
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true']::before {
    opacity: 1;
    animation: terminal-scan 5.8s linear infinite;
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-typed {
    display: inline-block;
    width: 0;
    max-width: max-content;
    overflow: hidden;
    white-space: nowrap;
    animation: terminal-type 0.62s steps(var(--chars), end) forwards;
    animation-delay: calc(var(--i) * 0.28s + 0.22s);
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-out {
    animation: output-resolve 0.36s ease both;
    animation-delay: calc(var(--i) * 0.28s + 0.8s);
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-bars i {
    animation: signal-bars 1.25s ease-in-out infinite alternate;
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-bars i:nth-child(2) { animation-delay: -0.35s; }
  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-bars i:nth-child(3) { animation-delay: -0.7s; }
  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .term-bars i:nth-child(4) { animation-delay: -1.05s; }

  @keyframes terminal-type {
    to { width: calc(var(--chars) * 1ch); }
  }

  @keyframes output-resolve {
    from { opacity: 0; filter: blur(3px); transform: translateY(2px); }
    to { opacity: 1; filter: none; transform: none; }
  }

  @keyframes terminal-scan {
    from { transform: translateY(-6rem); }
    to { transform: translateY(13rem); }
  }

  @keyframes signal-bars {
    55% { opacity: 1; transform: scaleY(0.48); }
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term-line {
      opacity: 1;
      animation: none;
    }
  }

  .term-cmd {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .term-prompt {
    color: var(--color-accent);
    white-space: nowrap;
  }

  .term-typed {
    color: var(--color-text-strong);
  }

  .term-out {
    color: var(--color-dim);
    padding-left: 0;
    margin-bottom: 0.34rem;
    white-space: pre-wrap;
  }

  .term-out :global(a) {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-link) 35%, transparent);
  }

  .term-out :global(a:hover) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .term-out :global(.k) {
    color: var(--color-accent);
  }

  .cursor {
    display: inline-block;
    width: 0.55rem;
    height: 1.05rem;
    background: var(--color-accent);
    translate: 0 0.2rem;
    animation: blink 1.05s steps(2, start) infinite;
  }

  .term-stream {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(4rem, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    min-height: 1.75rem;
    padding: 0.28rem 0.8rem;
    border-top: 1px solid var(--color-line);
    background: rgb(5 8 11 / 0.48);
    color: var(--color-faint);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stream-label {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .stream-label i {
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0.5rem var(--color-accent);
  }

  .stream-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 0.65rem;
    overflow: hidden;
  }

  .stream-track::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-line-bright) 12% 88%, transparent);
  }

  .stream-track i {
    position: relative;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-dim);
  }

  .stream-seq b {
    color: var(--color-accent);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .stream-track::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -1rem;
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    box-shadow: 0 0 0.5rem var(--color-accent);
    animation: stream-packet 2.6s linear infinite;
  }

  :global(html[data-motion='ready']) .term[data-term-enhanced='true'] .stream-label i {
    animation: stream-led 1.8s ease-out infinite;
  }

  @keyframes stream-packet {
    to { left: calc(100% + 1rem); }
  }

  @keyframes stream-led {
    45% { box-shadow: 0 0 0 0.3rem rgb(61 220 132 / 0); }
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  @media (max-width: 640px) {
    .term-body {
      font-size: 0.78rem;
      padding: 0.8rem 1rem 0.9rem;
      line-height: 1.58;
    }
    .term-shell {
      display: none;
    }
    .term-link {
      margin-left: auto;
    }
    .term-link:not(.term-bars) {
      font-size: 0;
    }
    .term-stream {
      grid-template-columns: auto minmax(2rem, 1fr) auto;
      gap: 0.45rem;
      padding-inline: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term::before,
    .term-bars i,
    .stream-track::after,
    .stream-label i,
    .term-typed,
    .term-out {
      animation: none !important;
      filter: none !important;
      transform: none !important;
    }
    .term-typed { width: auto !important; }
  }

  :global(html[data-motion='off']) .term::before,
  :global(html[data-motion='off']) .term-bars i,
  :global(html[data-motion='off']) .stream-track::after,
  :global(html[data-motion='off']) .stream-label i,
  :global(html[data-motion='off']) .term-typed,
  :global(html[data-motion='off']) .term-out {
    animation: none !important;
    filter: none !important;
    transform: none !important;
  }

  :global(html[data-motion='off']) .term-typed { width: auto !important; }
</style>
