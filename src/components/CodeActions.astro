---
// 代码块的客户端行为：复制、超长折叠展开。
// 标题栏和行号在构建期由 Shiki transformer 生成，这里只挂交互。
---

<style is:global>
  .code-block {
    position: relative;
    border-color: color-mix(in srgb, var(--color-line-bright) 72%, var(--color-line));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.02),
      0 20px 42px -38px rgb(0 0 0 / 0.95);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .code-block:hover,
  .code-block:focus-within {
    border-color: color-mix(in srgb, var(--color-accent-soft) 48%, var(--color-line-bright));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.025),
      0 24px 48px -38px rgb(0 0 0 / 0.98);
  }

  .code-head {
    min-height: 2.45rem;
    padding: 0.38rem 0.48rem 0.38rem 0.72rem;
    gap: 0.55rem;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 3%, transparent), transparent 38%),
      var(--color-surface);
  }

  .code-head::before {
    content: '';
    width: 0.34rem;
    height: 0.34rem;
    flex: 0 0 auto;
    margin-right: 1.2rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    box-shadow:
      0.72rem 0 0 var(--color-line-bright),
      1.44rem 0 0 var(--color-line-bright);
    opacity: 0.82;
  }

  .code-lang {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--color-dim);
    font-weight: 600;
  }

  .code-lang[data-lines]::after {
    content: attr(data-lines) 'L';
    color: var(--color-faint);
    font-size: 0.57rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .code-title {
    min-width: 0;
    overflow: hidden;
    color: var(--color-dim);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .code-title::before {
    content: '/';
    margin-right: 0.45rem;
    color: var(--color-line-bright);
  }

  .code-copy {
    min-width: 4.25rem;
    min-height: 1.75rem;
    justify-content: center;
    gap: 0.42rem;
    padding: 0.25rem 0.55rem;
    border-color: var(--color-line);
    background: color-mix(in srgb, var(--color-bg) 38%, transparent);
    letter-spacing: 0.02em;
  }

  .code-copy::before {
    content: '⧉';
    color: currentColor;
    font-size: 0.77rem;
    line-height: 1;
  }

  .code-copy:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .code-copy[data-state='success'] {
    border-color: var(--color-accent-soft);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-soft));
  }

  .code-copy[data-state='success']::before {
    content: '✓';
  }

  .code-copy[data-state='error'] {
    border-color: color-mix(in srgb, var(--color-danger) 48%, var(--color-line));
    color: var(--color-danger);
    background: color-mix(in srgb, var(--color-danger) 7%, var(--color-bg-soft));
  }

  .code-copy[data-state='error']::before {
    content: '!';
  }

  .code-block[data-collapsible]:not([data-open='true']) .code-scroll::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4.5rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-bg) 92%, transparent));
  }

  .code-expand {
    min-height: 2.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    letter-spacing: 0.025em;
    background:
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-surface-2) 65%, transparent), transparent),
      var(--color-surface);
  }

  .code-expand::after {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translate(-1px, 1px);
    transition: transform 0.2s var(--ease-out-expo);
  }

  .code-expand[aria-expanded='true']::after {
    transform: rotate(225deg) translate(-1px, 1px);
  }

  @media (max-width: 640px) {
    .code-block {
      margin-inline: -0.3rem;
    }

    .code-head {
      min-height: 2.7rem;
      padding-left: 0.65rem;
      gap: 0.42rem;
    }

    .code-head::before {
      margin-right: 0.85rem;
    }

    .code-title {
      max-width: 9rem;
    }

    .code-copy {
      min-width: 3.8rem;
      min-height: 2rem;
      padding-inline: 0.45rem;
    }

    .code-block pre {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-block,
    .code-expand::after {
      transition: none;
    }
  }
</style>

<script>
  let codePanelId = 0

  const writeCode = async (text: string) => {
    if (!navigator.clipboard) throw new Error('clipboard unavailable')
    await navigator.clipboard.writeText(text)
  }

  function setupCode() {
    document.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
      const lines = block.querySelectorAll('.line').length
      const lang = block.querySelector<HTMLElement>('.code-lang')
      if (lang && lines > 1) lang.dataset.lines = String(lines)

      const scroll = block.querySelector<HTMLElement>('.code-scroll')
      const expand = block.querySelector<HTMLButtonElement>('[data-expand]')
      if (scroll && expand && !expand.hasAttribute('aria-controls')) {
        scroll.id ||= `code-panel-${++codePanelId}`
        expand.setAttribute('aria-controls', scroll.id)
      }
    })

    document.querySelectorAll<HTMLButtonElement>('.code-block [data-copy]').forEach((btn) => {
      if (btn.dataset.bound) return
      btn.dataset.bound = '1'
      btn.dataset.state = 'idle'
      let resetTimer = 0

      const setCopyState = (state: 'idle' | 'success' | 'error') => {
        btn.dataset.state = state
        btn.textContent = state === 'success' ? 'copied' : state === 'error' ? 'failed' : 'copy'
        btn.setAttribute(
          'aria-label',
          state === 'success' ? '代码已复制' : state === 'error' ? '代码复制失败' : '复制代码',
        )
      }

      btn.addEventListener('click', async () => {
        const code = btn.closest('.code-block')?.querySelector('code')
        if (!code) return

        window.clearTimeout(resetTimer)
        btn.disabled = true
        btn.setAttribute('aria-busy', 'true')
        try {
          await writeCode(code.textContent ?? '')
          setCopyState('success')
          btn.dataset.copied = 'true'
        } catch {
          setCopyState('error')
        } finally {
          btn.disabled = false
          btn.removeAttribute('aria-busy')
        }

        resetTimer = window.setTimeout(() => {
          setCopyState('idle')
          delete btn.dataset.copied
        }, 1600)
      })
    })

    document.querySelectorAll<HTMLButtonElement>('.code-block [data-expand]').forEach((btn) => {
      if (btn.dataset.bound) return
      btn.dataset.bound = '1'

      const expandLabel = btn.textContent ?? '展开全部'
      btn.dataset.expandLabel = expandLabel

      btn.addEventListener('click', () => {
        const block = btn.closest<HTMLElement>('.code-block')
        if (!block) return

        const open = block.dataset.open === 'true'
        block.dataset.open = String(!open)
        btn.textContent = open ? expandLabel : '收起代码'
        btn.setAttribute('aria-expanded', String(!open))

        if (open) block.scrollIntoView({ block: 'nearest' })
      })
    })
  }

  setupCode()
  document.addEventListener('astro:page-load', setupCode)
</script>
