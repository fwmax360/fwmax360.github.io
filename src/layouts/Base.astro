---
import { ClientRouter, fade } from 'astro:transitions'
import BaseHead from '../components/BaseHead.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Search from '../components/Search.astro'
import Interactions from '../components/Interactions.astro'
import ImageViewer from '../components/ImageViewer.astro'
import Motion from '../components/Motion.astro'
import NavigationGlow from '../components/NavigationGlow.astro'
import ReadingTransition from '../components/ReadingTransition.astro'
import AmbientMotion from '../components/AmbientMotion.astro'
import { SITE } from '../consts'
import '../styles/editorial-theme.css'

interface Props {
  title: string
  description?: string
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  noindex?: boolean
  image?: string
  imageAlt?: string
  /** 宽版用于首页/归档，窄版用于文章正文 */
  width?: 'wide' | 'content'
  hasMath?: boolean
  editorialFont?: boolean
  bodyClass?: string
}

const {
  title,
  description,
  type,
  publishedAt,
  updatedAt,
  noindex,
  image,
  imageAlt,
  width = 'wide',
  hasMath = false,
  editorialFont = false,
  bodyClass,
} = Astro.props
---

<!doctype html>
<html lang={SITE.lang} data-pagefind-ignore={noindex ? 'all' : undefined}>
  <head>
    <BaseHead
      title={title}
      description={description}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
      image={image}
      imageAlt={imageAlt}
      hasMath={hasMath}
      editorialFont={editorialFont}
    />
    <Motion />
    <ClientRouter />
  </head>

  <body class={bodyClass}>
    <AmbientMotion />
    <NavigationGlow />

    <a href="#main" class="skip">跳到正文</a>

    <div class="page-fg" data-motion-root>
      <Nav />

      <main
        id="main"
        class:list={['shell', width]}
        transition:name={type === 'article' ? 'reading-content' : 'page-content'}
        transition:animate={fade({ duration: '180ms' })}
      >
        <slot />
      </main>

      <Footer />
      <Search />
      <Interactions />
      <ReadingTransition />
    </div>
    {type === 'article' && <ImageViewer />}

    <style>
      .page-fg {
        position: relative;
        z-index: 1;
        isolation: isolate;
      }

      .shell {
        margin-inline: auto;
        /* 横向 safe-area 由 body 统一处理，这里再叠一次会让刘海屏内容偏窄 */
        padding-inline: 1.25rem;
        padding-top: clamp(2.75rem, 5vw, 4.75rem);
        padding-bottom: max(4rem, calc(3rem + env(safe-area-inset-bottom, 0px)));
        min-height: 60vh;
        min-height: 60dvh;
      }

      .shell.wide {
        max-width: var(--container-wide);
      }

      .shell.content {
        max-width: var(--container-content);
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.6rem 1rem;
        background: var(--color-accent);
        color: #04150c;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        border-radius: 0 0 var(--radius) 0;
      }

      .skip:focus {
        left: 0;
      }

      @media (max-width: 640px) {
        .shell {
          padding-inline: 1rem;
          padding-top: 2rem;
          padding-bottom: max(3rem, calc(2rem + env(safe-area-inset-bottom, 0px)));
        }
      }

      @keyframes fade-in {
        from {
          opacity: 0;
        }
      }

      @keyframes fade-out {
        to {
          opacity: 0;
        }
      }

      ::view-transition-old(root) {
        animation: 120ms ease-out both fade-out;
      }

      ::view-transition-new(root) {
        animation: 220ms var(--ease-out-expo) both fade-in;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </body>
</html>
