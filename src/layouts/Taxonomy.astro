---
import Base from './Base.astro'
import { coverSvgUrl } from '../lib/covers'
import { getCoTags } from '../lib/editorialIndex'
import { categoryUrl, formatDate, postUrl, tagUrl, type Post } from '../lib/posts'
import { seriesUrl } from '../lib/series'

interface Props {
  kind: 'tag' | 'category'
  name: string
  posts: Post[]
}

const { kind, name, posts } = Astro.props
const prefix = kind === 'tag' ? '#' : ''
const desc = `${kind === 'tag' ? '标签' : '分类'} ${name} 下的 ${posts.length} 篇文章。`
const representative = posts[0]
const starterCandidates = [...posts].sort(
  (a, b) =>
    (a.data.order === 1 ? -1 : 0) - (b.data.order === 1 ? -1 : 0) ||
    a.data.pubDate.getTime() - b.data.pubDate.getTime(),
)
const starter = starterCandidates.find((post) => post.id !== representative?.id) ?? representative
const coTags = getCoTags(posts, kind === 'tag' ? name : undefined)
const connectedSeries = [...new Set(posts.map((post) => post.data.series).filter((series): series is string => Boolean(series)))]
const ledger = posts.filter((post) => post.id !== representative?.id)
---

<Base title={`${prefix}${name}`} description={desc}>
  <header class="taxonomy-head">
    <a href={kind === 'tag' ? '/tags' : '/tags#categories'} class="back">
      ← {kind === 'tag' ? '标签' : '分类'}
    </a>
    <div class="head-row">
      <div>
        <h1><span>{prefix}</span>{name}</h1>
        <p>{posts.length > 0 ? `围绕 ${name} 汇编的代表文章、起步入口与相邻研究信号。` : desc}</p>
      </div>
      <dl class="head-stats mono">
        <div><dt>文章</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
        <div><dt>相关标签</dt><dd>{String(coTags.length).padStart(2, '0')}</dd></div>
        <div><dt>系列</dt><dd>{String(connectedSeries.length).padStart(2, '0')}</dd></div>
      </dl>
    </div>
  </header>

  {representative ? (
    <>
      <section class="lead-grid col-side" aria-labelledby="lead-title" data-reveal>
        <article class="lead-story">
          <a
            class="lead-cover"
            href={postUrl(representative)}
            aria-label={`阅读代表文章《${representative.data.title}》`}
            data-jmp
            data-jmp-source="taxonomy / representative"
            data-jmp-title={representative.data.title}
          >
            <img src={coverSvgUrl(representative)} width="1200" height="630" alt={`《${representative.data.title}》文章封面`} />
          </a>
          <div class="lead-copy" data-reading-preview>
            <p class="mono">精选文章 / {formatDate(representative.data.pubDate)}</p>
            <h2 id="lead-title">
              <a
                href={postUrl(representative)}
                data-jmp
                data-jmp-source="taxonomy / representative"
                data-jmp-title={representative.data.title}
              >{representative.data.title}</a>
            </h2>
            <p>{representative.data.description}</p>
            <footer class="mono">
              <a href={categoryUrl(representative.data.category)}>{representative.data.category}</a>
              {representative.data.series && <a href={seriesUrl(representative.data.series)}>series / {representative.data.series}</a>}
              <span>{representative.data.tags.slice(0, 4).map((tag) => `#${tag}`).join('  ')}</span>
            </footer>
          </div>
        </article>

        <aside class="taxonomy-aside">
          {starter && (
            <section class="start-card" aria-labelledby="start-title">
              <p class="mono">从这里开始</p>
              <h2 id="start-title">起步文章</h2>
              <a
                href={postUrl(starter)}
                data-jmp
                data-jmp-source="taxonomy / start here"
                data-jmp-title={starter.data.title}
              >{starter.data.title}</a>
              <span>{starter.data.description}</span>
              <footer class="mono">
                <time datetime={starter.data.pubDate.toISOString()}>{formatDate(starter.data.pubDate)}</time>
                <b>read ↗</b>
              </footer>
            </section>
          )}

          <section class="connections" aria-labelledby="connections-title">
            <header>
              <div>
                <p class="mono">相关标签</p>
                <h2 id="connections-title">相关标签</h2>
              </div>
              <span class="mono">{String(coTags.length).padStart(2, '0')}</span>
            </header>
            {coTags.length > 0 ? (
              <div class="connection-tags mono">
                {coTags.map((tag) => <a href={tagUrl(tag.name)}>#{tag.name}<sup>{tag.count}</sup></a>)}
              </div>
            ) : (
              <p class="connection-empty mono">暂无相关标签</p>
            )}
          </section>
        </aside>
      </section>

      {connectedSeries.length > 0 && (
        <nav class="series-strip mono" aria-label="关联系列" data-reveal>
          <span>关联系列</span>
          {connectedSeries.map((series) => <a href={seriesUrl(series)}>{series} ↗</a>)}
        </nav>
      )}

      {ledger.length > 0 && (
        <section class="ledger" aria-labelledby="ledger-title">
          <header class="ledger-head" data-reveal>
            <div>
              <p class="mono">更多笔记</p>
              <h2 id="ledger-title">继续浏览</h2>
            </div>
            <span class="mono">{String(ledger.length).padStart(2, '0')} 篇</span>
          </header>
          <ol class="ledger-grid col-side">
            {ledger.map((post, index) => (
              <li data-reveal>
                <article class="ledger-card" data-reading-preview>
                  <a
                    class="ledger-hit"
                    href={postUrl(post)}
                    aria-label={`阅读《${post.data.title}》`}
                    data-jmp
                    data-jmp-source="taxonomy / ledger"
                    data-jmp-title={post.data.title}
                  ></a>
                  <header class="mono">
                    <span>ENTRY / {String(index + 2).padStart(2, '0')}</span>
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  </header>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <footer class="mono">
                    <a href={categoryUrl(post.data.category)}>{post.data.category}</a>
                    {post.data.series && <a href={seriesUrl(post.data.series)}>series / {post.data.series}</a>}
                    <span aria-hidden="true">↗</span>
                  </footer>
                </article>
              </li>
            ))}
          </ol>
        </section>
      )}
    </>
  ) : (
    <p class="empty mono">这个{kind === 'tag' ? '标签' : '分类'}下还没有文章。</p>
  )}
</Base>

<style>
  .taxonomy-head { position:relative;isolation:isolate;overflow:hidden;margin-bottom:2rem;padding:clamp(1.25rem,3vw,2rem);border:1px solid var(--color-line);background:linear-gradient(110deg,rgb(61 220 132 / .06),transparent 40%),var(--color-panel);box-shadow:var(--shadow-panel),inset 0 1px rgb(255 255 255 / .02); }
  .taxonomy-head::after { content:none; }
  .back { display:inline-block;margin-bottom:1.2rem;color:var(--color-faint);font-size:.65rem;text-decoration:none; }
  .back:hover,.back:focus-visible { color:var(--color-accent); }
  .head-row { display:flex;align-items:end;justify-content:space-between;gap:2rem; }
  .head-code { display:flex;align-items:center;gap:.45rem;color:var(--color-faint);font-size:.55rem;letter-spacing:.11em; }
  .head-code span { width:.38rem;height:.38rem;background:var(--color-accent);box-shadow:0 0 9px var(--color-accent);animation:taxonomy-pulse 1.8s ease-in-out infinite; }
  .taxonomy-head h1 { margin-top:.45rem;color:var(--color-text-strong);font:620 clamp(2.15rem,5vw,3.3rem)/1.08 var(--font-display);letter-spacing:-.02em;overflow-wrap:anywhere; }
  .taxonomy-head h1 span { color:var(--color-accent);font-family:var(--font-mono);font-weight:450; }
  .head-row > div > p:last-child { max-width:40rem;margin-top:.8rem;color:var(--color-dim);font-size:.9rem; }
  .head-stats { display:grid;grid-template-columns:repeat(3,5rem);gap:.75rem; }
  .head-stats div { padding-left:.65rem;border-left:1px solid var(--color-line-bright); }
  .head-stats dt { color:var(--color-faint);font-size:.48rem;letter-spacing:.08em;text-transform:uppercase; }
  .head-stats dd { margin-top:.2rem;color:var(--color-text-strong);font-size:1rem; }
  .head-stats div:first-child dd { color:var(--color-accent); }

  .lead-grid { display:grid;grid-template-columns:minmax(0,1fr) 17rem;gap:1rem; }
  .lead-story { position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(15rem,.82fr) minmax(0,1fr);overflow:hidden;border:1px solid var(--color-line-bright);border-left:2px solid var(--color-accent);background:linear-gradient(120deg,rgb(15 22 27 / .92),rgb(8 11 16 / .95)); }
  .lead-story::after { content:'';position:absolute;z-index:3;right:0;bottom:0;left:0;height:1px;background:linear-gradient(90deg,transparent,var(--color-accent),transparent);transform:translateX(-110%);transition:transform .75s var(--ease-out-expo);pointer-events:none; }
  .lead-story:is(:hover,:focus-within)::after { transform:translateX(110%); }
  .lead-cover { display:grid;min-height:16rem;place-items:center;overflow:hidden;border-right:1px solid var(--color-line);background:#05070a; }
  .lead-cover img { width:100%;height:100%;object-fit:contain;opacity:.88;transition:transform .4s var(--ease-out-expo),opacity .2s; }
  .lead-story:hover .lead-cover img,.lead-cover:focus-visible img { transform:scale(1.025);opacity:1; }
  .lead-copy { align-self:center;min-width:0;padding:clamp(1.15rem,2.5vw,1.8rem); }
  .lead-copy > p:first-child { color:var(--color-accent);font-size:.55rem;letter-spacing:.09em; }
  .lead-copy h2 { margin-top:.55rem;color:var(--color-text-strong);font-size:clamp(1.2rem,2.3vw,1.65rem);line-height:1.35; }
  .lead-copy h2 a { color:inherit;text-decoration:none; }
  .lead-copy h2 a:hover { color:var(--color-accent); }
  .lead-copy > p:not(:first-child) { display:-webkit-box;overflow:hidden;margin-top:.75rem;color:var(--color-dim);font-size:.83rem;line-height:1.7;-webkit-line-clamp:3;-webkit-box-orient:vertical; }
  .lead-copy footer { display:flex;flex-wrap:wrap;gap:.4rem .75rem;margin-top:1rem;color:var(--color-faint);font-size:.53rem; }
  .lead-copy footer a { color:var(--color-faint);text-decoration:none; }
  .lead-copy footer a:hover { color:var(--color-accent); }
  .taxonomy-aside { display:grid;grid-template-rows:auto 1fr;gap:1rem; }
  .start-card,.connections { padding:1rem;border:1px solid var(--color-line-bright);background:rgb(8 11 16 / .9); }
  .start-card > p,.connections header p { color:var(--color-accent);font-size:.52rem;letter-spacing:.09em; }
  .start-card h2,.connections h2 { margin-top:.2rem;color:var(--color-text-strong);font-size:.9rem; }
  .start-card > a { display:-webkit-box;overflow:hidden;margin-top:.75rem;color:var(--color-text);font-size:.78rem;font-weight:620;line-height:1.45;text-decoration:none;-webkit-line-clamp:2;-webkit-box-orient:vertical; }
  .start-card > a:hover { color:var(--color-accent); }
  .start-card > span { display:-webkit-box;overflow:hidden;margin-top:.4rem;color:var(--color-dim);font-size:.68rem;line-height:1.55;-webkit-line-clamp:2;-webkit-box-orient:vertical; }
  .start-card footer { display:flex;justify-content:space-between;gap:.5rem;margin-top:.7rem;color:var(--color-faint);font-size:.5rem; }
  .start-card footer b { color:var(--color-accent);font-weight:500; }
  .connections header { display:flex;align-items:start;justify-content:space-between;gap:.75rem;padding-bottom:.6rem;border-bottom:1px solid var(--color-line); }
  .connections header > span { color:var(--color-faint);font-size:.55rem; }
  .connection-tags { display:flex;flex-wrap:wrap;gap:.38rem;margin-top:.75rem; }
  .connection-tags a { padding:.2rem .38rem;border:1px solid var(--color-line);color:var(--color-dim);font-size:.55rem;text-decoration:none; }
  .connection-tags a:hover,.connection-tags a:focus-visible { border-color:var(--color-accent-soft);color:var(--color-accent); }
  .connection-tags sup { margin-left:.18rem;color:var(--color-faint);font-size:.42rem; }
  .connection-empty { margin-top:1rem;color:var(--color-faint);font-size:.52rem; }
  .series-strip { display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem;margin-top:1rem;padding:.7rem .85rem;border:1px solid var(--color-line);background:linear-gradient(90deg,transparent,rgb(61 220 132 / .04),transparent),rgb(8 11 16 / .72);background-size:38% 100%,auto;background-repeat:no-repeat;background-position:-60% 0,0 0;font-size:.55rem;animation:taxonomy-series-flow 6.5s linear infinite; }
  .series-strip > span { color:var(--color-faint); }
  .series-strip a { color:var(--color-warn);text-decoration:none; }
  .series-strip a:hover { color:var(--color-text-strong); }

  .ledger { margin-top:3.5rem; }
  .ledger-head { display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.75rem;padding-bottom:.65rem;border-bottom:1px solid var(--color-line-bright); }
  .ledger-head p { color:var(--color-accent);font-size:.54rem;letter-spacing:.1em; }
  .ledger-head h2 { margin-top:.18rem;color:var(--color-text-strong);font-size:1.2rem; }
  .ledger-head > span { color:var(--color-faint);font-size:.55rem; }
  .ledger-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:0;padding:0;list-style:none; }
  .ledger-card { position:relative;isolation:isolate;display:flex;flex-direction:column;overflow:hidden;min-height:13rem;padding:1rem;border:1px solid var(--color-line);border-left:2px solid transparent;background:rgb(8 11 16 / .78);transition:border-color .18s,background .18s,transform .2s var(--ease-out-expo); }
  .ledger-card::before { content:'';position:absolute;z-index:-1;right:-4rem;bottom:-4rem;width:8rem;height:8rem;border:1px solid color-mix(in srgb,var(--color-accent) 20%,transparent);border-radius:50%;opacity:0;transform:scale(.45);transition:opacity .25s,transform .55s var(--ease-out-expo); }
  .ledger-card:is(:hover,:focus-within)::before { opacity:1;transform:scale(1); }
  .ledger-card:hover,.ledger-card:focus-within { border-left-color:var(--color-accent);background:rgb(61 220 132 / .035);transform:translateY(-2px); }
  .ledger-hit { position:absolute;inset:0;z-index:1; }
  .ledger-card header { display:flex;justify-content:space-between;gap:1rem;color:var(--color-faint);font-size:.52rem; }
  .ledger-card header span { color:var(--color-accent-soft); }
  .ledger-card h3 { margin-top:.75rem;color:var(--color-text-strong);font-size:1rem;line-height:1.45; }
  .ledger-card > p { display:-webkit-box;overflow:hidden;margin-top:.45rem;color:var(--color-dim);font-size:.76rem;line-height:1.65;-webkit-line-clamp:3;-webkit-box-orient:vertical; }
  .ledger-card footer { position:relative;z-index:2;display:flex;align-items:end;flex-wrap:wrap;gap:.35rem .65rem;margin-top:auto;padding-top:.85rem;color:var(--color-faint);font-size:.52rem; }
  .ledger-card footer a { color:var(--color-faint);text-decoration:none; }
  .ledger-card footer a:hover { color:var(--color-accent); }
  .ledger-card footer span { margin-left:auto;color:var(--color-accent); }
  .empty { padding:4rem 1rem;border:1px solid var(--color-line);color:var(--color-faint);font-size:.75rem;text-align:center; }

  @media (max-width:900px) {
    .lead-grid { grid-template-columns:1fr; }
    .taxonomy-aside { grid-template-columns:1fr 1fr;grid-template-rows:auto; }
  }
  @media (max-width:700px) {
    .head-row { display:block; }
    .head-stats { grid-template-columns:repeat(3,1fr);margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--color-line); }
    .lead-story { grid-template-columns:1fr; }
    .lead-cover { min-height:0;aspect-ratio:1200/630;border-right:0;border-bottom:1px solid var(--color-line); }
    .lead-copy { padding:1.1rem; }
    .taxonomy-aside { grid-template-columns:1fr; }
    .ledger-grid { grid-template-columns:1fr; }
    .ledger-card { min-height:11.5rem; }
  }

  @keyframes taxonomy-head-scan { 0%,18% { transform:translateX(0) skewX(-18deg);opacity:0; } 38%,65% { opacity:1; } 84%,100% { transform:translateX(760%) skewX(-18deg);opacity:0; } }
  @keyframes taxonomy-pulse { 50% { opacity:.35;box-shadow:0 0 16px var(--color-accent); } }
  @keyframes taxonomy-series-flow { to { background-position:170% 0,0 0; } }

  :global(html[data-motion='off']) .taxonomy-head::after,
  :global(html[data-motion='off']) .head-code span,
  :global(html[data-motion='off']) .series-strip { animation:none; }

  @media (prefers-reduced-motion: reduce) {
    .taxonomy-head::after,.head-code span,.series-strip { animation:none; }
    .lead-story::after,.ledger-card::before { display:none; }
  }
</style>
