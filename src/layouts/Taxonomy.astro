---
import Base from './Base.astro'
import { coverSvgUrl } from '../lib/covers'
import { getCoTags } from '../lib/editorialIndex'
import { formatDate, postUrl, tagUrl, type Post } from '../lib/posts'
import { seriesUrl } from '../lib/series'
import { noteAccent } from '../lib/note-accent'
import '../styles/taxonomy-open.css'
interface Props { kind: 'tag' | 'category'; name: string; posts: Post[] }
const { kind, name, posts } = Astro.props
const prefix = kind === 'tag' ? '#' : ''
const desc = `${kind === 'tag' ? '标签' : '分类'} ${name} 下的 ${posts.length} 篇文章。`
const coTags = getCoTags(posts, kind === 'tag' ? name : undefined)
const connectedSeries = [...new Set(posts.map(post => post.data.series).filter((series): series is string => Boolean(series)))]
---
<Base title={`${prefix}${name}`} description={desc} bodyClass="atlas-mode taxonomy-open">
  <a class="terms-back" href={kind === 'tag' ? '/tags/' : '/tags/#categories'}>← {kind === 'tag' ? '全部标签' : '全部分类'}</a>
  <header class="terms-intro topic-intro"><h1>{prefix}{name}</h1><p>{posts.length} 篇笔记<span>按发布时间排列</span></p></header>
  <div class="topic-reading">
    <section aria-label={`${name}的文章`}>
      <ol class="topic-posts">{posts.map((post, index) => <li>
        <article data-reading-preview style={`--note-color:${noteAccent(post.data)}`}>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <h2><a href={postUrl(post)} data-jmp data-jmp-source="taxonomy / note" data-jmp-title={post.data.title}>{post.data.title}<span aria-hidden="true">↗</span></a></h2>
          <p>{post.data.description}</p>
          {index === 0 && <a class="topic-cover" href={postUrl(post)} aria-label={`阅读《${post.data.title}》`}><img src={coverSvgUrl(post)} width="1200" height="630" alt="" decoding="async" /></a>}
          <nav aria-label={`《${post.data.title}》的标签`}>{post.data.tags.slice(0,4).map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</nav>
        </article>
      </li>)}</ol>
      {!posts.length && <p>这个{kind === 'tag' ? '标签' : '分类'}下还没有文章。</p>}
    </section>
    <aside class="topic-related">
      {connectedSeries.length > 0 && <section><h2>关联系列</h2><nav aria-label="关联系列">{connectedSeries.map(series => <a href={seriesUrl(series)}>{series} ↗</a>)}</nav></section>}
      {coTags.length > 0 && <section><h2>相关标签</h2><nav class="related-tags" aria-label="相关标签">{coTags.map(tag => <a href={tagUrl(tag.name)}>{tag.name}<small>{tag.count}</small></a>)}</nav></section>}
    </aside>
  </div>
</Base>
